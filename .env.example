# URL pública usada no canonical, Open Graph, Twitter Cards e JSON-LD.
PUBLIC_SITE_URL=https://jokenpo.cards

# OAuth do GitHub usado pelo Decap CMS.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Bot do Blip Chat (deixe vazio para manter o widget desativado).
PUBLIC_BLIP_APP_KEY=
# Opcional: URL customizada do contrato Blip (ex.: https://seucontrato.chat.blip.ai/).
PUBLIC_BLIP_COMMON_URL=

# Integração com o PDV na página /loja (docs/plano-api-pdv.md).
# live = catálogo, estoque e pedidos reais, pela ponte no Postgres (precisa de DATABASE_URL e PDV_SYNC_TOKEN).
# mock = PDV simulado em memória (padrão no `pnpm dev`).
# off  = rotas do PDV desligadas; vitrine usa o estoque do build e o pedido vai só pelo WhatsApp (padrão no build).
PUBLIC_PDV_MODE=
# Postgres da ponte site ↔ PDV (Neon pela Vercel). Crie as tabelas com `pnpm db:migrate`.
DATABASE_URL=
# Segredo compartilhado com o PC da loja (SITE_SYNC_TOKEN no .env do PDV), 32+ caracteres aleatórios.
PDV_SYNC_TOKEN=
# Vercel Blob das fotos de produto que o PDV envia (criada pela integração do Blob na Vercel).
BLOB_READ_WRITE_TOKEN=
# Token das rotas de balcão do mock (confirmar/cancelar). Sem ele, só funcionam no `pnpm dev`.
PDV_MOCK_ADMIN_TOKEN=

# Só para `pnpm sync:contract` (coloque no .env.local): onde está o repositório do PDV (padrão ../jokenpo-pdv).
# PDV_REPO_DIR=../jokenpo-pdv
