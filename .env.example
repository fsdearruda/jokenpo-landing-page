# URL pública usada no canonical, Open Graph, Twitter Cards e JSON-LD.
PUBLIC_SITE_URL=https://jokenpo.cards

# OAuth do GitHub usado pelo Decap CMS.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Bot do Blip Chat (deixe vazio para manter o widget desativado).
PUBLIC_BLIP_APP_KEY=
# Opcional: URL customizada do contrato Blip (ex.: https://seucontrato.chat.blip.ai/).
PUBLIC_BLIP_COMMON_URL=
