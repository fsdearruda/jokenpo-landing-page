    "astro": "^7.4.11",
    "astro-decap-cms-oauth": "^0.6.0",
    "astro-icon": "^1.2.0",
    "blip-chat-widget": "^1.14.0",
    "botid": "^1.5.13",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@iconify-json/lucide": "^1.2.158",
    "@iconify-json/simple-icons": "^1.2.103",
