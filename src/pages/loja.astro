---
import { SITE_URL } from '../lib/site-url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site as siteData } from '../lib/content';
import { CONDICOES, IDIOMAS, JOGOS, LOW_STOCK_THRESHOLD, nomeDe, type PaymentRules } from '../lib/catalog';
import { MAX_QUANTIDADE_POR_ITEM, pedidosNoSite } from '../lib/pdv';
import { lojaOffline } from '../lib/pdv/estoque';
import { carregarVitrine, regrasPagamento } from '../lib/vitrine';
import PromoBanners from '../components/PromoBanners.astro';
import ProductCard from '../components/loja/ProductCard.astro';
import Sacola from '../components/loja/Sacola.astro';
import { activeBanners } from '../lib/banners';

// Sob demanda, com cache curto na CDN: mostra o catálogo, o estoque e as fotos do PDV de agora,
// não os do último deploy.
export const prerender = false;

const { families, disponivel, erro, lojaVistaEm, lojaEstoqueEm, descontoPixBp } = await carregarVitrine();
if (erro) {
	// Banco fora do ar: 503 sem cache, para a CDN não trocar a última vitrine boa por uma vazia
	Astro.response.status = 503;
	Astro.response.headers.set('Cache-Control', 'no-store');
	Astro.response.headers.set('Retry-After', '60');
} else {
	Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
}

const siteUrl = SITE_URL;
const pageUrl = `${siteUrl}/loja`;
const whatsappNumber = siteData.contact.whatsapp.replace(/\D/g, '');
/** PC da loja sem mandar estoque há horas (ou estoque parado): catálogo continua, pedido vai pelo WhatsApp. */
const lojaPausada = disponivel && lojaOffline({ vistaEm: lojaVistaEm, estoqueEm: lojaEstoqueEm });
/** Pedido criado no site (a loja confirma o estoque); senão a sacola manda o pedido pelo WhatsApp. */
const orderApi = pedidosNoSite && disponivel && !lojaPausada;

const stockLevel = (stock: number) => (stock <= 0 ? 'out' : stock <= LOW_STOCK_THRESHOLD ? 'low' : 'ok');
const stockText = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' } as const;

const shop = siteData.shop;
const payment: PaymentRules = regrasPagamento(descontoPixBp);
const modeText = orderApi ? shop.orderOnSite : shop.orderOnWhatsapp;
/** O preço do PDV é o do cartão; com desconto no Pix, o card mostra os dois. */
const feeOn = payment.descontoPixBp > 0;
/** Filtros das cartas avulsas: só aparecem quando há carta na vitrine, com as opções que existem nela. */
const cartas = families.flatMap((family) => family.variants.flatMap((variant) => (variant.carta ? [variant.carta] : [])));
const opcoes = (valores: string[]) => [...new Set(valores)].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const filtrosCarta = cartas.length
	? [
			{ campo: 'jogo', rotulo: 'Jogo', valores: opcoes(cartas.map((c) => c.jogo)).map((v) => [v, nomeDe(JOGOS, v)]) },
			{ campo: 'colecao', rotulo: 'Coleção', valores: opcoes(cartas.map((c) => c.colecao)).map((v) => [v, cartas.find((c) => c.colecao === v)?.colecaoNome ?? v]) },
			{ campo: 'condicao', rotulo: 'Condição', valores: opcoes(cartas.map((c) => c.condicao)).map((v) => [v, nomeDe(CONDICOES, v)]) },
			{ campo: 'idioma', rotulo: 'Idioma', valores: opcoes(cartas.map((c) => c.idioma)).map((v) => [v, nomeDe(IDIOMAS, v)]) },
		].filter((f) => f.valores.length > 1)
	: [];

/** Banner em pé ou quadrado vai para a coluna da sacola no desktop, sem empurrar os produtos. */
const hasSideBanner = activeBanners('loja', ['tall', 'square']).length > 0;

/** URL da foto principal de cada variação, para o JSON-LD. */
const photoUrls = new Map(
	families.flatMap((family) => family.variants.flatMap((variant) => (variant.images?.length ? [[variant.id, variant.images[0].src] as const] : []))),
);

const jsonLd = [
	{
		'@type': 'ItemList',
		'@id': `${pageUrl}#produtos`,
		name: 'Produtos da Jokenpo',
		numberOfItems: families.length,
		itemListElement: families.map((family, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'ProductGroup',
				'@id': `${pageUrl}#${family.slug}`,
				name: family.name,
				productGroupID: family.slug,
				url: pageUrl,
				hasVariant: family.variants.map((variant) => ({
					'@type': 'Product',
					name: variant.title,
					...(variant.slug ? { url: `${siteUrl}/loja/${variant.slug}` } : {}),
					...(variant.sku ? { sku: variant.sku } : {}),
					...(photoUrls.has(variant.id) ? { image: photoUrls.get(variant.id) } : {}),
					offers: {
						'@type': 'Offer',
						price: (variant.priceCents / 100).toFixed(2),
						priceCurrency: 'BRL',
						availability:
							variant.stock > 0 ? 'https://schema.org/InStoreOnly' : 'https://schema.org/OutOfStock',
						seller: { '@id': `${siteUrl}/#store` },
					},
				})),
			},
		})),
	},
];
---

<BaseLayout
	title={shop.seoTitle}
	description={shop.seoDescription}
	path="/loja"
	jsonLd={jsonLd}
>
	<div
		class="shop"
		data-pdv-mode={orderApi ? 'live' : 'off'}
		data-order-api={orderApi ? 'true' : undefined}
		data-whatsapp={whatsappNumber}
		data-max-qty={MAX_QUANTIDADE_POR_ITEM}
		data-low-stock={LOW_STOCK_THRESHOLD}
		data-payment={JSON.stringify(payment)}
	>
		<div class:list={['shop-layout', { 'has-side-banner': hasSideBanner }]}>
			<header class="shop-intro">
				<h1>{shop.titleLine} <span>{shop.titleHighlight}</span></h1>
				<p class="shop-lead">{modeText.lead}</p>
			</header>
			{
				hasSideBanner && (
					<div class="shop-side">
						<PromoBanners placement="loja" shapes={['tall', 'square']} eager sizes="(min-width: 1024px) 360px, 100vw" />
					</div>
				)
			}
			<div class="shop-catalog">
				<PromoBanners
					placement="loja"
					shapes={['wide']}
					class="shop-banners"
					eager={!hasSideBanner}
					sizes="(min-width: 1024px) 900px, 100vw"
				/>
				<div class="filter-wrap">
					<div class="filter-toolbar" role="toolbar" aria-label="Filtrar produtos por categoria">
						<button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">Todos</button>
						{
							families.map((family) => (
								<button
									type="button"
									class={`filter-btn tone-${family.tone}`}
									data-filter={family.slug}
									aria-pressed="false"
								>
									{family.category}
								</button>
							))
						}
					</div>
				</div>
				{
					filtrosCarta.length > 0 && (
						<fieldset class="carta-filtros">
							<legend>Filtrar cartas avulsas</legend>
							{filtrosCarta.map((f) => (
								<label class="carta-filtro">
									<span>{f.rotulo}</span>
									<select data-carta-filtro={f.campo}>
										<option value="">Todas</option>
										{f.valores.map(([valor, nome]) => (
											<option value={valor}>{nome}</option>
										))}
									</select>
								</label>
							))}
						</fieldset>
					)
				}
				<p id="filter-status" class="sr-only" aria-live="polite"></p>

				{
					families.length > 0 && (
						<>
						<h2 class="sr-only">Produtos</h2>
						<ul class="product-grid" role="list" aria-label="Produtos">
							{families.flatMap((family) => {
								const tone = family.tone;
								return family.variants.map((variant, index) => {
									const level = stockLevel(variant.stock);
									return (
										<li
											data-category={family.slug}
											data-jogo={variant.carta?.jogo}
											data-colecao={variant.carta?.colecao}
											data-condicao={variant.carta?.condicao}
											data-idioma={variant.carta?.idioma}
										>
											<ProductCard
												variant={variant}
												category={family.category}
												tone={tone}
												index={index}
												payment={payment}
												level={level}
												stockText={stockText[level]}
											/>
										</li>
									);
								});
							})}
						</ul>
						</>
					)
				}
				{
					families.length === 0 && (
						<p class="catalog-empty">
							{shop.emptyCatalog}{' '}
							<a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">Falar no WhatsApp<span class="sr-only"> (abre em nova aba)</span></a>
						</p>
					)
				}
				<p class="catalog-note">
					{
						lojaPausada
							? 'O sistema da loja está sem conexão agora: o estoque pode ter mudado, e o pedido vai pelo WhatsApp.'
							: 'Preço e estoque direto do sistema da loja.'
					}
				</p>
			</div>

			<Sacola orderApi={orderApi} whatsappNumber={whatsappNumber} feeOn={feeOn} cartHint={modeText.cartHint} />
		</div>

		<button type="button" class="cart-bar" data-role="cart-bar" aria-controls="sacola" aria-expanded="false" hidden>
			<span class="cart-bar-count">
				<Icon name="lucide:shopping-bag" size={16} weight={3} />
				<span data-role="bar-count">0</span>
			</span>
			<span class="cart-bar-label">Ver sacola</span>
			<strong class="cart-bar-total" data-role="bar-total">R$ 0</strong>
		</button>
		<div class="cart-backdrop" data-role="cart-backdrop" hidden></div>
		<p class="sr-only" data-role="announce" aria-live="polite"></p>
	</div>
</BaseLayout>

<script>
	import '../scripts/loja';
</script>

<style>
	.shop {
		max-width: 1320px;
		margin-inline: auto;
		padding: clamp(6.5rem, 10vw, 8rem) clamp(1rem, 3vw, 2.625rem) clamp(4.75rem, 8vw, 7.5rem);
	}

	/* Abertura curta: os produtos aparecem logo na primeira tela */
	.shop-intro {
		margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.shop-intro h1 {
		margin-bottom: 0.625rem;
		font-size: clamp(2.5rem, 1.25rem + 4.5vw, 4.5rem);
		line-height: 0.92;
		text-wrap: balance;
	}

	.shop-lead {
		max-inline-size: 34rem;
		margin: 0;
		color: var(--mist);
		font-size: 1rem;
		font-weight: 600;
		text-wrap: pretty;
	}

	.shop-catalog :global(.shop-banners) {
		margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	/* Banner largo: faixa na largura da vitrine, com altura contida */
	.shop-catalog :global(.promo-banner) {
		--max-h: 18rem;
	}

	.shop-side {
		grid-area: side;
		margin-bottom: 1.5rem;
	}

	.shop-side :global(.promo-banner) {
		inline-size: 100%;
	}

	/* Vitrine + sacola */
	/*
	* Desktop: título e vitrine à esquerda, sacola à direita. Com banner em pé, ele ocupa o
	* topo da coluna da sacola e a sacola (fixa ao rolar) vem logo abaixo.
	*/
	.shop-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 22.5rem;
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro cart'
			'catalog cart';
		column-gap: clamp(1.5rem, 2.5vw, 2.5rem);
		align-items: start;
	}

	.shop-layout.has-side-banner {
		grid-template-rows: auto auto 1fr;
		grid-template-areas:
			'intro side'
			'catalog side'
			'catalog cart';
	}

	.shop-intro {
		grid-area: intro;
	}

	.shop-catalog {
		grid-area: catalog;
	}

	/* Encosta no cabeçalho (altura medida em Header.astro); -1px evita fresta de subpixel */
	.filter-wrap {
		position: sticky;
		top: calc(var(--header-h, 4.5rem) - 1px);
		z-index: 5;
		margin: 0 -0.25rem 1.25rem;
		padding: 0.625rem 0.25rem;
		background: var(--ink);
	}

	.filter-toolbar {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		padding: 0.25rem 0.25rem 0.375rem;
	}

	.filter-toolbar::-webkit-scrollbar {
		display: none;
	}

	.filter-btn {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
		min-block-size: 2.75rem;
		padding: 0.5rem 1rem;
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-pill);
		background: var(--ink-2);
		color: var(--mist);
		font: 700 0.8125rem/1.2 var(--font-body);
		white-space: nowrap;
		cursor: pointer;
		touch-action: manipulation;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			transform var(--duration-instant) var(--ease-out);
	}

	@media (hover: hover) {
		.filter-btn:hover {
				border-color: var(--mist);
				color: var(--white);
		}
	}

	.filter-btn:active {
		transform: scale(0.97);
	}

	.filter-btn.is-active {
		border-color: var(--ink);
		background: var(--white);
		color: var(--ink);
		box-shadow: 3px 3px 0 var(--ink-3);
	}

	.filter-btn.tone-cyan.is-active {
		background: var(--cyan);
	}

	.filter-btn.tone-yellow.is-active {
		background: var(--yellow);
	}

	.filter-btn.tone-pink.is-active {
		background: var(--pink);
	}

	/* Cards compactos */
	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
		gap: 1rem;
		margin: 0 0 clamp(2rem, 4vw, 2.75rem);
		padding: 0;
		list-style: none;
		scroll-margin-top: 8.5rem;
	}

	.product-grid > li[hidden] {
		display: none;
	}

	:global(.line-qty) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border: 2px solid var(--tone, var(--ink));
		border-radius: var(--radius-pill);
	}

	:global(.shop .step-btn) {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		touch-action: manipulation;
	}

	:global(.shop .step-btn:disabled) {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.catalog-note {
		margin: 0;
		color: var(--mist);
		font-size: 0.8125rem;
	}

	.cart-bar[hidden],
	.cart-backdrop[hidden] {
		display: none;
	}

	:global(.cart-line) {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'info info info'
			'qty price remove';
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0.875rem 0;
		border-bottom: 2px dashed color-mix(in oklch, var(--ink) 18%, transparent);
	}

	:global(.cart-line:last-child) {
		border-bottom: 0;
	}

	:global(.line-info) {
		grid-area: info;
		display: grid;
		min-inline-size: 0;
	}

	:global(.line-name) {
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	:global(.line-unit) {
		color: var(--ink-muted);
		font-size: 0.75rem;
	}

	:global(.line-qty) {
		grid-area: qty;
		--tone: var(--ink);
		background: var(--white);
	}

	:global(.shop .line-qty .step-btn) {
		inline-size: 2.25rem;
		block-size: 2.25rem;
	}

	:global(.line-qty-value) {
		min-inline-size: 1.25rem;
		font-size: 0.875rem;
		font-weight: 700;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}

	:global(.line-price) {
		grid-area: price;
		font-size: 0.9375rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	:global(.line-remove) {
		grid-area: remove;
		min-block-size: 2.25rem;
		padding: 0 0.25rem;
		border: 0;
		background: transparent;
		color: var(--ink-muted);
		font: 600 0.75rem/1 var(--font-body);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	@media (hover: hover) {
		:global(.line-remove:hover) {
				color: var(--ink);
		}
	}

	.catalog-empty {
		margin: 2rem 0;
		padding: 1.25rem;
		border: 2px dashed var(--ink-3);
		border-radius: 14px;
		font-weight: 600;
	}

	.catalog-empty a {
		color: var(--yellow);
		text-underline-offset: 3px;
	}

	/* Barra e gaveta no celular/tablet */
	.cart-bar,
	.cart-backdrop {
		display: none;
	}

	@media (max-width: 1023px) {
		.shop-layout,
			.shop-layout.has-side-banner {
				grid-template-columns: minmax(0, 1fr);
				grid-template-rows: auto;
				grid-template-areas: 'intro' 'side' 'catalog';
		}

		.shop-side {
				margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
		}

		.shop-side :global(.promo-banner) {
				--max-h: min(80svh, 36rem);
				inline-size: min(100%, calc(var(--max-h) * (var(--ratio))));
				margin-inline: auto;
		}

		.cart-backdrop:not([hidden]) {
				position: fixed;
				inset: 0;
				z-index: 29;
				display: block;
				background: oklch(0.16 0.006 285 / 0.7);
		}

		.cart-bar:not([hidden]) {
				position: fixed;
				left: 1rem;
				right: 5.5rem;
				bottom: max(1rem, env(safe-area-inset-bottom));
				z-index: 26;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				max-inline-size: 28rem;
				min-block-size: 3.25rem;
				padding: 0.5rem 1rem 0.5rem 0.5rem;
				border: 2px solid var(--ink);
				border-radius: var(--radius-pill);
				background: var(--pink);
				color: var(--ink);
				font: 700 0.9375rem/1.2 var(--font-body);
				box-shadow: 4px 4px 0 var(--ink);
				cursor: pointer;
		}

		.cart-bar-count {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.3rem;
				min-inline-size: 2.25rem;
				block-size: 2.25rem;
				padding: 0 0.5rem;
				border-radius: var(--radius-pill);
				background: var(--ink);
				color: var(--white);
				font-variant-numeric: tabular-nums;
		}

		.cart-bar-label {
				flex: 1;
				text-align: left;
		}

		.cart-bar-total {
				font-variant-numeric: tabular-nums;
		}

		.shop {
				padding-bottom: 7rem;
		}
	}

	@media (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
		.cart-bar.is-pulse {
				animation: barPulse 420ms var(--ease-out);
		}

		@keyframes barPulse {
				40% {
					transform: scale(1.04);
				}
		}
	}

	:global(html.cart-locked) {
		overflow: hidden;
	}

	/* Com a gaveta aberta, o botão do chat não cobre o botão de reservar */
	:global(html.cart-locked #blip-chat-container) {
		display: none;
	}

	@media (max-width: 480px) {
		.product-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
		}

		:global(.shop .card-qty .step-btn) {
				inline-size: 2.25rem;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.carta-filtros {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0 0 1.25rem;
		padding: 0;
		border: 0;
	}

	.carta-filtros legend {
		margin-bottom: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.carta-filtro {
		display: grid;
		gap: 0.25rem;
		font-size: 0.75rem;
		font-weight: 600;
	}

	.carta-filtro select {
		min-block-size: 2.75rem;
		padding: 0 0.75rem;
		border: 2px solid var(--ink-3);
		border-radius: 10px;
		background: var(--ink-2);
		color: var(--white);
		font: 500 0.9375rem/1 var(--font-body);
	}

	.carta-filtro select:focus-visible {
		outline: 3px solid var(--cyan);
		outline-offset: 2px;
	}
</style>
