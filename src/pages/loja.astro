---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import siteData from '../data/site.json';
import { LOW_STOCK_THRESHOLD, catalog, cardPrice, compareAtCents, formatPrice, promoBadge, toneOf, type PaymentRules } from '../lib/catalog';
import { MAX_QUANTIDADE_POR_ITEM, pdvMode } from '../lib/pdv';
import { lojaOffline } from '../lib/pdv/estoque';
import { carregarVitrine } from '../lib/vitrine';
import { remoteImage, resolveProductImage } from '../lib/product-images';
import PromoBanners from '../components/PromoBanners.astro';
import { activeBanners } from '../lib/banners';

// Sob demanda, com cache curto na CDN: mostra o catálogo, o estoque e as fotos do PDV de agora,
// não os do último deploy. (O Astro só aceita valor fixo aqui, então vale para todos os modos.)
export const prerender = false;

const { families, fonte, lojaVistaEm, acrescimoCartaoBp } = await carregarVitrine();
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const pageUrl = `${siteUrl}/loja`;
const whatsappNumber = siteData.contact.whatsapp.replace(/\D/g, '');
const catalogDate = catalog.extractedAt.split('-').reverse().join('/');
/** PC da loja sem falar com o site há horas: catálogo continua, pedido vai pelo WhatsApp. */
const lojaPausada = fonte === 'pdv' && lojaOffline(lojaVistaEm);
/**
 * Modo efetivo da página: com o PDV real fora do ar (ou antes da primeira sincronização da
 * loja), a vitrine volta ao catálogo do build com pedido pelo WhatsApp.
 */
const effectiveMode = pdvMode === 'live' && (fonte !== 'pdv' || lojaPausada) ? 'off' : pdvMode;
/** Com o PDV (real ou simulado), o pedido é criado no site e a loja confirma o estoque. */
const orderApi = effectiveMode !== 'off';

const stockLevel = (stock: number) => (stock <= 0 ? 'out' : stock <= LOW_STOCK_THRESHOLD ? 'low' : 'ok');
const stockText = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' } as const;

const shop = siteData.shop;
/** Acréscimo do cartão: o do PDV (Cadastros → Site) quando ele já mandou; senão o do CMS. */
const payment: PaymentRules =
	acrescimoCartaoBp === null ? shop.payment : { cardFeeEnabled: acrescimoCartaoBp > 0, cardFeePercent: acrescimoCartaoBp / 100 };
const modeText = orderApi ? shop.orderOnSite : shop.orderOnWhatsapp;
const feeOn = payment.cardFeeEnabled && payment.cardFeePercent > 0;
/** Banner em pé ou quadrado vai para a coluna da sacola no desktop, sem empurrar os produtos. */
const hasSideBanner = activeBanners('loja', ['tall', 'square']).length > 0;

/** URL absoluta da foto principal de cada variação, para o JSON-LD. */
const photoUrls = new Map(
	await Promise.all(
		families.flatMap((family) =>
			family.variants
				.filter((variant) => variant.images?.length)
				.map(async (variant) => {
					const src = resolveProductImage(variant.images![0].src);
					// Foto antiga do CMS: arquivo original em /_astro (a página é sob demanda e o /_image não existe na Vercel)
					const url = typeof src === 'string' ? src : src.src;
					return [variant.id, new URL(url, siteUrl).href] as const;
				}),
		),
	),
);

const jsonLd = [
	{
		'@type': 'ItemList',
		'@id': `${pageUrl}#produtos`,
		name: 'Produtos Jokenpo: shields, deck boxes e triple packs',
		numberOfItems: families.length,
		itemListElement: families.map((family, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'ProductGroup',
				'@id': `${pageUrl}#${family.slug}`,
				name: family.name,
				description: family.description,
				productGroupID: family.slug,
				url: pageUrl,
				variesBy: family.variantLabel === 'Cor' ? 'https://schema.org/color' : 'https://schema.org/size',
				hasVariant: family.variants.map((variant) => ({
					'@type': 'Product',
					name: variant.title,
					...(variant.sku ? { sku: variant.sku } : {}),
					...(photoUrls.has(variant.id) ? { image: photoUrls.get(variant.id) } : {}),
					offers: {
						'@type': 'Offer',
						price: (variant.priceCents / 100).toFixed(2),
						priceCurrency: 'BRL',
						availability:
							variant.stock > 0 ? 'https://schema.org/InStoreOnly' : 'https://schema.org/OutOfStock',
						seller: { '@id': `${siteUrl}/#store` },
					},
				})),
			},
		})),
	},
];
---

<BaseLayout
	title={shop.seoTitle}
	description={shop.seoDescription}
	path="/loja"
	jsonLd={jsonLd}
>
	<div
		class="shop"
		data-pdv-mode={effectiveMode}
		data-order-api={orderApi ? 'true' : undefined}
		data-whatsapp={whatsappNumber}
		data-max-qty={MAX_QUANTIDADE_POR_ITEM}
		data-low-stock={LOW_STOCK_THRESHOLD}
		data-payment={JSON.stringify(payment)}
	>
		<div class:list={['shop-layout', { 'has-side-banner': hasSideBanner }]}>
			<header class="shop-intro">
				<h1>{shop.titleLine} <span>{shop.titleHighlight}</span></h1>
				<p class="shop-lead">{modeText.lead}</p>
			</header>
			{
				hasSideBanner && (
					<div class="shop-side">
						<PromoBanners placement="loja" shapes={['tall', 'square']} eager sizes="(min-width: 1024px) 360px, 100vw" />
					</div>
				)
			}
			<div class="shop-catalog">
				<PromoBanners
					placement="loja"
					shapes={['wide']}
					class="shop-banners"
					eager={!hasSideBanner}
					sizes="(min-width: 1024px) 900px, 100vw"
				/>
				<div class="filter-wrap">
					<div class="filter-toolbar" role="toolbar" aria-label="Filtrar produtos por categoria">
						<button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">Todos</button>
						{
							families.map((family) => (
								<button
									type="button"
									class={`filter-btn tone-${toneOf(family)}`}
									data-filter={family.slug}
									aria-pressed="false"
								>
									{family.category}
								</button>
							))
						}
					</div>
				</div>
				<p id="filter-status" class="sr-only" aria-live="polite"></p>

				{
					families.length > 0 && (
						<ul class="product-grid" role="list" aria-label="Produtos">
							{families.flatMap((family) => {
								const tone = toneOf(family);
								return family.variants.map((variant, index) => {
									const level = stockLevel(variant.stock);
									const photos = variant.images ?? [];
									const before = compareAtCents(variant);
									const badge = promoBadge(variant, shop.promoBadgeDefault);
									return (
										<li data-category={family.slug}>
											<article
												class={`product-card tone-${tone}`}
												data-id={variant.id}
												data-price={variant.priceCents}
												data-stock={variant.stock}
												data-title={variant.title}
												data-compare={before ?? undefined}
												data-swatch={variant.swatch ?? (family.slug === 'shield-personalizada' ? 'art' : undefined)}
												data-index={index}
												aria-labelledby={`p-${variant.id}`}
											>
												{photos.length > 0 ? (
													<div class="product-visual product-photo">
														{photos.slice(0, 2).map((photo, i) => {
															const src = resolveProductImage(photo.src);
															const alt = i === 0 ? photo.alt : '';
															const cls = i === 0 ? undefined : 'photo-alt';
															const img = typeof src === 'string' ? remoteImage(src, [240, 360, 480, 720]) : { src: src.src };
															return (
																<img
																	{...img}
																	sizes="(min-width: 640px) 260px, 50vw"
																	alt={alt}
																	class={cls}
																	width="720"
																	height="720"
																	loading="lazy"
																	decoding="async"
																/>
															);
														})}
														{badge && <strong class="promo-badge">{badge}</strong>}
													</div>
												) : (
													<div class={`product-visual visual-${variant.visual ?? family.type}`}>
														<span aria-hidden="true" />
														<span aria-hidden="true" />
														<span aria-hidden="true" />
														{badge && <strong class="promo-badge">{badge}</strong>}
													</div>
												)}
												<div class="card-body">
													<p class="card-kicker">{family.category}</p>
													<h3 class="card-title" id={`p-${variant.id}`}>
														{variant.title}
													</h3>
													<div class="card-price" data-role="price">
														<p class="price-before" data-role="price-before" hidden={!before}>
															<span class="sr-only">De </span><s>{before ? formatPrice(before) : ''}</s>
														</p>
														<p class="price-main">
															<span data-role="price-pix">{formatPrice(variant.priceCents)}</span>
															{feeOn && <small>no Pix</small>}
														</p>
														{feeOn && (
															<p class="price-card">
																ou <span data-role="price-card">{formatPrice(cardPrice(variant.priceCents, payment))}</span> no cartão
															</p>
														)}
													</div>
													<p class="card-stock" data-role="stock" data-level={level}>
														{stockText[level]}
													</p>
													<div class="card-action">
														<button type="button" class="add-btn" data-role="add" disabled={level === 'out'}>
															{level === 'out' ? 'Esgotado' : 'Adicionar'}
														</button>
														<div class="card-qty" data-role="qty" role="group" aria-label={`${variant.title} na sacola`} hidden>
															<button type="button" class="step-btn" data-step="-1" aria-label={`Tirar uma unidade de ${variant.title}`}>
																<Icon name="lucide:minus" size={16} weight={3} />
															</button>
															<span class="card-qty-value" data-role="qty-value">1 na sacola</span>
															<button type="button" class="step-btn" data-step="1" aria-label={`Adicionar mais uma unidade de ${variant.title}`}>
																<Icon name="lucide:plus" size={16} weight={3} />
															</button>
														</div>
													</div>
												</div>
											</article>
										</li>
									);
								});
							})}
						</ul>
					)
				}
				{
					families.length === 0 && (
						<p class="catalog-empty">
							{shop.emptyCatalog}{' '}
							<a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">Falar no WhatsApp<span class="sr-only"> (abre em nova aba)</span></a>
						</p>
					)
				}
				<p class="catalog-note">
					{
						lojaPausada
							? 'O sistema da loja está sem conexão agora: o estoque pode ter mudado, e o pedido vai pelo WhatsApp.'
							: fonte === 'pdv'
								? 'Preço e estoque direto do sistema da loja.'
								: `Preços e estoque de ${catalogDate}.`
					}
				</p>
			</div>

			<aside class="cart" id="sacola" aria-labelledby="cart-heading">
				<div class="cart-panel">
					<div class="cart-head">
						<h2 id="cart-heading" class="cart-heading" tabindex="-1">Sua sacola <span class="cart-count" data-role="cart-count"></span></h2>
						<button type="button" class="cart-close" data-role="cart-close" aria-label="Fechar sacola">
							<Icon name="lucide:x" size={18} weight={3} />
						</button>
					</div>

					<div class="cart-scroll">
						{
							orderApi && (
								<section class="order-status" data-role="order-status" aria-labelledby="order-title" hidden>
									<p class="order-kicker">Seu pedido</p>
									<h3 class="order-title" id="order-title" tabindex="-1">Pedido #<span data-role="order-number"></span></h3>
									<p class="order-state" data-role="order-state" data-state="AGUARDANDO_CONFIRMACAO" role="status"></p>
									<ul class="order-items" data-role="order-items" role="list"></ul>
									<a
										class="button button-pink cart-cta"
										data-role="order-whatsapp"
										href={`https://wa.me/${whatsappNumber}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Icon name="simple-icons:whatsapp" class="whatsapp-icon" size={20} />
										<span data-role="order-whatsapp-label">Combinar o pagamento</span>
										<span class="sr-only">(abre o WhatsApp em nova aba)</span>
									</a>
									<button type="button" class="cart-clear" data-role="order-dismiss">Fechar e fazer outro pedido</button>
								</section>
							)
						}
						<div class="cart-empty" data-role="cart-empty">
							<p class="cart-empty-title">Tá vazia por enquanto</p>
							<p>Toque em <strong>Adicionar</strong> num produto e ele aparece aqui.</p>
						</div>
						<ul class="cart-list" data-role="cart-list" role="list"></ul>
						<template data-role="line-template">
							<li class="cart-line">
								<div class="line-info">
									<span class="line-name"></span>
									<span class="line-unit"></span>
								</div>
								<div class="line-qty" role="group">
									<button type="button" class="step-btn" data-step="-1"><Icon name="lucide:minus" size={16} weight={3} /></button>
									<span class="line-qty-value"></span>
									<button type="button" class="step-btn" data-step="1"><Icon name="lucide:plus" size={16} weight={3} /></button>
								</div>
								<span class="line-price"></span>
								<button type="button" class="line-remove">Remover</button>
							</li>
						</template>
					</div>

					<div class="cart-foot" data-role="cart-foot" hidden>
						<p class="cart-total">
							<span>Total <small data-role="cart-items"></small></span>
							<strong data-role="cart-total">R$ 0</strong>
						</p>
						{feeOn && <p class="cart-pix" data-role="cart-card"></p>}
						{
							orderApi ? (
								<form class="order-form" data-role="order-form" novalidate>
									<div class="field">
										<label for="order-name">Seu nome</label>
										<input id="order-name" name="nome" type="text" autocomplete="name" maxlength="80" required />
									</div>
									<div class="field">
										<label for="order-phone">WhatsApp com DDD</label>
										<input
											id="order-phone"
											name="telefone"
											type="tel"
											inputmode="tel"
											autocomplete="tel-national"
											placeholder="(84) 9 0000-0000"
											maxlength="16"
											required
										/>
									</div>
									<p class="order-error" data-role="order-error" role="alert" hidden></p>
									<button type="submit" class="button button-pink cart-cta" data-role="order-submit">Fazer pedido</button>
									<p class="cart-hint">{modeText.cartHint}</p>
								</form>
							) : (
								<>
									<a
										class="button button-pink cart-cta"
										data-role="whatsapp-link"
										href={`https://wa.me/${whatsappNumber}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Icon name="simple-icons:whatsapp" class="whatsapp-icon" size={20} />
										Enviar pedido no WhatsApp
										<span class="sr-only">(abre o WhatsApp em nova aba)</span>
									</a>
									<p class="cart-hint">{modeText.cartHint}</p>
									<details class="cart-preview">
										<summary>Ver a mensagem</summary>
										<pre data-role="message"></pre>
									</details>
									<div class="cart-sent" data-role="cart-sent" role="status" hidden>
										<p>Mandou a mensagem? A loja confirma o estoque e avisa quando estiver separado.</p>
										<button type="button" class="cart-clear" data-role="cart-clear">Esvaziar sacola</button>
									</div>
								</>
							)
						}
					</div>
				</div>
			</aside>
		</div>

		<button type="button" class="cart-bar" data-role="cart-bar" aria-controls="sacola" aria-expanded="false" hidden>
			<span class="cart-bar-count">
				<Icon name="lucide:shopping-bag" size={16} weight={3} />
				<span data-role="bar-count">0</span>
			</span>
			<span class="cart-bar-label">Ver sacola</span>
			<strong class="cart-bar-total" data-role="bar-total">R$ 0</strong>
		</button>
		<div class="cart-backdrop" data-role="cart-backdrop" hidden></div>
		<p class="sr-only" data-role="announce" aria-live="polite"></p>
	</div>
</BaseLayout>

<script>
	import { cardPrice, formatPrice, type PaymentRules } from '../lib/catalog';

	type Line = { id: string; qty: number };
	type OrderStatus = 'AGUARDANDO_CONFIRMACAO' | 'PAGAMENTO_PENDENTE' | 'PAGO' | 'ENTREGUE' | 'RECUSADO' | 'CANCELADO' | 'EXPIRADO';
	type SavedOrder = {
		id: string;
		numero: number;
		status: OrderStatus;
		itens: { descricao: string; quantidade: number; precoUnitarioCentavos?: number }[];
		totalCentavos: number;
		validoAte: string | null;
		motivo: string | null;
	};

	const root = document.querySelector<HTMLElement>('.shop');
	if (root) {
		const $ = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = root) =>
			scope.querySelector<T>(selector)!;
		const mode = root.dataset.pdvMode;
		const maxQty = Number(root.dataset.maxQty) || 5;
		const lowStock = Number(root.dataset.lowStock) || 3;
		const STORAGE_KEY = 'jokenpo:sacola';
		const ORDER_KEY = 'jokenpo:pedido';
		const optional = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector);
		const payment = JSON.parse(root.dataset.payment ?? '{}') as PaymentRules;
		/** Total do pedido no cartão, com a taxa sobre o preço de cada item gravado no pedido. */
		const orderCard = (o: SavedOrder) =>
			o.itens.every((item) => item.precoUnitarioCentavos)
				? o.itens.reduce((sum, item) => sum + cardPrice(item.precoUnitarioCentavos!, payment) * item.quantidade, 0)
				: cardPrice(o.totalCentavos, payment);
		/** Preço do PDV é o do Pix; com taxa ligada, o total vem nos dois meios. */
		const totalSentence = (cents: number, card: number) =>
			card > cents ? `${formatPrice(cents)} no Pix ou ${formatPrice(card)} no cartão` : formatPrice(cents);

		const cards = new Map(
			[...root.querySelectorAll<HTMLElement>('.product-card')].map((card) => [card.dataset.id!, card]),
		);
		const cart = new Map<string, Line>();

		const cartEl = $('#sacola');
		const cartList = $<HTMLUListElement>('[data-role="cart-list"]');
		const cartEmpty = $('[data-role="cart-empty"]');
		const cartFoot = $('[data-role="cart-foot"]');
		const bar = $<HTMLButtonElement>('[data-role="cart-bar"]');
		const lineTpl = $<HTMLTemplateElement>('[data-role="line-template"]');
		const backdrop = $('[data-role="cart-backdrop"]');
		const announce = $('[data-role="announce"]');
		const drawerQuery = window.matchMedia('(max-width: 1023px)');

		const info = (id: string) => {
			const card = cards.get(id)!;
			return {
				title: card.dataset.title ?? '',
				price: Number(card.dataset.price),
				stock: Number(card.dataset.stock),
			};
		};
		const limit = (id: string) => Math.max(0, Math.min(info(id).stock, maxQty));
		const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
		const totals = () => {
			let items = 0;
			let cents = 0;
			let card = 0;
			cart.forEach((line) => {
				const { price } = info(line.id);
				items += line.qty;
				cents += line.qty * price;
				card += line.qty * cardPrice(price, payment);
			});
			return { items, cents, card };
		};

		/* Persistência local: a sacola sobrevive a um recarregamento. */
		const save = () => {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify([...cart.values()]));
			} catch {
				/* Navegação privada ou armazenamento bloqueado. */
			}
		};
		const restore = () => {
			try {
				const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]') as Line[];
				saved.forEach((line) => {
					if (cards.has(line.id) && Number.isInteger(line.qty) && line.qty > 0) {
						const qty = Math.min(line.qty, limit(line.id));
						if (qty > 0) cart.set(line.id, { id: line.id, qty });
					}
				});
			} catch {
				/* Ignora dado corrompido. */
			}
		};

		const pulseBar = () => {
			bar.classList.remove('is-pulse');
			void bar.offsetWidth;
			bar.classList.add('is-pulse');
		};

		/* Quantidade: um único ponto de mudança para card e sacola. */
		const setQty = (id: string, qty: number, origin: 'card' | 'cart') => {
			const { title } = info(id);
			const next = Math.max(0, Math.min(qty, limit(id)));
			const before = cart.get(id)?.qty ?? 0;
			if (next === 0) cart.delete(id);
			else cart.set(id, { id, qty: next });
			const sent = optional('[data-role="cart-sent"]');
			if (sent) sent.hidden = true;
			render();
			save();
			if (next === before && qty > before) announce.textContent = `Limite de ${plural(next, 'unidade', 'unidades')} de ${title}.`;
			else if (next === 0) announce.textContent = `${title} saiu da sacola.`;
			else announce.textContent = `${title}: ${next} na sacola. Total ${formatPrice(totals().cents)}.`;
			if (origin === 'card' && before === 0 && next > 0) pulseBar();
		};

		/* Cards */
		const syncCard = (card: HTMLElement) => {
			const id = card.dataset.id!;
			const stock = Number(card.dataset.stock);
			const qty = cart.get(id)?.qty ?? 0;
			const level = stock <= 0 ? 'out' : stock <= lowStock ? 'low' : 'ok';
			const add = $<HTMLButtonElement>('[data-role="add"]', card);
			const qtyBox = $('[data-role="qty"]', card);
			const stockEl = $('[data-role="stock"]', card);
			card.classList.toggle('is-in-cart', qty > 0);
			add.hidden = qty > 0;
			add.disabled = level === 'out';
			add.textContent = level === 'out' ? 'Esgotado' : 'Adicionar';
			qtyBox.hidden = qty === 0;
			$('[data-role="qty-value"]', card).textContent = `${qty} na sacola`;
			$<HTMLButtonElement>('[data-step="1"]', card).disabled = qty >= limit(id);
			stockEl.dataset.level = level;
			stockEl.textContent = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' }[level];
		};

		cards.forEach((card, id) => {
			$('[data-role="add"]', card).addEventListener('click', () => {
				setQty(id, 1, 'card');
				const plus = $<HTMLButtonElement>('[data-step="1"]', card);
				(plus.disabled ? $<HTMLButtonElement>('[data-step="-1"]', card) : plus).focus();
			});
			card.querySelectorAll<HTMLButtonElement>('.step-btn').forEach((button) => {
				button.addEventListener('click', () => {
					const next = (cart.get(id)?.qty ?? 0) + Number(button.dataset.step);
					setQty(id, next, 'card');
					if (next === 0) $<HTMLButtonElement>('[data-role="add"]', card).focus();
					else if (button.disabled) $<HTMLButtonElement>('[data-step="-1"]', card).focus();
				});
			});
		});

		/* Sacola */
		const lineTemplate = (line: Line) => {
			const { title, price } = info(line.id);
			const li = lineTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
			li.dataset.id = line.id;
			li.querySelector('.line-name')!.textContent = title;
			li.querySelector('.line-unit')!.textContent = `${formatPrice(price)} cada`;
			li.querySelector('.line-qty')!.setAttribute('aria-label', `Quantidade de ${title}`);
			li.querySelector('.line-qty-value')!.textContent = String(line.qty);
			li.querySelector('.line-price')!.textContent = formatPrice(price * line.qty);
			const [minus, plus] = li.querySelectorAll<HTMLButtonElement>('.step-btn');
			minus.setAttribute('aria-label', `Tirar uma unidade de ${title}`);
			plus.setAttribute('aria-label', `Adicionar mais uma unidade de ${title}`);
			plus.disabled = line.qty >= limit(line.id);
			minus.addEventListener('click', () => {
				setQty(line.id, line.qty - 1, 'cart');
				focusLine(line.id, '[data-step="-1"]');
			});
			plus.addEventListener('click', () => {
				setQty(line.id, line.qty + 1, 'cart');
				focusLine(line.id, '[data-step="1"]');
			});
			const remove = li.querySelector<HTMLButtonElement>('.line-remove')!;
			remove.setAttribute('aria-label', `Remover ${title} da sacola`);
			remove.addEventListener('click', () => {
				setQty(line.id, 0, 'cart');
				focusLine(line.id, '.line-remove');
			});
			return li;
		};

		/** Mantém o foco no mesmo controle depois de redesenhar; se a linha sumiu, vai para o título. */
		const focusLine = (id: string, selector: string) => {
			const li = cartList.querySelector<HTMLElement>(`[data-id="${id}"]`);
			const target = li?.querySelector<HTMLButtonElement>(selector);
			if (target && !target.disabled) target.focus();
			else (li?.querySelector<HTMLButtonElement>('.line-remove') ?? $('#cart-heading')).focus();
		};

		/** Mensagem pronta pro WhatsApp da loja, no tom da marca e sem emoji. */
		function orderMessage(cents: number, card: number) {
			const lines = [...cart.values()].map((line) => {
				const { title, price } = info(line.id);
				const unit = line.qty > 1 ? ` (${formatPrice(price)} cada)` : '';
				return `${line.qty}x ${title}${unit} = ${formatPrice(price * line.qty)}`;
			});
			return [
				'Oi, Jokenpo! Quero fazer um pedido pra retirar na loja:',
				'',
				...lines,
				'',
				`Total: ${totalSentence(cents, card)}`,
				'',
				'Pode separar pra mim?',
			].join('\n');
		}

		function render() {
			const { items, cents, card } = totals();
			const empty = cart.size === 0;
			const cardLine = optional('[data-role="cart-card"]');
			if (cardLine) {
				cardLine.hidden = card <= cents;
				cardLine.replaceChildren('no Pix · ou ', Object.assign(document.createElement('strong'), { textContent: formatPrice(card) }), ' no cartão');
			}
			cartList.replaceChildren(...[...cart.values()].map(lineTemplate));
			cartEmpty.hidden = !empty || Boolean(order); // com pedido aberto, o painel do pedido ocupa o lugar
			cartFoot.hidden = empty;
			$('[data-role="cart-count"]').textContent = empty ? '' : `(${items})`;
			$('[data-role="cart-total"]').textContent = formatPrice(cents);
			$('[data-role="cart-items"]').textContent = empty ? '' : plural(items, 'item', 'itens');
			$('[data-role="bar-count"]').textContent = String(items);
			$('[data-role="bar-total"]').textContent = formatPrice(cents);
			bar.setAttribute('aria-label', `Ver sacola: ${plural(items, 'item', 'itens')}, ${formatPrice(cents)}`);
			bar.hidden = empty && !order;
			if (empty && order) {
				$('[data-role="bar-count"]').textContent = `#${order.numero}`;
				$('[data-role="bar-total"]').textContent = formatPrice(order.totalCentavos);
				bar.querySelector('.cart-bar-label')!.textContent = 'Ver pedido';
				bar.setAttribute('aria-label', `Ver pedido número ${order.numero}`);
			} else {
				bar.querySelector('.cart-bar-label')!.textContent = 'Ver sacola';
			}
			cards.forEach(syncCard);
			const message = optional('[data-role="message"]');
			const link = optional<HTMLAnchorElement>('[data-role="whatsapp-link"]');
			if (message && link) {
				const text = orderMessage(cents, card);
				message.textContent = text;
				link.href = `https://wa.me/${root!.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
			}
		}

		/* Gaveta no celular, coluna fixa no desktop */
		let drawerOpen = false;
		const syncDrawer = () => {
			const isDrawer = drawerQuery.matches;
			const open = isDrawer && drawerOpen;
			cartEl.classList.toggle('is-open', open);
			cartEl.inert = isDrawer && !drawerOpen;
			backdrop.hidden = !open;
			bar.setAttribute('aria-expanded', String(open));
			document.documentElement.classList.toggle('cart-locked', open);
			if (open) {
				cartEl.setAttribute('role', 'dialog');
				cartEl.setAttribute('aria-modal', 'true');
			} else {
				cartEl.removeAttribute('role');
				cartEl.removeAttribute('aria-modal');
			}
		};
		const openDrawer = () => {
			drawerOpen = true;
			syncDrawer();
			$<HTMLButtonElement>('[data-role="cart-close"]').focus();
		};
		const closeDrawer = () => {
			if (!drawerOpen) return;
			drawerOpen = false;
			syncDrawer();
			if (!bar.hidden) bar.focus();
		};
		bar.addEventListener('click', openDrawer);
		backdrop.addEventListener('click', closeDrawer);
		$('[data-role="cart-close"]').addEventListener('click', closeDrawer);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeDrawer();
		});
		drawerQuery.addEventListener('change', () => {
			drawerOpen = false;
			syncDrawer();
		});

		/* Filtro por categoria */
		const filterButtons = [...root.querySelectorAll<HTMLButtonElement>('.filter-btn')];
		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;
				filterButtons.forEach((b) => {
					b.classList.toggle('is-active', b === button);
					b.setAttribute('aria-pressed', String(b === button));
				});
				let visible = 0;
				root.querySelectorAll<HTMLElement>('.product-grid > li').forEach((item) => {
					const show = filter === 'all' || item.dataset.category === filter;
					item.hidden = !show;
					if (show) visible += 1;
				});
				$('#filter-status').textContent = `Mostrando ${plural(visible, 'produto', 'produtos')}.`;
			});
		});

		/** Redesenha o bloco de preço quando o PDV manda um preço novo. */
		const paintPrice = (card: HTMLElement) => {
			const price = Number(card.dataset.price);
			const before = Number(card.dataset.compare) || 0;
			const beforeEl = $('[data-role="price-before"]', card);
			beforeEl.hidden = before <= price;
			$('[data-role="price-pix"]', card).textContent = formatPrice(price);
			const cardEl = card.querySelector('[data-role="price-card"]');
			if (cardEl) cardEl.textContent = formatPrice(cardPrice(price, payment));
		};

		const refreshStock = async () => {
			try {
				const response = await fetch('/api/pdv/estoque', { headers: { accept: 'application/json' } });
				if (!response.ok) return;
				const items = (await response.json()) as { produtoId: string; disponivel: number; precoCentavos?: number }[];
				const seen = new Set<string>();
				items.forEach(({ produtoId, disponivel, precoCentavos }) => {
					const card = cards.get(produtoId);
					if (!card) return;
					seen.add(produtoId);
					card.dataset.stock = String(disponivel);
					if (precoCentavos && precoCentavos !== Number(card.dataset.price)) {
						card.dataset.price = String(precoCentavos);
						paintPrice(card);
					}
				});
				// Produto que saiu do catálogo no PDV fica como esgotado até a página recarregar
				if (mode === 'live') cards.forEach((card, id) => !seen.has(id) && (card.dataset.stock = '0'));
				cart.forEach((line) => {
					const max = limit(line.id);
					if (max === 0) cart.delete(line.id);
					else if (line.qty > max) line.qty = max;
				});
				render();
				save();
			} catch {
				/* Mantém o estoque estático da página. */
			}
		};

		/* Envio pelo WhatsApp (modo sem PDV): a sacola fica até o cliente esvaziar, caso precise reenviar. */
		optional('[data-role="whatsapp-link"]')?.addEventListener('click', () => {
			$('[data-role="cart-sent"]').hidden = false;
		});
		optional('[data-role="cart-clear"]')?.addEventListener('click', () => {
			cart.clear();
			save();
			render();
			$('[data-role="cart-sent"]').hidden = true;
			announce.textContent = 'Sacola esvaziada.';
			$('#cart-heading').focus();
		});

		/* Pedido pelo site (modo com PDV): a loja confirma o estoque e o pagamento é combinado no WhatsApp. */
		const ORDER_TEXT: Record<OrderStatus, (o: SavedOrder) => string> = {
			AGUARDANDO_CONFIRMACAO: () =>
				'Recebido! A loja confere o estoque assim que o sistema da loja estiver ligado e as unidades ficam guardadas pra você enquanto isso.',
			PAGAMENTO_PENDENTE: (o) =>
				`Separado! Pague por Pix no WhatsApp até ${deadline(o.validoAte)}. Depois disso as unidades voltam pra loja.`,
			PAGO: () => 'Pagamento recebido. É só passar na loja 24 pra retirar.',
			ENTREGUE: () => 'Entregue. Bom jogo!',
			RECUSADO: () => 'Esse não deu: algum item acabou antes de a loja confirmar. Chama a gente no WhatsApp que a gente vê uma alternativa.',
			CANCELADO: (o) => `A loja cancelou este pedido${o.motivo ? ` (${o.motivo})` : ''}.`,
			EXPIRADO: (o) =>
				o.motivo?.includes('não confirmou')
					? 'A loja não conseguiu confirmar a tempo e o pedido expirou. Se ainda quiser, é só pedir de novo.'
					: 'O prazo de 48 h pra pagar acabou e as unidades voltaram pra loja. Se ainda quiser, é só pedir de novo.',
		};
		const FINAL: OrderStatus[] = ['ENTREGUE', 'RECUSADO', 'CANCELADO', 'EXPIRADO'];
		let order: SavedOrder | null = null;
		let pollTimer: number | undefined;

		function deadline(iso: string | null) {
			if (!iso) return 'o prazo combinado';
			return new Intl.DateTimeFormat('pt-BR', {
				weekday: 'long',
				day: '2-digit',
				month: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
				timeZone: 'America/Fortaleza',
			}).format(new Date(iso));
		}

		const saveOrder = () => {
			try {
				if (order) localStorage.setItem(ORDER_KEY, JSON.stringify(order));
				else localStorage.removeItem(ORDER_KEY);
			} catch {
				/* Armazenamento bloqueado: o pedido continua valendo, só não reaparece ao recarregar. */
			}
		};

		function renderOrder() {
			const panel = optional('[data-role="order-status"]');
			if (!panel) return;
			panel.hidden = !order;
			if (!order) return;
			$('[data-role="order-number"]', panel).textContent = String(order.numero);
			const state = $('[data-role="order-state"]', panel);
			state.dataset.state = order.status;
			state.textContent = ORDER_TEXT[order.status](order);
			$('[data-role="order-items"]', panel).replaceChildren(
				...order.itens.map((item) => {
					const li = document.createElement('li');
					li.textContent = `${item.quantidade}x ${item.descricao}`;
					return li;
				}),
				Object.assign(document.createElement('li'), { className: 'order-total', textContent: `Total ${totalSentence(order.totalCentavos, orderCard(order))}` }),
			);
			const text =
				order.status === 'RECUSADO'
					? `Oi, Jokenpo! O pedido #${order.numero} do site não tinha estoque. Tem alguma alternativa?`
					: `Oi, Jokenpo! Fiz o pedido #${order.numero} no site (total ${totalSentence(order.totalCentavos, orderCard(order))}). Como faço o pagamento?`;
			const whatsapp = $<HTMLAnchorElement>('[data-role="order-whatsapp"]', panel);
			whatsapp.href = `https://wa.me/${root!.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
			whatsapp.hidden = order.status === 'PAGO' || order.status === 'ENTREGUE';
			$('[data-role="order-whatsapp-label"]', panel).textContent =
				order.status === 'RECUSADO' ? 'Falar com a loja' : 'Combinar o pagamento';
			$('[data-role="order-dismiss"]', panel).textContent = FINAL.includes(order.status) ? 'Fechar' : 'Fechar e fazer outro pedido';
		}

		async function pollOrder() {
			window.clearTimeout(pollTimer);
			if (!order || FINAL.includes(order.status)) return;
			if (document.visibilityState === 'visible') {
				try {
					const response = await fetch(`/api/pdv/pedidos/${order.id}`, { headers: { accept: 'application/json' } });
					if (response.status === 404) {
						order = null;
					} else if (response.ok) {
						const data = (await response.json()) as SavedOrder;
						const changed = data.status !== order.status;
						order = { ...order, status: data.status, validoAte: data.validoAte, motivo: data.motivo };
						if (changed) announce.textContent = `Pedido ${order.numero}: ${ORDER_TEXT[order.status](order)}`;
					}
					saveOrder();
					renderOrder();
					render();
				} catch {
					/* Sem rede: tenta de novo no próximo ciclo. */
				}
			}
			pollTimer = window.setTimeout(pollOrder, 20_000);
		}
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void pollOrder();
		});

		const orderForm = optional<HTMLFormElement>('[data-role="order-form"]');
		if (orderForm) {
			const errorEl = $('[data-role="order-error"]', orderForm);
			const submit = $<HTMLButtonElement>('[data-role="order-submit"]', orderForm);
			const nameInput = $<HTMLInputElement>('#order-name', orderForm);
			const phoneInput = $<HTMLInputElement>('#order-phone', orderForm);
			const showError = (message: string, field?: HTMLInputElement) => {
				errorEl.textContent = message;
				errorEl.hidden = false;
				[nameInput, phoneInput].forEach((input) => input.toggleAttribute('aria-invalid', input === field));
				if (field) {
					field.setAttribute('aria-describedby', 'order-error');
					field.focus();
				}
			};
			errorEl.id = 'order-error';

			/* Máscara do WhatsApp: (84) 9 0000-0000 ou (84) 3333-4444, mantendo o cursor no lugar. */
			const formatPhone = (raw: string) => {
				let d = raw.replace(/\D/g, '');
				if (d.length > 11 && d.startsWith('55')) d = d.slice(2);
				d = d.slice(0, 11);
				if (d.length === 0) return '';
				if (d.length <= 2) return `(${d}`;
				const ddd = `(${d.slice(0, 2)}) `;
				const rest = d.slice(2);
				// Celular começa com 9: já formata como (84) 9 0000-0000 enquanto digita
				if (rest[0] === '9') {
					const body = rest.slice(1);
					if (!body) return `${ddd}9`;
					return `${ddd}9 ${body.slice(0, 4)}${body.length > 4 ? `-${body.slice(4)}` : ''}`;
				}
				if (rest.length > 4) return `${ddd}${rest.slice(0, 4)}-${rest.slice(4)}`;
				return `${ddd}${rest}`;
			};
			// Apagar logo depois de um separador apaga o dígito anterior, senão a máscara devolve o separador
			phoneInput.addEventListener('beforeinput', (event) => {
				const { selectionStart: start, selectionEnd: end, value } = phoneInput;
				if (event.inputType !== 'deleteContentBackward' || start === null || start !== end || start === 0) return;
				if (/\d/.test(value[start - 1])) return;
				let i = start - 1;
				while (i >= 0 && !/\d/.test(value[i])) i--;
				if (i < 0) return;
				event.preventDefault();
				const digitsBefore = value.slice(0, i).replace(/\D/g, '').length;
				const formatted = formatPhone(value.slice(0, i) + value.slice(start));
				phoneInput.value = formatted;
				let pos = 0;
				for (let seen = 0; pos < formatted.length && seen < digitsBefore; pos++) if (/\d/.test(formatted[pos])) seen++;
				phoneInput.setSelectionRange(pos, pos);
			});
			phoneInput.addEventListener('input', () => {
				const caret = phoneInput.selectionStart ?? phoneInput.value.length;
				const digitsBefore = phoneInput.value.slice(0, caret).replace(/\D/g, '').length;
				const formatted = formatPhone(phoneInput.value);
				if (formatted === phoneInput.value) return;
				phoneInput.value = formatted;
				let pos = 0;
				for (let seen = 0; pos < formatted.length && seen < digitsBefore; pos++) if (/\d/.test(formatted[pos])) seen++;
				phoneInput.setSelectionRange(pos, pos);
			});

			orderForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				errorEl.hidden = true;
				const nome = nameInput.value.trim();
				const telefone = formatPhone(phoneInput.value).replace(/\D/g, '');
				if (nome.length < 2) return showError('Coloca seu nome pra gente achar o pedido no balcão.', nameInput);
				if (telefone.length < 10) return showError('Coloca um WhatsApp com DDD, tipo (84) 9 0000-0000.', phoneInput);

				submit.disabled = true;
				submit.textContent = 'Enviando…';
				try {
					const response = await fetch('/api/pdv/pedidos', {
						method: 'POST',
						headers: { 'content-type': 'application/json', accept: 'application/json' },
						body: JSON.stringify({
							nomeContato: nome,
							telefoneContato: telefone,
							itens: [...cart.values()].map((line) => ({ produtoId: line.id, quantidade: line.qty })),
						}),
					});
					const data = await response.json().catch(() => null);
					if (!response.ok) {
						const erro = data?.erro as { codigo?: string; mensagem?: string; detalhes?: unknown } | undefined;
						if (erro?.codigo === 'ESTOQUE_INSUFICIENTE' || erro?.codigo === 'ITEM_INVALIDO') {
							// Atualiza o estoque dos itens que faltaram e ajusta a sacola
							if (Array.isArray(erro.detalhes)) {
								(erro.detalhes as { produtoId: string; disponivel: number }[]).forEach(({ produtoId, disponivel }) => {
									const card = cards.get(produtoId);
									if (card) card.dataset.stock = String(disponivel);
								});
								cart.forEach((line) => {
									const max = limit(line.id);
									if (max === 0) cart.delete(line.id);
									else if (line.qty > max) line.qty = max;
								});
								save();
								render();
							}
							return showError(`${erro.mensagem ?? 'Um item acabou.'} A sacola foi ajustada: confere e tenta de novo.`);
						}
						if (erro?.codigo === 'CONTATO_INVALIDO') return showError(erro.mensagem ?? 'Confere seu nome e WhatsApp.', phoneInput);
						if ((erro?.codigo === 'MUITAS_TENTATIVAS' || erro?.codigo === 'LIMITE_PEDIDOS' || erro?.codigo === 'LOJA_OFFLINE') && erro.mensagem) return showError(erro.mensagem);
						return showError('Não deu pra enviar agora. Tenta de novo em instantes ou chama a gente no WhatsApp.');
					}
					const created = data as SavedOrder;
					order = {
						id: created.id,
						numero: created.numero,
						status: created.status,
						itens: created.itens,
						totalCentavos: created.totalCentavos,
						validoAte: created.validoAte,
						motivo: created.motivo,
					};
					saveOrder();
					cart.clear();
					save();
					orderForm.reset();
					render();
					renderOrder();
					$('#order-title').focus();
					void pollOrder();
				} catch {
					showError('Sem conexão. Confere sua internet e tenta de novo.');
				} finally {
					submit.disabled = false;
					submit.textContent = 'Fazer pedido';
				}
			});

			$('[data-role="order-dismiss"]').addEventListener('click', () => {
				window.clearTimeout(pollTimer);
				order = null;
				saveOrder();
				renderOrder();
				render();
				announce.textContent = 'Pedido fechado nesta tela. Ele continua valendo na loja.';
				$('#cart-heading').focus();
			});

			try {
				const saved = JSON.parse(localStorage.getItem(ORDER_KEY) ?? 'null') as SavedOrder | null;
				if (saved && typeof saved.id === 'string' && Number.isInteger(saved.numero) && ORDER_TEXT[saved.status]) order = saved;
			} catch {
				/* Ignora dado corrompido. */
			}
		}

		// Com o PDV ligado (real ou simulado), a vitrine atualiza estoque e preço ao vivo.
		if (mode === 'mock' || mode === 'live') {
			const schedule = (cb: () => void) =>
				'requestIdleCallback' in window ? requestIdleCallback(cb) : setTimeout(cb, 300);
			schedule(() => void refreshStock());
		}

		restore();
		render();
		renderOrder();
		syncDrawer();
		if (order) void pollOrder();
	}
</script>

<style>
	.shop {
		max-width: 1320px;
		margin-inline: auto;
		padding: clamp(6.5rem, 10vw, 8rem) clamp(1rem, 3vw, 2.625rem) clamp(4.75rem, 8vw, 7.5rem);
	}

	/* Abertura curta: os produtos aparecem logo na primeira tela */
	.shop-intro {
		margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.shop-intro h1 {
		margin-bottom: 0.625rem;
		font-size: clamp(2.5rem, 1.25rem + 4.5vw, 4.5rem);
		line-height: 0.92;
		text-wrap: balance;
	}

	.shop-lead {
		max-inline-size: 34rem;
		margin: 0;
		color: var(--mist);
		font-size: 1rem;
		font-weight: 600;
		text-wrap: pretty;
	}

	.shop-catalog :global(.shop-banners) {
		margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	/* Banner largo: faixa na largura da vitrine, com altura contida */
	.shop-catalog :global(.promo-banner) {
		--max-h: 18rem;
	}

	.shop-side {
		grid-area: side;
		margin-bottom: 1.5rem;
	}

	.shop-side :global(.promo-banner) {
		inline-size: 100%;
	}

	/* Vitrine + sacola */
	/*
	 * Desktop: título e vitrine à esquerda, sacola à direita. Com banner em pé, ele ocupa o
	 * topo da coluna da sacola e a sacola (fixa ao rolar) vem logo abaixo.
	 */
	.shop-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 22.5rem;
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro cart'
			'catalog cart';
		column-gap: clamp(1.5rem, 2.5vw, 2.5rem);
		align-items: start;
	}

	.shop-layout.has-side-banner {
		grid-template-rows: auto auto 1fr;
		grid-template-areas:
			'intro side'
			'catalog side'
			'catalog cart';
	}

	.shop-intro {
		grid-area: intro;
	}

	.shop-catalog {
		grid-area: catalog;
	}

	.cart {
		grid-area: cart;
	}

	/* Encosta no cabeçalho (altura medida em Header.astro); -1px evita fresta de subpixel */
	.filter-wrap {
		position: sticky;
		top: calc(var(--header-h, 4.5rem) - 1px);
		z-index: 5;
		margin: 0 -0.25rem 1.25rem;
		padding: 0.625rem 0.25rem;
		background: var(--ink);
	}

	.filter-toolbar {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		padding: 0.25rem 0.25rem 0.375rem;
	}

	.filter-toolbar::-webkit-scrollbar {
		display: none;
	}

	.filter-btn {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.5rem;
		min-block-size: 2.75rem;
		padding: 0.5rem 1rem;
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-pill);
		background: var(--ink-2);
		color: var(--mist);
		font: 700 0.8125rem/1.2 var(--font-body);
		white-space: nowrap;
		cursor: pointer;
		touch-action: manipulation;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			transform var(--duration-instant) var(--ease-out);
	}

	@media (hover: hover) {
		.filter-btn:hover {
			border-color: var(--mist);
			color: var(--white);
		}
	}

	.filter-btn:active {
		transform: scale(0.97);
	}

	.filter-btn.is-active {
		border-color: var(--ink);
		background: var(--white);
		color: var(--ink);
		box-shadow: 3px 3px 0 var(--ink-3);
	}
	.filter-btn.tone-cyan.is-active {
		background: var(--cyan);
	}
	.filter-btn.tone-yellow.is-active {
		background: var(--yellow);
	}
	.filter-btn.tone-pink.is-active {
		background: var(--pink);
	}

	/* Cards compactos */
	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
		gap: 1rem;
		margin: 0 0 clamp(2rem, 4vw, 2.75rem);
		padding: 0;
		list-style: none;
		scroll-margin-top: 8.5rem;
	}

	.product-grid > li[hidden] {
		display: none;
	}

	.product-card {
		--tone: var(--cyan);
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 2px solid var(--ink-3);
		border-radius: 16px;
		background: var(--ink-2);
		transition:
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.product-card.tone-yellow {
		--tone: var(--yellow);
	}
	.product-card.tone-pink {
		--tone: var(--pink);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.product-card:hover {
			box-shadow: 5px 5px 0 var(--ink-3);
			transform: translate(-2px, -2px);
		}
	}

	/* Item já na sacola fica marcado na vitrine */
	.product-card.is-in-cart {
		border-color: var(--tone);
		box-shadow: 5px 5px 0 color-mix(in oklch, var(--tone) 45%, var(--ink));
	}

	.product-card:has([data-level='out']) .product-visual {
		filter: grayscale(1);
		opacity: 0.55;
	}

	/* Ilustração em CSS para itens sem foto */
	.product-visual {
		position: relative;
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-bottom: 2px solid var(--ink-3);
		background-color: var(--ink);
		background-image: radial-gradient(color-mix(in oklch, var(--tone) 26%, transparent) 1.5px, transparent 2px);
		background-size: 14px 14px;
	}

	/* Foto do produto: fundo branco das fotos de catálogo, enquadrada inteira */
	.product-photo {
		position: relative;
		background: var(--white);
	}
	.product-photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: opacity var(--duration-normal) var(--ease-out);
	}
	.product-photo .photo-alt {
		opacity: 0;
	}
	@media (hover: hover) {
		.product-card:hover .product-photo .photo-alt {
			opacity: 1;
		}
	}

	.product-visual span {
		grid-area: 1 / 1;
		display: block;
		border: 2px solid var(--ink);
		box-shadow: 0 0 0 2px var(--white), 4px 5px 0 var(--ink);
		transition: transform var(--duration-normal) var(--ease-out);
	}

	.visual-shield span {
		width: 24%;
		aspect-ratio: 63 / 88;
		border-radius: 6px;
		background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--white) 14%, transparent) 0 5px, transparent 5px 12px), var(--sleeve, var(--ink-3));
	}
	.visual-shield span:nth-child(1) {
		transform: translateX(-46%) rotate(-10deg);
	}
	.visual-shield span:nth-child(2) {
		transform: translateY(-4%) rotate(2deg);
	}
	.visual-shield span:nth-child(3) {
		transform: translateX(46%) rotate(8deg);
	}
	.product-card[data-swatch='black'] {
		--sleeve: #141418;
	}
	.product-card[data-swatch='purple'] {
		--sleeve: var(--purple);
	}
	.product-card[data-swatch='art'] .visual-shield span {
		background: repeating-linear-gradient(135deg, var(--pink) 0 7px, var(--cyan) 7px 14px);
	}
	.product-card[data-swatch='art'][data-index='1'] .visual-shield span {
		background: repeating-linear-gradient(45deg, var(--yellow) 0 7px, var(--pink) 7px 14px);
	}

	.visual-deckbox span:nth-child(1) {
		width: 30%;
		aspect-ratio: 3 / 4;
		border-radius: 8px;
		background: linear-gradient(var(--ink) 0 0) center 26% / 100% 2px no-repeat, var(--tone);
		transform: translateX(14%) rotate(-4deg);
	}
	.visual-deckbox span:nth-child(2) {
		display: none;
	}
	.visual-deckbox span:nth-child(3) {
		width: 20%;
		aspect-ratio: 63 / 88;
		border-radius: 5px;
		background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--tone) 40%, transparent) 0 4px, transparent 4px 10px), var(--ink-2);
		transform: translate(-120%, 12%) rotate(-12deg);
	}
	.product-card[data-index='1'] .visual-deckbox span:nth-child(1) {
		width: 40%;
		aspect-ratio: 5 / 4;
		background: linear-gradient(var(--ink) 0 0) center 30% / 100% 2px no-repeat, linear-gradient(var(--ink) 0 0) center / 2px 100% no-repeat, var(--tone);
	}
	.product-card[data-index='2'] .visual-deckbox span:nth-child(1) {
		background: linear-gradient(var(--ink) 0 0) center 26% / 100% 2px no-repeat, var(--white);
	}

	.visual-triple span {
		width: 20%;
		aspect-ratio: 5 / 8;
		border-radius: 3px;
		background:
			linear-gradient(var(--ink) 0 0) top 10% center / 100% 2px no-repeat,
			linear-gradient(var(--ink) 0 0) bottom 10% center / 100% 2px no-repeat,
			var(--pack, var(--tone));
	}
	.visual-triple span:nth-child(1) {
		--pack: var(--cyan);
		transform: translateX(-62%) rotate(-8deg);
	}
	.visual-triple span:nth-child(2) {
		transform: translateY(-5%) rotate(3deg);
	}
	.visual-triple span:nth-child(3) {
		--pack: var(--yellow);
		transform: translateX(62%) rotate(10deg);
	}
	.product-card[data-index='1'] .visual-triple span {
		--pack: var(--purple);
	}
	.product-card[data-index='2'] .visual-triple span {
		--pack: var(--white);
	}

	/* Produto genérico vindo do PDV: caixa lacrada com etiqueta de preço */
	.visual-generic span:nth-child(1) {
		width: 34%;
		aspect-ratio: 1;
		border-radius: 6px;
		background:
			linear-gradient(var(--ink) 0 0) center 30% / 100% 2px no-repeat,
			linear-gradient(var(--ink) 0 0) 30% center / 2px 100% no-repeat,
			var(--tone);
		transform: rotate(-6deg);
	}
	.visual-generic span:nth-child(2) {
		width: 16%;
		aspect-ratio: 3 / 2;
		border-radius: 4px;
		background: var(--white);
		transform: translate(110%, 95%) rotate(12deg);
	}
	.visual-generic span:nth-child(3) {
		display: none;
	}
	.product-card[data-index='1'] .visual-generic span:nth-child(1) {
		aspect-ratio: 4 / 5;
		transform: rotate(5deg);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.product-card:hover .visual-generic span:nth-child(1) {
			transform: rotate(-10deg) translateY(-4%);
		}
		.product-card:hover .visual-shield span:nth-child(1),
		.product-card:hover .visual-triple span:nth-child(1) {
			transform: translateX(-70%) rotate(-14deg);
		}
		.product-card:hover .visual-shield span:nth-child(3),
		.product-card:hover .visual-triple span:nth-child(3) {
			transform: translateX(70%) rotate(14deg);
		}
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.75rem 0.875rem 0.875rem;
	}

	.card-kicker {
		margin-bottom: 0.25rem;
		color: var(--tone);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.3;
	}

	.card-title {
		margin-bottom: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.3;
		text-wrap: balance;
	}

	.card-price {
		display: grid;
		gap: 0.125rem;
		margin: auto 0 0.25rem;
	}

	.card-price p {
		margin: 0;
	}

	.price-before {
		color: #b9b7c2;
		font-size: 0.75rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.price-before[hidden] {
		display: none;
	}

	.price-main {
		color: var(--yellow);
		font-family: var(--font-display);
		font-size: 1.375rem;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.price-main small {
		display: block;
		margin-top: 0.125rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.price-card {
		color: #d6d4dd;
		font-size: 0.75rem;
		line-height: 1.35;
		font-variant-numeric: tabular-nums;
	}

	/* Selo de promoção no canto da foto */
	.promo-badge {
		position: absolute;
		inset: 0.5rem auto auto 0.5rem;
		z-index: 1;
		padding: 0.25rem 0.5rem;
		border: 2px solid var(--ink);
		border-radius: 999px;
		background: var(--pink);
		color: var(--ink);
		font: 800 0.75rem/1 var(--font-body);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		box-shadow: 2px 2px 0 var(--ink);
	}

	.card-stock {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 0.75rem;
		color: var(--mist);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.card-stock::before {
		content: '';
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: var(--cyan);
	}
	.card-stock[data-level='low']::before {
		border-radius: 1px;
		background: var(--yellow);
		transform: rotate(45deg);
	}
	.card-stock[data-level='out']::before {
		width: 0.5625rem;
		height: 2px;
		border-radius: 0;
		background: var(--mist);
	}

	.add-btn {
		inline-size: 100%;
		min-block-size: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-pill);
		background: var(--yellow);
		color: var(--ink);
		font: 700 0.875rem/1.2 var(--font-body);
		cursor: pointer;
		touch-action: manipulation;
		box-shadow: 3px 3px 0 var(--ink-3);
		transition:
			transform var(--duration-instant) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out);
	}

	.add-btn:active {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--ink-3);
	}

	.add-btn:disabled {
		border-color: var(--ink-3);
		background: transparent;
		color: var(--mist);
		box-shadow: none;
		cursor: not-allowed;
	}

	.add-btn[hidden],
	.card-qty[hidden] {
		display: none;
	}

	.card-qty,
	:global(.line-qty) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border: 2px solid var(--tone, var(--ink));
		border-radius: var(--radius-pill);
	}

	.card-qty {
		min-block-size: 2.75rem;
		background: color-mix(in oklch, var(--tone) 14%, var(--ink));
	}

	.card-qty-value {
		font-size: 0.8125rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: center;
	}

	:global(.shop .step-btn) {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		touch-action: manipulation;
	}

	:global(.shop .step-btn:disabled) {
		opacity: 0.35;
		cursor: not-allowed;
	}

	@media (hover: hover) {
		.card-qty .step-btn:not(:disabled):hover {
			color: var(--yellow);
		}
	}


	.catalog-note {
		margin: 0;
		color: var(--mist);
		font-size: 0.8125rem;
	}

	/* Sacola: coluna fixa à direita no desktop */
	.cart {
		position: sticky;
		top: 5.5rem;
		z-index: 6;
	}

	.cart-panel {
		display: flex;
		flex-direction: column;
		max-block-size: calc(100dvh - 7rem);
		border: 2px solid var(--ink);
		border-radius: 22px;
		background: var(--surface-warm);
		color: var(--ink);
		box-shadow: 7px 7px 0 var(--pink);
		overflow: hidden;
	}

	.cart-head {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.125rem 1.25rem 0.75rem;
		border-bottom: 2px solid color-mix(in oklch, var(--ink) 12%, transparent);
	}

	.cart-heading {
		margin: 0;
		color: var(--ink);
		font-size: 1.5rem;
		line-height: 1;
	}

	.cart-heading:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 3px;
	}

	.cart-count {
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
		vertical-align: middle;
	}

	.cart-close {
		display: none;
		place-items: center;
		inline-size: 2.75rem;
		block-size: 2.75rem;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		color: var(--ink);
		cursor: pointer;
	}

	.cart-panel,
	.cart-scroll {
		scrollbar-width: thin;
	}

	.cart-scroll {
		flex: 1 1 auto;
		min-block-size: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.25rem 1.25rem;
	}

	.cart-empty {
		padding: 1.25rem 0 1.5rem;
		color: #4a4852;
		font-size: 0.875rem;
	}

	.cart-empty p {
		margin: 0;
	}

	.cart-empty .cart-empty-title {
		margin-bottom: 0.25rem;
		color: var(--ink);
		font-weight: 700;
	}

	.cart-empty[hidden],
	.cart-foot[hidden],
	.cart-sent[hidden],
	.cart-bar[hidden],
	.cart-backdrop[hidden] {
		display: none;
	}

	.cart-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	:global(.cart-line) {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'info info info'
			'qty price remove';
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0.875rem 0;
		border-bottom: 2px dashed color-mix(in oklch, var(--ink) 18%, transparent);
	}

	:global(.cart-line:last-child) {
		border-bottom: 0;
	}

	:global(.line-info) {
		grid-area: info;
		display: grid;
		min-inline-size: 0;
	}

	:global(.line-name) {
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	:global(.line-unit) {
		color: #4a4852;
		font-size: 0.75rem;
	}

	:global(.line-qty) {
		grid-area: qty;
		--tone: var(--ink);
		background: var(--white);
	}

	:global(.shop .line-qty .step-btn) {
		inline-size: 2.25rem;
		block-size: 2.25rem;
	}

	:global(.line-qty-value) {
		min-inline-size: 1.25rem;
		font-size: 0.875rem;
		font-weight: 700;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}

	:global(.line-price) {
		grid-area: price;
		font-size: 0.9375rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	:global(.line-remove) {
		grid-area: remove;
		min-block-size: 2.25rem;
		padding: 0 0.25rem;
		border: 0;
		background: transparent;
		color: #4a4852;
		font: 600 0.75rem/1 var(--font-body);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	@media (hover: hover) {
		:global(.line-remove:hover) {
			color: var(--ink);
		}
	}

	.cart-foot {
		flex: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		padding: 1rem 1.25rem 1.25rem;
		border-top: 2px solid var(--ink);
		background: var(--white);
	}

	.cart-total {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cart-pix {
		margin: -0.25rem 0 0;
		color: #4a4852;
		font-size: 0.8125rem;
		text-align: end;
		font-variant-numeric: tabular-nums;
	}

	.cart-pix strong {
		color: var(--ink);
	}

	.cart-pix[hidden] {
		display: none;
	}

	.cart-total small {
		color: #4a4852;
		font-size: 0.75rem;
		letter-spacing: 0;
		text-transform: none;
	}

	.cart-total strong {
		font-family: var(--font-display);
		font-size: 1.625rem;
		font-weight: 400;
		letter-spacing: 0;
		font-variant-numeric: tabular-nums;
	}

	.cart-cta {
		inline-size: 100%;
		min-inline-size: 0;
		box-shadow: 4px 4px 0 var(--ink);
	}

	.cart-cta:disabled {
		cursor: progress;
		opacity: 0.75;
