	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.product-card:hover {
			box-shadow: 5px 5px 0 var(--ink-3);
			transform: translate(-2px, -2px);
		}
	}

	/* Item já na sacola fica marcado na vitrine */
	.product-card.is-in-cart {
		border-color: var(--tone);
		box-shadow: 5px 5px 0 color-mix(in oklch, var(--tone) 45%, var(--ink));
	}

	.product-card:has([data-level='out']) .product-visual {
		filter: grayscale(1);
		opacity: 0.55;
	}

	/* Ilustração em CSS: o PDV não tem foto desses itens */
	.product-visual {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-bottom: 2px solid var(--ink-3);
		background-color: var(--ink);
		background-image: radial-gradient(color-mix(in oklch, var(--tone) 26%, transparent) 1.5px, transparent 2px);
		background-size: 14px 14px;
	}

	.product-visual span {
		grid-area: 1 / 1;
		display: block;
		border: 2px solid var(--ink);
		box-shadow: 0 0 0 2px var(--white), 4px 5px 0 var(--ink);
		transition: transform var(--duration-normal) var(--ease-out);
	}

	.visual-shield span {
		width: 24%;
		aspect-ratio: 63 / 88;
		border-radius: 6px;
		background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--white) 14%, transparent) 0 5px, transparent 5px 12px), var(--sleeve, var(--ink-3));
	}
	.visual-shield span:nth-child(1) {
		transform: translateX(-46%) rotate(-10deg);
	}
	.visual-shield span:nth-child(2) {
		transform: translateY(-4%) rotate(2deg);
	}
	.visual-shield span:nth-child(3) {
		transform: translateX(46%) rotate(8deg);
	}
	.product-card[data-swatch='black'] {
		--sleeve: #141418;
	}
	.product-card[data-swatch='purple'] {
		--sleeve: var(--purple);
	}
	.product-card[data-swatch='art'] .visual-shield span {
		background: repeating-linear-gradient(135deg, var(--pink) 0 7px, var(--cyan) 7px 14px);
	}
	.product-card[data-swatch='art'][data-index='1'] .visual-shield span {
		background: repeating-linear-gradient(45deg, var(--yellow) 0 7px, var(--pink) 7px 14px);
	}

	.visual-deckbox span:nth-child(1) {
		width: 30%;
		aspect-ratio: 3 / 4;
		border-radius: 8px;
		background: linear-gradient(var(--ink) 0 0) center 26% / 100% 2px no-repeat, var(--tone);
		transform: translateX(14%) rotate(-4deg);
	}
	.visual-deckbox span:nth-child(2) {
		display: none;
	}
	.visual-deckbox span:nth-child(3) {
		width: 20%;
		aspect-ratio: 63 / 88;
		border-radius: 5px;
		background: repeating-linear-gradient(135deg, color-mix(in oklch, var(--tone) 40%, transparent) 0 4px, transparent 4px 10px), var(--ink-2);
		transform: translate(-120%, 12%) rotate(-12deg);
	}
	.product-card[data-index='1'] .visual-deckbox span:nth-child(1) {
		width: 40%;
		aspect-ratio: 5 / 4;
		background: linear-gradient(var(--ink) 0 0) center 30% / 100% 2px no-repeat, linear-gradient(var(--ink) 0 0) center / 2px 100% no-repeat, var(--tone);
	}
	.product-card[data-index='2'] .visual-deckbox span:nth-child(1) {
		background: linear-gradient(var(--ink) 0 0) center 26% / 100% 2px no-repeat, var(--white);
	}

	.visual-triple span {
		width: 20%;
		aspect-ratio: 5 / 8;
		border-radius: 3px;
		background:
			linear-gradient(var(--ink) 0 0) top 10% center / 100% 2px no-repeat,
			linear-gradient(var(--ink) 0 0) bottom 10% center / 100% 2px no-repeat,
			var(--pack, var(--tone));
	}
	.visual-triple span:nth-child(1) {
		--pack: var(--cyan);
		transform: translateX(-62%) rotate(-8deg);
	}
	.visual-triple span:nth-child(2) {
		transform: translateY(-5%) rotate(3deg);
	}
	.visual-triple span:nth-child(3) {
		--pack: var(--yellow);
		transform: translateX(62%) rotate(10deg);
	}
	.product-card[data-index='1'] .visual-triple span {
		--pack: var(--purple);
	}
	.product-card[data-index='2'] .visual-triple span {
		--pack: var(--white);
	}

	/* Produto genérico vindo do PDV: caixa lacrada com etiqueta de preço */
	.visual-generic span:nth-child(1) {
		width: 34%;
		aspect-ratio: 1;
		border-radius: 6px;
		background:
			linear-gradient(var(--ink) 0 0) center 30% / 100% 2px no-repeat,
			linear-gradient(var(--ink) 0 0) 30% center / 2px 100% no-repeat,
			var(--tone);
		transform: rotate(-6deg);
	}
	.visual-generic span:nth-child(2) {
		width: 16%;
		aspect-ratio: 3 / 2;
		border-radius: 4px;
		background: var(--white);
		transform: translate(110%, 95%) rotate(12deg);
	}
	.visual-generic span:nth-child(3) {
		display: none;
	}
	.product-card[data-index='1'] .visual-generic span:nth-child(1) {
		aspect-ratio: 4 / 5;
		transform: rotate(5deg);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.product-card:hover .visual-generic span:nth-child(1) {
			transform: rotate(-10deg) translateY(-4%);
		}
		.product-card:hover .visual-shield span:nth-child(1),
		.product-card:hover .visual-triple span:nth-child(1) {
			transform: translateX(-70%) rotate(-14deg);
		}
		.product-card:hover .visual-shield span:nth-child(3),
		.product-card:hover .visual-triple span:nth-child(3) {
			transform: translateX(70%) rotate(14deg);
		}
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.75rem 0.875rem 0.875rem;
	}

	.card-kicker {
		margin-bottom: 0.25rem;
		color: var(--tone);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.3;
	}

	.card-title {
		margin-bottom: 0.5rem;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.3;
		text-wrap: balance;
	}

	.card-price {
		margin: auto 0 0.125rem;
		color: var(--yellow);
		font-family: var(--font-display);
		font-size: 1.375rem;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.card-stock {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0 0 0.75rem;
		color: var(--mist);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.card-stock::before {
		content: '';
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: var(--cyan);
	}
	.card-stock[data-level='low']::before {
		border-radius: 1px;
		background: var(--yellow);
		transform: rotate(45deg);
	}
	.card-stock[data-level='out']::before {
		width: 0.5625rem;
		height: 2px;
		border-radius: 0;
		background: var(--mist);
	}

	.add-btn {
		inline-size: 100%;
		min-block-size: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-pill);
		background: var(--yellow);
		color: var(--ink);
		font: 700 0.875rem/1.2 var(--font-body);
		cursor: pointer;
		touch-action: manipulation;
		box-shadow: 3px 3px 0 var(--ink-3);
		transition:
			transform var(--duration-instant) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out);
	}

	.add-btn:active {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--ink-3);
	}

	.add-btn:disabled {
		border-color: var(--ink-3);
		background: transparent;
		color: var(--mist);
		box-shadow: none;
		cursor: not-allowed;
	}

	.add-btn[hidden],
	.card-qty[hidden] {
		display: none;
	}

	.card-qty,
	:global(.line-qty) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border: 2px solid var(--tone, var(--ink));
		border-radius: var(--radius-pill);
	}

	.card-qty {
		min-block-size: 2.75rem;
		background: color-mix(in oklch, var(--tone) 14%, var(--ink));
	}

	.card-qty-value {
		font-size: 0.8125rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: center;
	}

	:global(.shop .step-btn) {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		touch-action: manipulation;
	}

	:global(.shop .step-btn:disabled) {
		opacity: 0.35;
		cursor: not-allowed;
	}

	@media (hover: hover) {
		.card-qty .step-btn:not(:disabled):hover {
			color: var(--yellow);
		}
	}


	.catalog-note {
		margin: 0;
		color: var(--mist);
		font-size: 0.8125rem;
	}

	/* Sacola: coluna fixa à direita no desktop */
	.cart {
		position: sticky;
		top: 5.5rem;
		z-index: 6;
	}

	.cart-panel {
		display: flex;
		flex-direction: column;
		max-block-size: calc(100dvh - 7rem);
		border: 2px solid var(--ink);
		border-radius: 22px;
		background: var(--surface-warm);
		color: var(--ink);
		box-shadow: 7px 7px 0 var(--pink);
		overflow: hidden;
	}

	.cart-head {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.125rem 1.25rem 0.75rem;
		border-bottom: 2px solid color-mix(in oklch, var(--ink) 12%, transparent);
	}

	.cart-heading {
		margin: 0;
		color: var(--ink);
		font-size: 1.5rem;
		line-height: 1;
	}

	.cart-heading:focus-visible {
		outline: 3px solid var(--pink);
		outline-offset: 3px;
	}

	.cart-count {
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
		vertical-align: middle;
	}

	.cart-close {
		display: none;
		place-items: center;
		inline-size: 2.75rem;
		block-size: 2.75rem;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--white);
		color: var(--ink);
		cursor: pointer;
	}

	.cart-panel,
	.cart-scroll {
		scrollbar-width: thin;
	}

	.cart-scroll {
		flex: 1 1 auto;
		min-block-size: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.25rem 1.25rem;
	}

	.cart-empty {
		padding: 1.25rem 0 1.5rem;
		color: #4a4852;
		font-size: 0.875rem;
	}

	.cart-empty p {
		margin: 0;
	}

	.cart-empty .cart-empty-title {
		margin-bottom: 0.25rem;
		color: var(--ink);
		font-weight: 700;
	}

	.cart-empty[hidden],
	.cart-foot[hidden],
	.cart-sent[hidden],
	.cart-bar[hidden],
	.cart-backdrop[hidden] {
		display: none;
	}

	.cart-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	:global(.cart-line) {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas:
			'info info info'
			'qty price remove';
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0.875rem 0;
		border-bottom: 2px dashed color-mix(in oklch, var(--ink) 18%, transparent);
	}

	:global(.cart-line:last-child) {
		border-bottom: 0;
	}

	:global(.line-info) {
		grid-area: info;
		display: grid;
		min-inline-size: 0;
	}

	:global(.line-name) {
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	:global(.line-unit) {
		color: #4a4852;
		font-size: 0.75rem;
	}

	:global(.line-qty) {
		grid-area: qty;
		--tone: var(--ink);
		background: var(--white);
	}

	:global(.shop .line-qty .step-btn) {
		inline-size: 2.25rem;
		block-size: 2.25rem;
	}

	:global(.line-qty-value) {
		min-inline-size: 1.25rem;
		font-size: 0.875rem;
		font-weight: 700;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}

	:global(.line-price) {
		grid-area: price;
		font-size: 0.9375rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	:global(.line-remove) {
		grid-area: remove;
		min-block-size: 2.25rem;
		padding: 0 0.25rem;
		border: 0;
		background: transparent;
		color: #4a4852;
		font: 600 0.75rem/1 var(--font-body);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	@media (hover: hover) {
		:global(.line-remove:hover) {
			color: var(--ink);
		}
	}

	.cart-foot {
		flex: none;
		display: grid;
		gap: 0.75rem;
		padding: 1rem 1.25rem 1.25rem;
		border-top: 2px solid var(--ink);
		background: var(--white);
	}

	.cart-total {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cart-total small {
		color: #4a4852;
		font-size: 0.75rem;
		letter-spacing: 0;
		text-transform: none;
	}

	.cart-total strong {
		font-family: var(--font-display);
		font-size: 1.625rem;
		font-weight: 400;
		letter-spacing: 0;
		font-variant-numeric: tabular-nums;
	}

	.cart-cta {
		inline-size: 100%;
		min-inline-size: 0;
		box-shadow: 4px 4px 0 var(--ink);
	}

	.cart-cta:disabled {
		cursor: progress;
		opacity: 0.75;
	}

	.cart-hint {
		margin: 0;
		color: #4a4852;
		font-size: 0.75rem;
		line-height: 1.45;
		text-align: center;
	}

	.cart-preview {
		font-size: 0.8125rem;
	}

	.cart-preview summary {
		inline-size: fit-content;
		margin-inline: auto;
		padding: 0.375rem 0.5rem;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.cart-preview pre {
		max-block-size: 12rem;
		margin: 0.5rem 0 0;
		padding: 0.75rem;
		overflow: auto;
		border: 2px dashed color-mix(in oklch, var(--ink) 30%, transparent);
		border-radius: 12px;
		background: var(--surface-warm);
		font: 500 0.8125rem/1.5 var(--font-body);
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.cart-sent {
		display: grid;
		gap: 0.5rem;
		padding: 0.75rem;
		border-radius: 12px;
		background: color-mix(in srgb, var(--cyan) 16%, var(--white));
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.cart-sent p {
		margin: 0;
	}

	.cart-clear {
		justify-self: start;
		min-block-size: 2.5rem;
		padding: 0 0.25rem;
		border: 0;
		background: transparent;
		color: var(--ink);
		font: 700 0.8125rem/1 var(--font-body);
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.catalog-empty {
		margin: 2rem 0;
		padding: 1.25rem;
		border: 2px dashed var(--ink-3);
		border-radius: 14px;
		font-weight: 600;
	}

	.catalog-empty a {
		color: var(--yellow);
		text-underline-offset: 3px;
	}

	/* Pedido pelo site */
	.order-form {
		display: grid;
		gap: 0.75rem;
	}

	.field {
		display: grid;
		gap: 0.25rem;
	}

	.field label {
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.field input {
		min-block-size: 2.75rem;
		padding: 0.5rem 0.75rem;
		border: 2px solid var(--ink);
		border-radius: 10px;
		background: var(--white);
		color: var(--ink);
		font: 500 1rem/1.3 var(--font-body);
	}

	.field input:focus-visible {
		outline: 3px solid var(--cyan);
		outline-offset: 2px;
	}

	.field input[aria-invalid] {
		border-color: var(--pink);
	}

	.order-error {
		margin: 0;
		padding: 0.625rem 0.75rem;
		border-left: 4px solid var(--pink);
		border-radius: 8px;
		background: color-mix(in srgb, var(--pink) 12%, var(--white));
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.order-status {
		display: grid;
		gap: 0.625rem;
		margin-block-end: 1rem;
		padding: 1rem;
		border: 2px solid var(--ink);
		border-radius: 14px;
		background: var(--white);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.order-kicker {
		margin: 0;
		color: #4a4852;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.order-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
	}

	.order-title:focus-visible {
		outline: 3px solid var(--cyan);
		outline-offset: 4px;
	}

	.order-state {
		margin: 0;
		padding: 0.625rem 0.75rem;
		border-radius: 10px;
		background: color-mix(in srgb, var(--cyan) 16%, var(--white));
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.order-state[data-state='PAGAMENTO_PENDENTE'] {
		background: color-mix(in srgb, var(--yellow) 30%, var(--white));
	}

	.order-state[data-state='RECUSADO'],
	.order-state[data-state='CANCELADO'],
	.order-state[data-state='EXPIRADO'] {
		background: color-mix(in srgb, var(--pink) 14%, var(--white));
	}

	.order-items {
		display: grid;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		font-size: 0.8125rem;
		list-style: none;
	}

	.order-items .order-total {
		margin-block-start: 0.25rem;
		font-weight: 700;
	}

	.order-status[hidden],
	.order-error[hidden],
	.order-status .cart-cta[hidden] {
		display: none;
	}

	/* Barra e gaveta no celular/tablet */
	.cart-bar,
	.cart-backdrop {
		display: none;
	}

	@media (max-width: 1023px) {
		.shop-layout {
			grid-template-columns: minmax(0, 1fr);
		}

		.cart {
			position: fixed;
			inset: auto 0 0;
			z-index: 30;
			max-inline-size: 34rem;
			margin-inline: auto;
			visibility: hidden;
			transform: translateY(105%);
			transition:
				transform var(--duration-slow) var(--ease-out),
				visibility 0s linear var(--duration-slow);
		}

		.cart.is-open {
			visibility: visible;
			transform: translateY(0);
			transition: transform var(--duration-slow) var(--ease-out);
		}

		.cart-panel {
			max-block-size: 88dvh;
			border-bottom: 0;
			border-radius: 22px 22px 0 0;
			box-shadow: 0 -6px 0 var(--pink);
		}

		.cart-close {
			display: grid;
		}

		.cart-foot {
			padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
		}

		.cart-backdrop:not([hidden]) {
			position: fixed;
			inset: 0;
			z-index: 29;
			display: block;
			background: oklch(0.16 0.006 285 / 0.7);
		}

		.cart-bar:not([hidden]) {
			position: fixed;
			left: 1rem;
			right: 5.5rem;
			bottom: max(1rem, env(safe-area-inset-bottom));
			z-index: 26;
			display: flex;
			align-items: center;
			gap: 0.75rem;
			max-inline-size: 28rem;
			min-block-size: 3.25rem;
			padding: 0.5rem 1rem 0.5rem 0.5rem;
