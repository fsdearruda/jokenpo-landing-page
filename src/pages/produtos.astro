---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import siteData from '../data/site.json';
import { LOW_STOCK_THRESHOLD, catalog, formatPrice, toneOf } from '../lib/catalog';
import { MAX_QUANTIDADE_POR_ITEM, pdvMode } from '../lib/pdv';
import { carregarVitrine } from '../lib/vitrine';

// Estática por padrão. No modo `live`, o astro.config.mjs a torna sob demanda (com cache
// curto na CDN) para mostrar o catálogo escolhido no PDV.
export const prerender = true;

const { families, fonte } = await carregarVitrine();
if (pdvMode === 'live') Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const pageUrl = `${siteUrl}/produtos`;
const whatsappNumber = siteData.contact.whatsapp.replace(/\D/g, '');
const catalogDate = catalog.extractedAt.split('-').reverse().join('/');
const totalProducts = families.reduce((sum, family) => sum + family.variants.length, 0);
/**
 * Modo efetivo da página: com o PDV real fora do ar (ou antes da primeira sincronização da
 * loja), a vitrine volta ao catálogo do build com pedido pelo WhatsApp.
 */
const effectiveMode = pdvMode === 'live' && fonte !== 'pdv' ? 'off' : pdvMode;
/** Com o PDV (real ou simulado), o pedido é criado no site e a loja confirma o estoque. */
const orderApi = effectiveMode !== 'off';

const stockLevel = (stock: number) => (stock <= 0 ? 'out' : stock <= LOW_STOCK_THRESHOLD ? 'low' : 'ok');
const stockText = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' } as const;

const jsonLd = [
	{
		'@type': 'ItemList',
		'@id': `${pageUrl}#produtos`,
		name: 'Produtos Jokenpo: shields, deck boxes e triple packs',
		numberOfItems: families.length,
		itemListElement: families.map((family, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'ProductGroup',
				'@id': `${pageUrl}#${family.slug}`,
				name: family.name,
				description: family.description,
				productGroupID: family.slug,
				url: `${pageUrl}#${family.slug}`,
				variesBy: family.variantLabel === 'Cor' ? 'https://schema.org/color' : 'https://schema.org/size',
				hasVariant: family.variants.map((variant) => ({
					'@type': 'Product',
					name: variant.title,
					...(variant.sku ? { sku: variant.sku } : {}),
					offers: {
						'@type': 'Offer',
						price: (variant.priceCents / 100).toFixed(2),
						priceCurrency: 'BRL',
						availability:
							variant.stock > 0 ? 'https://schema.org/InStoreOnly' : 'https://schema.org/OutOfStock',
						seller: { '@id': `${siteUrl}/#store` },
					},
				})),
			},
		})),
	},
];
---

<BaseLayout
	title="Produtos: shields, deck boxes e triple packs | Jokenpo"
	description="Shields, deck boxes e triple packs de Pokémon TCG com preço de balcão. Monte o pedido, mande pelo WhatsApp e retire na Jokenpo, no Shopping New Way Center em Natal/RN."
	path="/produtos"
	jsonLd={jsonLd}
>
	<div
		class="shop"
		data-pdv-mode={effectiveMode}
		data-order-api={orderApi ? 'true' : undefined}
		data-whatsapp={whatsappNumber}
		data-max-qty={MAX_QUANTIDADE_POR_ITEM}
		data-low-stock={LOW_STOCK_THRESHOLD}
	>
		<div class="shop-layout">
			<div class="shop-catalog">
				<header class="shop-intro">
					<div>
						<p class="eyebrow">{orderApi ? 'PRODUTOS · RETIRADA NA LOJA' : 'PRODUTOS · PEDIDO PELO WHATSAPP'}</p>
						<h1>TUDO PRO <span>SEU DECK</span></h1>
						<p class="shop-lead">
							{
								orderApi
									? 'Shields, deck boxes, triple packs e mais, com preço de balcão. Monte a sacola, faça o pedido e a gente separa pra você buscar.'
									: 'Shields, deck boxes e triple packs de Pokémon com preço de balcão. Monte a sacola, mande pelo WhatsApp e passe na loja pra buscar.'
							}
						</p>
					</div>
					{
						orderApi ? (
							<ul class="shop-perks" role="list">
								<li><strong>Sem cadastro</strong><span>Só seu nome e WhatsApp</span></li>
								<li><strong>A gente separa</strong><span>A loja confere o estoque e guarda pra você</span></li>
								<li><strong>48 h pra pagar</strong><span>Pix pelo WhatsApp e retirada na loja 24</span></li>
							</ul>
						) : (
							<ul class="shop-perks" role="list">
								<li><strong>Sem cadastro</strong><span>O pedido vai pronto pro nosso WhatsApp</span></li>
								<li><strong>A gente separa</strong><span>Confirmamos o estoque na conversa</span></li>
								<li><strong>Paga na retirada</strong><span>No balcão da loja 24</span></li>
							</ul>
						)
					}
				</header>
				<div class="filter-wrap">
					<div class="filter-toolbar" role="toolbar" aria-label="Filtrar produtos por categoria">
						<button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">
							Todos <span class="badge-count">{totalProducts}</span>
						</button>
						{
							families.map((family) => (
								<button
									type="button"
									class={`filter-btn tone-${toneOf(family)}`}
									data-filter={family.slug}
									aria-pressed="false"
								>
									{family.category} <span class="badge-count">{family.variants.length}</span>
								</button>
							))
						}
					</div>
				</div>
				<p id="filter-status" class="sr-only" aria-live="polite"></p>

				{
					families.map((family) => {
						const tone = toneOf(family);
						return (
							<section class="category" id={family.slug} data-category={family.slug} aria-labelledby={`${family.slug}-title`}>
								<div class="category-head">
									<h2 id={`${family.slug}-title`} class={`category-title tone-${tone}`}>
										{family.category}
									</h2>
									<p class="category-count">
										{family.variants.length} {family.variants.length === 1 ? 'produto' : 'produtos'}
									</p>
									{family.description && <p class="category-desc">{family.description}</p>}
								</div>
								<ul class="product-grid" role="list">
									{family.variants.map((variant, index) => {
										const level = stockLevel(variant.stock);
										return (
											<li>
												<article
													class={`product-card tone-${tone}`}
													data-id={variant.id}
													data-price={variant.priceCents}
													data-stock={variant.stock}
													data-title={variant.title}
													data-swatch={variant.swatch ?? (family.slug === 'shield-personalizada' ? 'art' : undefined)}
													data-index={index}
													aria-labelledby={`p-${variant.id}`}
												>
													<div class={`product-visual visual-${family.type}`} aria-hidden="true">
														<span />
														<span />
														<span />
													</div>
													<div class="card-body">
														<p class="card-kicker">{family.subtitle}</p>
														<h3 class="card-title" id={`p-${variant.id}`}>
															{variant.title}
														</h3>
														<p class="card-price">{formatPrice(variant.priceCents)}</p>
														<p class="card-stock" data-role="stock" data-level={level}>
															{stockText[level]}
														</p>
														<div class="card-action">
															<button type="button" class="add-btn" data-role="add" disabled={level === 'out'}>
																{level === 'out' ? 'Esgotado' : 'Adicionar'}
															</button>
															<div class="card-qty" data-role="qty" role="group" aria-label={`${variant.title} na sacola`} hidden>
																<button type="button" class="step-btn" data-step="-1" aria-label={`Tirar uma unidade de ${variant.title}`}>
																	<Icon name="lucide:minus" size={16} weight={3} />
																</button>
																<span class="card-qty-value" data-role="qty-value">1 na sacola</span>
																<button type="button" class="step-btn" data-step="1" aria-label={`Adicionar mais uma unidade de ${variant.title}`}>
																	<Icon name="lucide:plus" size={16} weight={3} />
																</button>
															</div>
														</div>
													</div>
												</article>
											</li>
										);
									})}
								</ul>
							</section>
						);
					})
				}
				{
					families.length === 0 && (
						<p class="catalog-empty">
							Nenhum produto no site agora. Chama a gente no{' '}
							<a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (abre em nova aba)</span></a>{' '}
							que a gente te conta o que tem na loja.
						</p>
					)
				}
				<p class="catalog-note">
					{
						fonte === 'pdv'
							? 'Preço e estoque direto do sistema da loja. A loja confirma a disponibilidade quando recebe o pedido.'
							: `Preços e estoque do PDV da loja em ${catalogDate}. A disponibilidade é confirmada na hora do pedido.`
					}
				</p>
			</div>

			<aside class="cart" id="sacola" aria-labelledby="cart-heading">
				<div class="cart-panel">
					<div class="cart-head">
						<h2 id="cart-heading" class="cart-heading" tabindex="-1">Sua sacola <span class="cart-count" data-role="cart-count"></span></h2>
						<button type="button" class="cart-close" data-role="cart-close" aria-label="Fechar sacola">
							<Icon name="lucide:x" size={18} weight={3} />
						</button>
					</div>

					<div class="cart-scroll">
						{
							orderApi && (
								<section class="order-status" data-role="order-status" aria-labelledby="order-title" hidden>
									<p class="order-kicker">Seu pedido</p>
									<h3 class="order-title" id="order-title" tabindex="-1">Pedido #<span data-role="order-number"></span></h3>
									<p class="order-state" data-role="order-state" data-state="AGUARDANDO_CONFIRMACAO" role="status"></p>
									<ul class="order-items" data-role="order-items" role="list"></ul>
									<a
										class="button button-pink cart-cta"
										data-role="order-whatsapp"
										href={`https://wa.me/${whatsappNumber}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Icon name="simple-icons:whatsapp" class="whatsapp-icon" size={20} />
										<span data-role="order-whatsapp-label">Combinar o pagamento</span>
										<span class="sr-only">(abre o WhatsApp em nova aba)</span>
									</a>
									<button type="button" class="cart-clear" data-role="order-dismiss">Fechar e fazer outro pedido</button>
								</section>
							)
						}
						<div class="cart-empty" data-role="cart-empty">
							<p class="cart-empty-title">Tá vazia por enquanto</p>
							<p>Toque em <strong>Adicionar</strong> num produto e ele aparece aqui.</p>
						</div>
						<ul class="cart-list" data-role="cart-list" role="list"></ul>
						<template data-role="line-template">
							<li class="cart-line">
								<div class="line-info">
									<span class="line-name"></span>
									<span class="line-unit"></span>
								</div>
								<div class="line-qty" role="group">
									<button type="button" class="step-btn" data-step="-1"><Icon name="lucide:minus" size={16} weight={3} /></button>
									<span class="line-qty-value"></span>
									<button type="button" class="step-btn" data-step="1"><Icon name="lucide:plus" size={16} weight={3} /></button>
								</div>
								<span class="line-price"></span>
								<button type="button" class="line-remove">Remover</button>
							</li>
						</template>
					</div>

					<div class="cart-foot" data-role="cart-foot" hidden>
						<p class="cart-total">
							<span>Total <small data-role="cart-items"></small></span>
							<strong data-role="cart-total">R$ 0</strong>
						</p>
						{
							orderApi ? (
								<form class="order-form" data-role="order-form" novalidate>
									<div class="field">
										<label for="order-name">Seu nome</label>
										<input id="order-name" name="nome" type="text" autocomplete="name" maxlength="80" required />
									</div>
									<div class="field">
										<label for="order-phone">WhatsApp com DDD</label>
										<input
											id="order-phone"
											name="telefone"
											type="tel"
											inputmode="tel"
											autocomplete="tel-national"
											placeholder="(84) 9 0000-0000"
											maxlength="20"
											required
										/>
									</div>
									<p class="order-error" data-role="order-error" role="alert" hidden></p>
									<button type="submit" class="button button-pink cart-cta" data-role="order-submit">Fazer pedido</button>
									<p class="cart-hint">A loja confere o estoque e você paga por Pix no WhatsApp em até 48 h. Retirada na loja 24.</p>
								</form>
							) : (
								<>
									<a
										class="button button-pink cart-cta"
										data-role="whatsapp-link"
										href={`https://wa.me/${whatsappNumber}`}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Icon name="simple-icons:whatsapp" class="whatsapp-icon" size={20} />
										Enviar pedido no WhatsApp
										<span class="sr-only">(abre o WhatsApp em nova aba)</span>
									</a>
									<p class="cart-hint">A conversa abre com o pedido escrito. É só tocar em enviar.</p>
									<details class="cart-preview">
										<summary>Ver a mensagem</summary>
										<pre data-role="message"></pre>
									</details>
									<div class="cart-sent" data-role="cart-sent" role="status" hidden>
										<p>Mandou a mensagem? A loja confirma o estoque e avisa quando estiver separado.</p>
										<button type="button" class="cart-clear" data-role="cart-clear">Esvaziar sacola</button>
									</div>
								</>
							)
						}
					</div>
				</div>
			</aside>
		</div>

		<button type="button" class="cart-bar" data-role="cart-bar" aria-controls="sacola" aria-expanded="false" hidden>
			<span class="cart-bar-count">
				<Icon name="lucide:shopping-bag" size={16} weight={3} />
				<span data-role="bar-count">0</span>
			</span>
			<span class="cart-bar-label">Ver sacola</span>
			<strong class="cart-bar-total" data-role="bar-total">R$ 0</strong>
		</button>
		<div class="cart-backdrop" data-role="cart-backdrop" hidden></div>
		<p class="sr-only" data-role="announce" aria-live="polite"></p>
	</div>
</BaseLayout>

<script>
	import { formatPrice } from '../lib/catalog';

	type Line = { id: string; qty: number };
	type OrderStatus = 'AGUARDANDO_CONFIRMACAO' | 'PAGAMENTO_PENDENTE' | 'PAGO' | 'ENTREGUE' | 'RECUSADO' | 'CANCELADO' | 'EXPIRADO';
	type SavedOrder = {
		id: string;
		numero: number;
		status: OrderStatus;
		itens: { descricao: string; quantidade: number }[];
		totalCentavos: number;
		validoAte: string | null;
		motivo: string | null;
	};

	const root = document.querySelector<HTMLElement>('.shop');
	if (root) {
		const $ = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = root) =>
			scope.querySelector<T>(selector)!;
		const mode = root.dataset.pdvMode;
		const maxQty = Number(root.dataset.maxQty) || 5;
		const lowStock = Number(root.dataset.lowStock) || 3;
		const STORAGE_KEY = 'jokenpo:sacola';
		const ORDER_KEY = 'jokenpo:pedido';
		const optional = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector);

		const cards = new Map(
			[...root.querySelectorAll<HTMLElement>('.product-card')].map((card) => [card.dataset.id!, card]),
		);
		const cart = new Map<string, Line>();

		const cartEl = $('#sacola');
		const cartList = $<HTMLUListElement>('[data-role="cart-list"]');
		const cartEmpty = $('[data-role="cart-empty"]');
		const cartFoot = $('[data-role="cart-foot"]');
		const bar = $<HTMLButtonElement>('[data-role="cart-bar"]');
		const lineTpl = $<HTMLTemplateElement>('[data-role="line-template"]');
		const backdrop = $('[data-role="cart-backdrop"]');
		const announce = $('[data-role="announce"]');
		const drawerQuery = window.matchMedia('(max-width: 1023px)');

		const info = (id: string) => {
			const card = cards.get(id)!;
			return {
				title: card.dataset.title ?? '',
				price: Number(card.dataset.price),
				stock: Number(card.dataset.stock),
			};
		};
		const limit = (id: string) => Math.max(0, Math.min(info(id).stock, maxQty));
		const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
		const totals = () => {
			let items = 0;
			let cents = 0;
			cart.forEach((line) => {
				items += line.qty;
				cents += line.qty * info(line.id).price;
			});
			return { items, cents };
		};

		/* Persistência local: a sacola sobrevive a um recarregamento. */
		const save = () => {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify([...cart.values()]));
			} catch {
				/* Navegação privada ou armazenamento bloqueado. */
			}
		};
		const restore = () => {
			try {
				const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]') as Line[];
				saved.forEach((line) => {
					if (cards.has(line.id) && Number.isInteger(line.qty) && line.qty > 0) {
						const qty = Math.min(line.qty, limit(line.id));
						if (qty > 0) cart.set(line.id, { id: line.id, qty });
					}
				});
			} catch {
				/* Ignora dado corrompido. */
			}
		};

		const pulseBar = () => {
			bar.classList.remove('is-pulse');
			void bar.offsetWidth;
			bar.classList.add('is-pulse');
		};

		/* Quantidade: um único ponto de mudança para card e sacola. */
		const setQty = (id: string, qty: number, origin: 'card' | 'cart') => {
			const { title } = info(id);
			const next = Math.max(0, Math.min(qty, limit(id)));
			const before = cart.get(id)?.qty ?? 0;
			if (next === 0) cart.delete(id);
			else cart.set(id, { id, qty: next });
			const sent = optional('[data-role="cart-sent"]');
			if (sent) sent.hidden = true;
			render();
			save();
			if (next === before && qty > before) announce.textContent = `Limite de ${plural(next, 'unidade', 'unidades')} de ${title}.`;
			else if (next === 0) announce.textContent = `${title} saiu da sacola.`;
			else announce.textContent = `${title}: ${next} na sacola. Total ${formatPrice(totals().cents)}.`;
			if (origin === 'card' && before === 0 && next > 0) pulseBar();
		};

		/* Cards */
		const syncCard = (card: HTMLElement) => {
			const id = card.dataset.id!;
			const stock = Number(card.dataset.stock);
			const qty = cart.get(id)?.qty ?? 0;
			const level = stock <= 0 ? 'out' : stock <= lowStock ? 'low' : 'ok';
			const add = $<HTMLButtonElement>('[data-role="add"]', card);
			const qtyBox = $('[data-role="qty"]', card);
			const stockEl = $('[data-role="stock"]', card);
			card.classList.toggle('is-in-cart', qty > 0);
			add.hidden = qty > 0;
			add.disabled = level === 'out';
			add.textContent = level === 'out' ? 'Esgotado' : 'Adicionar';
			qtyBox.hidden = qty === 0;
			$('[data-role="qty-value"]', card).textContent = `${qty} na sacola`;
			$<HTMLButtonElement>('[data-step="1"]', card).disabled = qty >= limit(id);
			stockEl.dataset.level = level;
			stockEl.textContent = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' }[level];
		};

		cards.forEach((card, id) => {
			$('[data-role="add"]', card).addEventListener('click', () => {
				setQty(id, 1, 'card');
				const plus = $<HTMLButtonElement>('[data-step="1"]', card);
				(plus.disabled ? $<HTMLButtonElement>('[data-step="-1"]', card) : plus).focus();
			});
			card.querySelectorAll<HTMLButtonElement>('.step-btn').forEach((button) => {
				button.addEventListener('click', () => {
					const next = (cart.get(id)?.qty ?? 0) + Number(button.dataset.step);
					setQty(id, next, 'card');
					if (next === 0) $<HTMLButtonElement>('[data-role="add"]', card).focus();
					else if (button.disabled) $<HTMLButtonElement>('[data-step="-1"]', card).focus();
				});
			});
		});

		/* Sacola */
		const lineTemplate = (line: Line) => {
			const { title, price } = info(line.id);
			const li = lineTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
			li.dataset.id = line.id;
			li.querySelector('.line-name')!.textContent = title;
			li.querySelector('.line-unit')!.textContent = `${formatPrice(price)} cada`;
			li.querySelector('.line-qty')!.setAttribute('aria-label', `Quantidade de ${title}`);
			li.querySelector('.line-qty-value')!.textContent = String(line.qty);
			li.querySelector('.line-price')!.textContent = formatPrice(price * line.qty);
			const [minus, plus] = li.querySelectorAll<HTMLButtonElement>('.step-btn');
			minus.setAttribute('aria-label', `Tirar uma unidade de ${title}`);
			plus.setAttribute('aria-label', `Adicionar mais uma unidade de ${title}`);
			plus.disabled = line.qty >= limit(line.id);
			minus.addEventListener('click', () => {
				setQty(line.id, line.qty - 1, 'cart');
				focusLine(line.id, '[data-step="-1"]');
			});
			plus.addEventListener('click', () => {
				setQty(line.id, line.qty + 1, 'cart');
				focusLine(line.id, '[data-step="1"]');
			});
			const remove = li.querySelector<HTMLButtonElement>('.line-remove')!;
			remove.setAttribute('aria-label', `Remover ${title} da sacola`);
			remove.addEventListener('click', () => {
				setQty(line.id, 0, 'cart');
				focusLine(line.id, '.line-remove');
			});
			return li;
		};

		/** Mantém o foco no mesmo controle depois de redesenhar; se a linha sumiu, vai para o título. */
		const focusLine = (id: string, selector: string) => {
			const li = cartList.querySelector<HTMLElement>(`[data-id="${id}"]`);
			const target = li?.querySelector<HTMLButtonElement>(selector);
			if (target && !target.disabled) target.focus();
			else (li?.querySelector<HTMLButtonElement>('.line-remove') ?? $('#cart-heading')).focus();
		};

		/** Mensagem pronta pro WhatsApp da loja, no tom da marca e sem emoji. */
		function orderMessage(cents: number) {
			const lines = [...cart.values()].map((line) => {
				const { title, price } = info(line.id);
				const unit = line.qty > 1 ? ` (${formatPrice(price)} cada)` : '';
				return `${line.qty}x ${title}${unit} = ${formatPrice(price * line.qty)}`;
			});
			return [
				'Oi, Jokenpo! Quero fazer um pedido pra retirar na loja:',
				'',
				...lines,
				'',
				`Total: ${formatPrice(cents)}`,
				'',
				'Pode separar pra mim?',
			].join('\n');
		}

		function render() {
			const { items, cents } = totals();
			const empty = cart.size === 0;
			cartList.replaceChildren(...[...cart.values()].map(lineTemplate));
			cartEmpty.hidden = !empty || Boolean(order); // com pedido aberto, o painel do pedido ocupa o lugar
			cartFoot.hidden = empty;
			$('[data-role="cart-count"]').textContent = empty ? '' : `(${items})`;
			$('[data-role="cart-total"]').textContent = formatPrice(cents);
			$('[data-role="cart-items"]').textContent = empty ? '' : plural(items, 'item', 'itens');
			$('[data-role="bar-count"]').textContent = String(items);
			$('[data-role="bar-total"]').textContent = formatPrice(cents);
			bar.setAttribute('aria-label', `Ver sacola: ${plural(items, 'item', 'itens')}, ${formatPrice(cents)}`);
			bar.hidden = empty && !order;
			if (empty && order) {
				$('[data-role="bar-count"]').textContent = `#${order.numero}`;
				$('[data-role="bar-total"]').textContent = formatPrice(order.totalCentavos);
				bar.querySelector('.cart-bar-label')!.textContent = 'Ver pedido';
				bar.setAttribute('aria-label', `Ver pedido número ${order.numero}`);
			} else {
				bar.querySelector('.cart-bar-label')!.textContent = 'Ver sacola';
			}
			cards.forEach(syncCard);
			const message = optional('[data-role="message"]');
			const link = optional<HTMLAnchorElement>('[data-role="whatsapp-link"]');
			if (message && link) {
				const text = orderMessage(cents);
				message.textContent = text;
				link.href = `https://wa.me/${root!.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
			}
		}

		/* Gaveta no celular, coluna fixa no desktop */
		let drawerOpen = false;
		const syncDrawer = () => {
			const isDrawer = drawerQuery.matches;
			const open = isDrawer && drawerOpen;
			cartEl.classList.toggle('is-open', open);
			cartEl.inert = isDrawer && !drawerOpen;
			backdrop.hidden = !open;
			bar.setAttribute('aria-expanded', String(open));
			document.documentElement.classList.toggle('cart-locked', open);
			if (open) {
				cartEl.setAttribute('role', 'dialog');
				cartEl.setAttribute('aria-modal', 'true');
			} else {
				cartEl.removeAttribute('role');
				cartEl.removeAttribute('aria-modal');
			}
		};
		const openDrawer = () => {
			drawerOpen = true;
			syncDrawer();
			$<HTMLButtonElement>('[data-role="cart-close"]').focus();
		};
		const closeDrawer = () => {
			if (!drawerOpen) return;
			drawerOpen = false;
			syncDrawer();
			if (!bar.hidden) bar.focus();
		};
		bar.addEventListener('click', openDrawer);
		backdrop.addEventListener('click', closeDrawer);
		$('[data-role="cart-close"]').addEventListener('click', closeDrawer);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeDrawer();
		});
		drawerQuery.addEventListener('change', () => {
			drawerOpen = false;
			syncDrawer();
		});

		/* Filtro por categoria */
		const filterButtons = [...root.querySelectorAll<HTMLButtonElement>('.filter-btn')];
		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;
				filterButtons.forEach((b) => {
					b.classList.toggle('is-active', b === button);
					b.setAttribute('aria-pressed', String(b === button));
				});
				let visible = 0;
				root.querySelectorAll<HTMLElement>('.category').forEach((section) => {
					const show = filter === 'all' || section.dataset.category === filter;
					section.hidden = !show;
					if (show) visible += section.querySelectorAll('.product-card').length;
				});
				$('#filter-status').textContent = `Mostrando ${plural(visible, 'produto', 'produtos')}.`;
			});
		});

		const refreshStock = async () => {
			try {
				const response = await fetch('/api/pdv/estoque', { headers: { accept: 'application/json' } });
				if (!response.ok) return;
				const items = (await response.json()) as { produtoId: string; disponivel: number; precoCentavos?: number }[];
				const seen = new Set<string>();
				items.forEach(({ produtoId, disponivel, precoCentavos }) => {
					const card = cards.get(produtoId);
					if (!card) return;
					seen.add(produtoId);
					card.dataset.stock = String(disponivel);
					if (precoCentavos && precoCentavos !== Number(card.dataset.price)) {
						card.dataset.price = String(precoCentavos);
						$('.card-price', card).textContent = formatPrice(precoCentavos);
					}
				});
				// Produto que saiu do catálogo no PDV fica como esgotado até a página recarregar
				if (mode === 'live') cards.forEach((card, id) => !seen.has(id) && (card.dataset.stock = '0'));
				cart.forEach((line) => {
					const max = limit(line.id);
					if (max === 0) cart.delete(line.id);
					else if (line.qty > max) line.qty = max;
				});
				render();
				save();
			} catch {
				/* Mantém o estoque estático da página. */
			}
		};

		/* Envio pelo WhatsApp (modo sem PDV): a sacola fica até o cliente esvaziar, caso precise reenviar. */
		optional('[data-role="whatsapp-link"]')?.addEventListener('click', () => {
			$('[data-role="cart-sent"]').hidden = false;
		});
		optional('[data-role="cart-clear"]')?.addEventListener('click', () => {
			cart.clear();
			save();
			render();
			$('[data-role="cart-sent"]').hidden = true;
			announce.textContent = 'Sacola esvaziada.';
			$('#cart-heading').focus();
		});

		/* Pedido pelo site (modo com PDV): a loja confirma o estoque e o pagamento é combinado no WhatsApp. */
		const ORDER_TEXT: Record<OrderStatus, (o: SavedOrder) => string> = {
			AGUARDANDO_CONFIRMACAO: () =>
				'Recebido! A loja confere o estoque assim que o sistema da loja estiver ligado e as unidades ficam guardadas pra você enquanto isso.',
			PAGAMENTO_PENDENTE: (o) =>
				`Separado! Pague por Pix no WhatsApp até ${deadline(o.validoAte)}. Depois disso as unidades voltam pra loja.`,
			PAGO: () => 'Pagamento recebido. É só passar na loja 24 pra retirar.',
			ENTREGUE: () => 'Entregue. Bom jogo!',
			RECUSADO: () => 'Esse não deu: algum item acabou antes de a loja confirmar. Chama a gente no WhatsApp que a gente vê uma alternativa.',
			CANCELADO: (o) => `A loja cancelou este pedido${o.motivo ? ` (${o.motivo})` : ''}.`,
			EXPIRADO: () => 'O prazo de 48 h pra pagar acabou e as unidades voltaram pra loja. Se ainda quiser, é só pedir de novo.',
		};
		const FINAL: OrderStatus[] = ['ENTREGUE', 'RECUSADO', 'CANCELADO', 'EXPIRADO'];
		let order: SavedOrder | null = null;
		let pollTimer: number | undefined;

		function deadline(iso: string | null) {
			if (!iso) return 'o prazo combinado';
			return new Intl.DateTimeFormat('pt-BR', {
				weekday: 'long',
				day: '2-digit',
				month: '2-digit',
				hour: '2-digit',
				minute: '2-digit',
				timeZone: 'America/Fortaleza',
			}).format(new Date(iso));
		}

		const saveOrder = () => {
			try {
				if (order) localStorage.setItem(ORDER_KEY, JSON.stringify(order));
				else localStorage.removeItem(ORDER_KEY);
			} catch {
				/* Armazenamento bloqueado: o pedido continua valendo, só não reaparece ao recarregar. */
			}
		};

		function renderOrder() {
			const panel = optional('[data-role="order-status"]');
			if (!panel) return;
			panel.hidden = !order;
			if (!order) return;
			$('[data-role="order-number"]', panel).textContent = String(order.numero);
			const state = $('[data-role="order-state"]', panel);
			state.dataset.state = order.status;
			state.textContent = ORDER_TEXT[order.status](order);
			$('[data-role="order-items"]', panel).replaceChildren(
				...order.itens.map((item) => {
					const li = document.createElement('li');
					li.textContent = `${item.quantidade}x ${item.descricao}`;
					return li;
				}),
				Object.assign(document.createElement('li'), { className: 'order-total', textContent: `Total ${formatPrice(order.totalCentavos)}` }),
			);
			const text =
				order.status === 'RECUSADO'
					? `Oi, Jokenpo! O pedido #${order.numero} do site não tinha estoque. Tem alguma alternativa?`
					: `Oi, Jokenpo! Fiz o pedido #${order.numero} no site (total ${formatPrice(order.totalCentavos)}). Como faço o pagamento?`;
			const whatsapp = $<HTMLAnchorElement>('[data-role="order-whatsapp"]', panel);
			whatsapp.href = `https://wa.me/${root!.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
			whatsapp.hidden = order.status === 'PAGO' || order.status === 'ENTREGUE';
			$('[data-role="order-whatsapp-label"]', panel).textContent =
				order.status === 'RECUSADO' ? 'Falar com a loja' : 'Combinar o pagamento';
			$('[data-role="order-dismiss"]', panel).textContent = FINAL.includes(order.status) ? 'Fechar' : 'Fechar e fazer outro pedido';
		}

		async function pollOrder() {
			window.clearTimeout(pollTimer);
			if (!order || FINAL.includes(order.status)) return;
			if (document.visibilityState === 'visible') {
				try {
					const response = await fetch(`/api/pdv/pedidos/${order.id}`, { headers: { accept: 'application/json' } });
					if (response.status === 404) {
						order = null;
					} else if (response.ok) {
						const data = (await response.json()) as SavedOrder;
						const changed = data.status !== order.status;
						order = { ...order, status: data.status, validoAte: data.validoAte, motivo: data.motivo };
						if (changed) announce.textContent = `Pedido ${order.numero}: ${ORDER_TEXT[order.status](order)}`;
					}
					saveOrder();
					renderOrder();
					render();
				} catch {
					/* Sem rede: tenta de novo no próximo ciclo. */
				}
			}
			pollTimer = window.setTimeout(pollOrder, 20_000);
		}
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void pollOrder();
		});

		const orderForm = optional<HTMLFormElement>('[data-role="order-form"]');
		if (orderForm) {
			const errorEl = $('[data-role="order-error"]', orderForm);
			const submit = $<HTMLButtonElement>('[data-role="order-submit"]', orderForm);
			const nameInput = $<HTMLInputElement>('#order-name', orderForm);
			const phoneInput = $<HTMLInputElement>('#order-phone', orderForm);
			const showError = (message: string, field?: HTMLInputElement) => {
				errorEl.textContent = message;
				errorEl.hidden = false;
				[nameInput, phoneInput].forEach((input) => input.toggleAttribute('aria-invalid', input === field));
				if (field) {
					field.setAttribute('aria-describedby', 'order-error');
					field.focus();
				}
			};
			errorEl.id = 'order-error';

			orderForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				errorEl.hidden = true;
				const nome = nameInput.value.trim();
				const telefone = phoneInput.value.replace(/\D/g, '');
				if (nome.length < 2) return showError('Coloca seu nome pra gente achar o pedido no balcão.', nameInput);
				if (telefone.length < 10 || telefone.length > 13) return showError('Coloca um WhatsApp com DDD, tipo (84) 9 0000-0000.', phoneInput);

				submit.disabled = true;
				submit.textContent = 'Enviando…';
				try {
					const response = await fetch('/api/pdv/pedidos', {
						method: 'POST',
						headers: { 'content-type': 'application/json', accept: 'application/json' },
						body: JSON.stringify({
							nomeContato: nome,
							telefoneContato: telefone,
							itens: [...cart.values()].map((line) => ({ produtoId: line.id, quantidade: line.qty })),
						}),
					});
					const data = await response.json().catch(() => null);
					if (!response.ok) {
						const erro = data?.erro as { codigo?: string; mensagem?: string; detalhes?: unknown } | undefined;
						if (erro?.codigo === 'ESTOQUE_INSUFICIENTE' || erro?.codigo === 'ITEM_INVALIDO') {
							// Atualiza o estoque dos itens que faltaram e ajusta a sacola
							if (Array.isArray(erro.detalhes)) {
								(erro.detalhes as { produtoId: string; disponivel: number }[]).forEach(({ produtoId, disponivel }) => {
									const card = cards.get(produtoId);
									if (card) card.dataset.stock = String(disponivel);
								});
								cart.forEach((line) => {
									const max = limit(line.id);
									if (max === 0) cart.delete(line.id);
									else if (line.qty > max) line.qty = max;
								});
								save();
								render();
							}
							return showError(`${erro.mensagem ?? 'Um item acabou.'} A sacola foi ajustada: confere e tenta de novo.`);
						}
						if (erro?.codigo === 'CONTATO_INVALIDO') return showError(erro.mensagem ?? 'Confere seu nome e WhatsApp.', phoneInput);
						if (erro?.codigo === 'MUITAS_TENTATIVAS' && erro.mensagem) return showError(erro.mensagem);
						return showError('Não deu pra enviar agora. Tenta de novo em instantes ou chama a gente no WhatsApp.');
					}
					const created = data as SavedOrder;
					order = {
						id: created.id,
						numero: created.numero,
						status: created.status,
						itens: created.itens,
						totalCentavos: created.totalCentavos,
						validoAte: created.validoAte,
						motivo: created.motivo,
					};
					saveOrder();
					cart.clear();
					save();
					orderForm.reset();
					render();
					renderOrder();
					$('#order-title').focus();
					void pollOrder();
				} catch {
					showError('Sem conexão. Confere sua internet e tenta de novo.');
				} finally {
					submit.disabled = false;
					submit.textContent = 'Fazer pedido';
				}
			});

			$('[data-role="order-dismiss"]').addEventListener('click', () => {
				window.clearTimeout(pollTimer);
				order = null;
				saveOrder();
				renderOrder();
				render();
				announce.textContent = 'Pedido fechado nesta tela. Ele continua valendo na loja.';
				$('#cart-heading').focus();
			});

			try {
				const saved = JSON.parse(localStorage.getItem(ORDER_KEY) ?? 'null') as SavedOrder | null;
				if (saved && typeof saved.id === 'string' && Number.isInteger(saved.numero) && ORDER_TEXT[saved.status]) order = saved;
			} catch {
				/* Ignora dado corrompido. */
			}
		}

		// Com o PDV ligado (real ou simulado), a vitrine atualiza estoque e preço ao vivo.
		if (mode === 'mock' || mode === 'live') {
			const schedule = (cb: () => void) =>
				'requestIdleCallback' in window ? requestIdleCallback(cb) : setTimeout(cb, 300);
			schedule(() => void refreshStock());
		}

		restore();
		render();
		renderOrder();
		syncDrawer();
		if (order) void pollOrder();
	}
</script>

