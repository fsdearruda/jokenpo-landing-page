---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';
import { LOW_STOCK_THRESHOLD, catalog, families, formatPrice, productTypes } from '../lib/catalog';
import { pdvMode } from '../lib/pdv';
import { MAX_QUANTIDADE_POR_ITEM } from '../lib/pdv/mock';

export const prerender = true;

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const pageUrl = `${siteUrl}/produtos`;
const whatsappNumber = siteData.contact.whatsapp.replace(/\D/g, '');
const catalogDate = catalog.extractedAt.split('-').reverse().join('/');
const totalProducts = families.reduce((sum, family) => sum + family.variants.length, 0);

const stockLevel = (stock: number) => (stock <= 0 ? 'out' : stock <= LOW_STOCK_THRESHOLD ? 'low' : 'ok');
const stockText = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' } as const;

const jsonLd = [
	{
		'@type': 'ItemList',
		'@id': `${pageUrl}#produtos`,
		name: 'Produtos Jokenpo: shields, deck boxes e triple packs',
		numberOfItems: families.length,
		itemListElement: families.map((family, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			item: {
				'@type': 'ProductGroup',
				'@id': `${pageUrl}#${family.slug}`,
				name: family.name,
				description: family.description,
				productGroupID: family.slug,
				url: `${pageUrl}#${family.slug}`,
				variesBy: family.variantLabel === 'Cor' ? 'https://schema.org/color' : 'https://schema.org/size',
				hasVariant: family.variants.map((variant) => ({
					'@type': 'Product',
					name: variant.title,
					...(variant.sku ? { sku: variant.sku } : {}),
					offers: {
						'@type': 'Offer',
						price: (variant.priceCents / 100).toFixed(2),
						priceCurrency: 'BRL',
						availability:
							variant.stock > 0 ? 'https://schema.org/InStoreOnly' : 'https://schema.org/OutOfStock',
						seller: { '@id': `${siteUrl}/#store` },
					},
				})),
			},
		})),
	},
];
---

<BaseLayout
	title="Produtos: shields, deck boxes e triple packs | Jokenpo"
	description="Shields, deck boxes e triple packs de Pokémon TCG com preço de balcão. Monte o pedido, mande pelo WhatsApp e retire na Jokenpo, no Shopping New Way Center em Natal/RN."
	path="/produtos"
	jsonLd={jsonLd}
>
	<div
		class="shop"
		data-pdv-mode={pdvMode}
		data-whatsapp={whatsappNumber}
		data-max-qty={MAX_QUANTIDADE_POR_ITEM}
		data-low-stock={LOW_STOCK_THRESHOLD}
	>
		<div class="shop-layout">
			<div class="shop-catalog">
				<header class="shop-intro">
					<div>
						<p class="eyebrow">PRODUTOS · PEDIDO PELO WHATSAPP</p>
						<h1>TUDO PRO <span>SEU DECK</span></h1>
						<p class="shop-lead">
							Shields, deck boxes e triple packs de Pokémon com preço de balcão. Monte a sacola, mande pelo WhatsApp e passe na loja pra buscar.
						</p>
					</div>
					<ul class="shop-perks" role="list">
						<li><strong>Sem cadastro</strong><span>O pedido vai pronto pro nosso WhatsApp</span></li>
						<li><strong>A gente separa</strong><span>Confirmamos o estoque na conversa</span></li>
						<li><strong>Paga na retirada</strong><span>No balcão da loja 24</span></li>
					</ul>
				</header>
				<div class="filter-wrap">
					<div class="filter-toolbar" role="toolbar" aria-label="Filtrar produtos por categoria">
						<button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">
							Todos <span class="badge-count">{totalProducts}</span>
						</button>
						{
							families.map((family) => (
								<button
									type="button"
									class={`filter-btn tone-${productTypes[family.type].color}`}
									data-filter={family.slug}
									aria-pressed="false"
								>
									{family.category} <span class="badge-count">{family.variants.length}</span>
								</button>
							))
						}
					</div>
				</div>
				<p id="filter-status" class="sr-only" aria-live="polite"></p>

				{
					families.map((family) => {
						const tone = productTypes[family.type].color;
						return (
							<section class="category" id={family.slug} data-category={family.slug} aria-labelledby={`${family.slug}-title`}>
								<div class="category-head">
									<h2 id={`${family.slug}-title`} class={`category-title tone-${tone}`}>
										{family.category}
									</h2>
									<p class="category-count">
										{family.variants.length} {family.variants.length === 1 ? 'produto' : 'produtos'}
									</p>
									<p class="category-desc">{family.description}</p>
								</div>
								<ul class="product-grid" role="list">
									{family.variants.map((variant, index) => {
										const level = stockLevel(variant.stock);
										return (
											<li>
												<article
													class={`product-card tone-${tone}`}
													data-id={variant.id}
													data-price={variant.priceCents}
													data-stock={variant.stock}
													data-title={variant.title}
													data-swatch={variant.swatch ?? (family.slug === 'shield-personalizada' ? 'art' : undefined)}
													data-index={index}
													aria-labelledby={`p-${variant.id}`}
												>
													<div class={`product-visual visual-${family.type}`} aria-hidden="true">
														<span />
														<span />
														<span />
													</div>
													<div class="card-body">
														<p class="card-kicker">{family.subtitle}</p>
														<h3 class="card-title" id={`p-${variant.id}`}>
															{variant.title}
														</h3>
														<p class="card-price">{formatPrice(variant.priceCents)}</p>
														<p class="card-stock" data-role="stock" data-level={level}>
															{stockText[level]}
														</p>
														<div class="card-action">
															<button type="button" class="add-btn" data-role="add" disabled={level === 'out'}>
																{level === 'out' ? 'Esgotado' : 'Adicionar'}
															</button>
															<div class="card-qty" data-role="qty" role="group" aria-label={`${variant.title} na sacola`} hidden>
																<button type="button" class="step-btn" data-step="-1" aria-label={`Tirar uma unidade de ${variant.title}`}>
																	<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
																</button>
																<span class="card-qty-value" data-role="qty-value">1 na sacola</span>
																<button type="button" class="step-btn" data-step="1" aria-label={`Adicionar mais uma unidade de ${variant.title}`}>
																	<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg>
																</button>
															</div>
														</div>
													</div>
												</article>
											</li>
										);
									})}
								</ul>
							</section>
						);
					})
				}
				<p class="catalog-note">
					Preços e estoque do PDV da loja em {catalogDate}. A disponibilidade é confirmada na hora da reserva.
				</p>
			</div>

			<aside class="cart" id="sacola" aria-labelledby="cart-heading">
				<div class="cart-panel">
					<div class="cart-head">
						<h2 id="cart-heading" class="cart-heading" tabindex="-1">Sua sacola <span class="cart-count" data-role="cart-count"></span></h2>
						<button type="button" class="cart-close" data-role="cart-close" aria-label="Fechar sacola">
							<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
						</button>
					</div>

					<div class="cart-scroll">
						<div class="cart-empty" data-role="cart-empty">
							<p class="cart-empty-title">Tá vazia por enquanto</p>
							<p>Toque em <strong>Adicionar</strong> num produto e ele aparece aqui.</p>
						</div>
						<ul class="cart-list" data-role="cart-list" role="list"></ul>
					</div>

					<div class="cart-foot" data-role="cart-foot" hidden>
						<p class="cart-total">
							<span>Total <small data-role="cart-items"></small></span>
							<strong data-role="cart-total">R$ 0</strong>
						</p>
						<a
							class="button button-pink cart-cta"
							data-role="whatsapp-link"
							href={`https://wa.me/${whatsappNumber}`}
							target="_blank"
							rel="noopener noreferrer"
						>
							Enviar pedido no WhatsApp
							<span class="sr-only">(abre o WhatsApp em nova aba)</span>
						</a>
						<p class="cart-hint">A conversa abre com o pedido escrito. É só tocar em enviar.</p>
						<details class="cart-preview">
							<summary>Ver a mensagem</summary>
							<pre data-role="message"></pre>
						</details>
						<div class="cart-sent" data-role="cart-sent" role="status" hidden>
							<p>Mandou a mensagem? A loja confirma o estoque e avisa quando estiver separado.</p>
							<button type="button" class="cart-clear" data-role="cart-clear">Esvaziar sacola</button>
						</div>
					</div>
				</div>
			</aside>
		</div>

		<button type="button" class="cart-bar" data-role="cart-bar" aria-controls="sacola" aria-expanded="false" hidden>
			<span class="cart-bar-count" data-role="bar-count">0</span>
			<span class="cart-bar-label">Ver sacola</span>
			<strong class="cart-bar-total" data-role="bar-total">R$ 0</strong>
		</button>
		<div class="cart-backdrop" data-role="cart-backdrop" hidden></div>
		<p class="sr-only" data-role="announce" aria-live="polite"></p>
	</div>
</BaseLayout>

<script>
	import { formatPrice } from '../lib/catalog';

	type Line = { id: string; qty: number };

	const root = document.querySelector<HTMLElement>('.shop');
	if (root) {
		const $ = <T extends Element = HTMLElement>(selector: string, scope: ParentNode = root) =>
			scope.querySelector<T>(selector)!;
		const mode = root.dataset.pdvMode;
		const maxQty = Number(root.dataset.maxQty) || 5;
		const lowStock = Number(root.dataset.lowStock) || 3;
		const STORAGE_KEY = 'jokenpo:sacola';

		const cards = new Map(
			[...root.querySelectorAll<HTMLElement>('.product-card')].map((card) => [card.dataset.id!, card]),
		);
		const cart = new Map<string, Line>();

		const cartEl = $('#sacola');
		const cartList = $<HTMLUListElement>('[data-role="cart-list"]');
		const cartEmpty = $('[data-role="cart-empty"]');
		const cartFoot = $('[data-role="cart-foot"]');
		const bar = $<HTMLButtonElement>('[data-role="cart-bar"]');
		const backdrop = $('[data-role="cart-backdrop"]');
		const announce = $('[data-role="announce"]');
		const drawerQuery = window.matchMedia('(max-width: 1023px)');

		const info = (id: string) => {
			const card = cards.get(id)!;
			return {
				title: card.dataset.title ?? '',
				price: Number(card.dataset.price),
				stock: Number(card.dataset.stock),
			};
		};
		const limit = (id: string) => Math.max(0, Math.min(info(id).stock, maxQty));
		const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
		const totals = () => {
			let items = 0;
			let cents = 0;
			cart.forEach((line) => {
				items += line.qty;
				cents += line.qty * info(line.id).price;
			});
			return { items, cents };
		};

		/* Persistência local: a sacola sobrevive a um recarregamento. */
		const save = () => {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify([...cart.values()]));
			} catch {
				/* Navegação privada ou armazenamento bloqueado. */
			}
		};
		const restore = () => {
			try {
				const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]') as Line[];
				saved.forEach((line) => {
					if (cards.has(line.id) && Number.isInteger(line.qty) && line.qty > 0) {
						const qty = Math.min(line.qty, limit(line.id));
						if (qty > 0) cart.set(line.id, { id: line.id, qty });
					}
				});
			} catch {
				/* Ignora dado corrompido. */
			}
		};

		const pulseBar = () => {
			bar.classList.remove('is-pulse');
			void bar.offsetWidth;
			bar.classList.add('is-pulse');
		};

		/* Quantidade: um único ponto de mudança para card e sacola. */
		const setQty = (id: string, qty: number, origin: 'card' | 'cart') => {
			const { title } = info(id);
			const next = Math.max(0, Math.min(qty, limit(id)));
			const before = cart.get(id)?.qty ?? 0;
			if (next === 0) cart.delete(id);
			else cart.set(id, { id, qty: next });
			$('[data-role="cart-sent"]').hidden = true;
			render();
			save();
			if (next === before && qty > before) announce.textContent = `Limite de ${plural(next, 'unidade', 'unidades')} de ${title}.`;
			else if (next === 0) announce.textContent = `${title} saiu da sacola.`;
			else announce.textContent = `${title}: ${next} na sacola. Total ${formatPrice(totals().cents)}.`;
			if (origin === 'card' && before === 0 && next > 0) pulseBar();
		};

		/* Cards */
		const syncCard = (card: HTMLElement) => {
			const id = card.dataset.id!;
			const stock = Number(card.dataset.stock);
			const qty = cart.get(id)?.qty ?? 0;
			const level = stock <= 0 ? 'out' : stock <= lowStock ? 'low' : 'ok';
			const add = $<HTMLButtonElement>('[data-role="add"]', card);
			const qtyBox = $('[data-role="qty"]', card);
			const stockEl = $('[data-role="stock"]', card);
			card.classList.toggle('is-in-cart', qty > 0);
			add.hidden = qty > 0;
			add.disabled = level === 'out';
			add.textContent = level === 'out' ? 'Esgotado' : 'Adicionar';
			qtyBox.hidden = qty === 0;
			$('[data-role="qty-value"]', card).textContent = `${qty} na sacola`;
			$<HTMLButtonElement>('[data-step="1"]', card).disabled = qty >= limit(id);
			stockEl.dataset.level = level;
			stockEl.textContent = { out: 'Esgotado', low: 'Últimas unidades', ok: 'Em estoque' }[level];
		};

		cards.forEach((card, id) => {
			$('[data-role="add"]', card).addEventListener('click', () => {
				setQty(id, 1, 'card');
				const plus = $<HTMLButtonElement>('[data-step="1"]', card);
				(plus.disabled ? $<HTMLButtonElement>('[data-step="-1"]', card) : plus).focus();
			});
			card.querySelectorAll<HTMLButtonElement>('.step-btn').forEach((button) => {
				button.addEventListener('click', () => {
					const next = (cart.get(id)?.qty ?? 0) + Number(button.dataset.step);
					setQty(id, next, 'card');
					if (next === 0) $<HTMLButtonElement>('[data-role="add"]', card).focus();
					else if (button.disabled) $<HTMLButtonElement>('[data-step="-1"]', card).focus();
				});
			});
		});

		/* Sacola */
		const lineTemplate = (line: Line) => {
			const { title, price } = info(line.id);
			const li = document.createElement('li');
			li.className = 'cart-line';
			li.dataset.id = line.id;
			li.innerHTML = `
				<div class="line-info">
					<span class="line-name"></span>
					<span class="line-unit"></span>
				</div>
				<div class="line-qty" role="group">
					<button type="button" class="step-btn" data-step="-1"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg></button>
					<span class="line-qty-value"></span>
					<button type="button" class="step-btn" data-step="1"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg></button>
				</div>
				<span class="line-price"></span>
				<button type="button" class="line-remove">Remover</button>`;
			li.querySelector('.line-name')!.textContent = title;
			li.querySelector('.line-unit')!.textContent = `${formatPrice(price)} cada`;
			li.querySelector('.line-qty')!.setAttribute('aria-label', `Quantidade de ${title}`);
			li.querySelector('.line-qty-value')!.textContent = String(line.qty);
			li.querySelector('.line-price')!.textContent = formatPrice(price * line.qty);
			const [minus, plus] = li.querySelectorAll<HTMLButtonElement>('.step-btn');
			minus.setAttribute('aria-label', `Tirar uma unidade de ${title}`);
			plus.setAttribute('aria-label', `Adicionar mais uma unidade de ${title}`);
			plus.disabled = line.qty >= limit(line.id);
			minus.addEventListener('click', () => {
				setQty(line.id, line.qty - 1, 'cart');
				focusLine(line.id, '[data-step="-1"]');
			});
			plus.addEventListener('click', () => {
				setQty(line.id, line.qty + 1, 'cart');
				focusLine(line.id, '[data-step="1"]');
			});
			const remove = li.querySelector<HTMLButtonElement>('.line-remove')!;
			remove.setAttribute('aria-label', `Remover ${title} da sacola`);
			remove.addEventListener('click', () => {
				setQty(line.id, 0, 'cart');
				focusLine(line.id, '.line-remove');
			});
			return li;
		};

		/** Mantém o foco no mesmo controle depois de redesenhar; se a linha sumiu, vai para o título. */
		const focusLine = (id: string, selector: string) => {
			const li = cartList.querySelector<HTMLElement>(`[data-id="${id}"]`);
			const target = li?.querySelector<HTMLButtonElement>(selector);
			if (target && !target.disabled) target.focus();
			else (li?.querySelector<HTMLButtonElement>('.line-remove') ?? $('#cart-heading')).focus();
		};

		/** Mensagem pronta pro WhatsApp da loja, no tom da marca e sem emoji. */
		function orderMessage(cents: number) {
			const lines = [...cart.values()].map((line) => {
				const { title, price } = info(line.id);
				const unit = line.qty > 1 ? ` (${formatPrice(price)} cada)` : '';
				return `${line.qty}x ${title}${unit} = ${formatPrice(price * line.qty)}`;
			});
			return [
				'Oi, Jokenpo! Quero fazer um pedido pra retirar na loja:',
				'',
				...lines,
				'',
				`Total: ${formatPrice(cents)}`,
				'',
				'Pode separar pra mim?',
			].join('\n');
		}

		function render() {
			const { items, cents } = totals();
			const empty = cart.size === 0;
			cartList.replaceChildren(...[...cart.values()].map(lineTemplate));
			cartEmpty.hidden = !empty;
			cartFoot.hidden = empty;
			$('[data-role="cart-count"]').textContent = empty ? '' : `(${items})`;
			$('[data-role="cart-total"]').textContent = formatPrice(cents);
			$('[data-role="cart-items"]').textContent = empty ? '' : plural(items, 'item', 'itens');
			$('[data-role="bar-count"]').textContent = String(items);
			$('[data-role="bar-total"]').textContent = formatPrice(cents);
			bar.setAttribute('aria-label', `Ver sacola: ${plural(items, 'item', 'itens')}, ${formatPrice(cents)}`);
			bar.hidden = empty;
			cards.forEach(syncCard);
			const text = orderMessage(cents);
			$('[data-role="message"]').textContent = text;
			$<HTMLAnchorElement>('[data-role="whatsapp-link"]').href =
				`https://wa.me/${root!.dataset.whatsapp}?text=${encodeURIComponent(text)}`;
		}

		/* Gaveta no celular, coluna fixa no desktop */
		let drawerOpen = false;
		const syncDrawer = () => {
			const isDrawer = drawerQuery.matches;
			const open = isDrawer && drawerOpen;
			cartEl.classList.toggle('is-open', open);
			cartEl.inert = isDrawer && !drawerOpen;
			backdrop.hidden = !open;
			bar.setAttribute('aria-expanded', String(open));
			document.documentElement.classList.toggle('cart-locked', open);
			if (open) {
				cartEl.setAttribute('role', 'dialog');
				cartEl.setAttribute('aria-modal', 'true');
			} else {
				cartEl.removeAttribute('role');
				cartEl.removeAttribute('aria-modal');
			}
		};
		const openDrawer = () => {
			drawerOpen = true;
			syncDrawer();
			$<HTMLButtonElement>('[data-role="cart-close"]').focus();
		};
		const closeDrawer = () => {
			if (!drawerOpen) return;
			drawerOpen = false;
			syncDrawer();
			if (!bar.hidden) bar.focus();
		};
		bar.addEventListener('click', openDrawer);
		backdrop.addEventListener('click', closeDrawer);
		$('[data-role="cart-close"]').addEventListener('click', closeDrawer);
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeDrawer();
		});
		drawerQuery.addEventListener('change', () => {
			drawerOpen = false;
			syncDrawer();
		});

		/* Filtro por categoria */
		const filterButtons = [...root.querySelectorAll<HTMLButtonElement>('.filter-btn')];
		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const filter = button.dataset.filter;
				filterButtons.forEach((b) => {
					b.classList.toggle('is-active', b === button);
					b.setAttribute('aria-pressed', String(b === button));
				});
				let visible = 0;
				root.querySelectorAll<HTMLElement>('.category').forEach((section) => {
					const show = filter === 'all' || section.dataset.category === filter;
					section.hidden = !show;
					if (show) visible += section.querySelectorAll('.product-card').length;
				});
				$('#filter-status').textContent = `Mostrando ${plural(visible, 'produto', 'produtos')}.`;
			});
		});

		const refreshStock = async () => {
			try {
				const response = await fetch('/api/pdv/estoque', { headers: { accept: 'application/json' } });
				if (!response.ok) return;
				const items = (await response.json()) as { produtoId: string; disponivel: number }[];
				items.forEach(({ produtoId, disponivel }) => {
					const card = cards.get(produtoId);
					if (card) card.dataset.stock = String(disponivel);
				});
				cart.forEach((line) => {
					const max = limit(line.id);
					if (max === 0) cart.delete(line.id);
					else if (line.qty > max) line.qty = max;
				});
				render();
				save();
			} catch {
				/* Mantém o estoque estático da página. */
			}
		};

		/* Envio pelo WhatsApp: a sacola fica até o cliente esvaziar, caso precise reenviar. */
		$('[data-role="whatsapp-link"]').addEventListener('click', () => {
			$('[data-role="cart-sent"]').hidden = false;
		});
		$('[data-role="cart-clear"]').addEventListener('click', () => {
			cart.clear();
			save();
			render();
			$('[data-role="cart-sent"]').hidden = true;
			announce.textContent = 'Sacola esvaziada.';
			$('#cart-heading').focus();
		});

		// Com o PDV simulado ligado, a vitrine mostra o estoque ao vivo.
		if (mode === 'mock') {
			const schedule = (cb: () => void) =>
				'requestIdleCallback' in window ? requestIdleCallback(cb) : setTimeout(cb, 300);
			schedule(() => void refreshStock());
		}

		restore();
		render();
		syncDrawer();
	}
</script>

