---
import siteData from '../data/site.json';
import ArrowIcon from '../components/ArrowIcon.astro';
import '../styles/fonts.css';
import '../styles/global.css';

export const prerender = true;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/Vetor/coelho.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<meta name="robots" content="noindex, follow" />
		<title>Página não encontrada — {siteData.name}</title>
	</head>
	<body>
		<main class="not-found">
			<div class="not-found-card">
				<p class="eyebrow">ERRO 404</p>
				<h1>ESSA PÁGINA<br /><span>SAIU DA MESA.</span></h1>
				<p class="not-found-lead">O endereço que você acessou não existe ou foi movido.</p>
				<a class="button button-yellow" href="/">
					<span>Voltar para a Jokenpo</span>
					<ArrowIcon direction="right" size={16} />
				</a>
			</div>
		</main>
	</body>
</html>

<style>
	.not-found {
		display: grid;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 1.5rem;
		place-items: center;
		background-color: var(--ink);
		background-image: radial-gradient(oklch(1 0 0 / 0.08) 2px, transparent 2.5px);
		background-size: 26px 26px;
	}

	.not-found-card {
		max-width: 44rem;
		padding: clamp(2rem, 5vw, 3.25rem);
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-feature);
		background: var(--ink-2);
		box-shadow: 10px 10px 0 var(--pink);
	}

	.not-found-card h1 {
		margin: 0.75rem 0 1.25rem;
		font-size: clamp(2.75rem, 8vw, 5.5rem);
	}

	.not-found-lead {
		margin-bottom: 2rem;
		color: var(--mist);
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.65;
	}
</style>
