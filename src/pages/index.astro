---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
import ArrowIcon from '../components/ArrowIcon.astro';

const categories = siteData.boardgameCategories;
const agenda = siteData.agenda;

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const canonicalUrl = siteUrl ? `${siteUrl}/` : '/';
const socialImageUrl = `${siteUrl}/Vetor/jokenpo-coelho-branco.svg`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'GameStore',
	name: siteData.name,
	description: siteData.description,
	url: canonicalUrl,
	image: socialImageUrl,
	telephone: siteData.contact.whatsapp,
	email: siteData.contact.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${siteData.location.street}, ${siteData.location.venue}`,
		addressLocality: 'Natal',
		addressRegion: 'RN',
		postalCode: siteData.location.postalCode,
		addressCountry: 'BR',
	},
	openingHoursSpecification: siteData.hours
		.filter((hours) => !hours.closed && hours.opens && hours.closes)
		.map((hours) => ({
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: hours.schemaDays,
			opens: hours.opens,
			closes: hours.closes,
		})),
	sameAs: [siteData.contact.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/Vetor/coelho.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<meta name="description" content={siteData.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="author" content="Jokenpo" />
		<meta name="theme-color" content="#0e0e10" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteData.name} />
		<meta property="og:title" content={siteData.title} />
		<meta property="og:description" content={siteData.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Jokenpo — card games, boardgames e torneios" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteData.title} />
		<meta name="twitter:description" content={siteData.description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Jokenpo — card games, boardgames e torneios" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link id="font-stylesheet" rel="preload" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Poppins:ital,wght@0,400;0,600;0,700;1,600;1,700&display=swap" as="style" />
		<script is:inline>
			document.getElementById('font-stylesheet')?.setAttribute('rel', 'stylesheet');
		</script>
		<noscript><link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Poppins:ital,wght@0,400;0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" /></noscript>
		<title>{siteData.title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<div class="site-shell">
			<div class="noise" aria-hidden="true"></div>
			<a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Jokenpô início">
					<Image class="brand-logo brand-logo-header" src="/Vetor/jokenpo-logo-letras-pretas.svg" alt="Jokenpô" width={150} height={33} />
				</a>
				<nav class="main-nav" aria-label="Navegação principal">
					<button class="menu-button" type="button" popovertarget="site-menu" popovertargetaction="toggle" aria-controls="site-menu">
						<span aria-hidden="true">☰</span>
						<span>Menu</span>
					</button>
					<ul id="site-menu" class="site-menu" popover="auto">
						<li><a href="#agenda">Agenda</a></li>
						<li><a href="#jogar">Jogue aqui</a></li>
						<li><a href="#visite">Visite</a></li>
					</ul>
				</nav>
				<a class="header-cta" href="#visite">Cola lá <ArrowIcon size={14} /></a>
			</header>

			<main id="main-content" tabindex="-1">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-bg-word" aria-hidden="true">PLAY</div>
					<div class="hero-copy">
						<p class="eyebrow"><span class="eyebrow-dot"></span> {siteData.hero.eyebrow}</p>
						<h1 id="hero-title">{siteData.hero.titleLine1}<br /><span>{siteData.hero.titleLine2}</span><br />{siteData.hero.titleLine3}</h1>
						<p class="hero-text">{siteData.hero.description}</p>
						<div class="hero-actions">
							<a class="button button-yellow" href="#agenda">Ver agenda <ArrowIcon direction="right" size={16} /></a>
							<a class="button button-outline" href="#visite">Como chegar <ArrowIcon size={16} /></a>
						</div>
					</div>
					<div class="hero-stage" aria-hidden="true">
						<div class="burst burst-one"><img src="/Vetor/brilho-rosa.svg" alt="" width="47" height="47" /></div>
						<div class="burst burst-two"><img src="/Vetor/brilho-preto.svg" alt="" width="32" height="32" /></div>
						<div class="card-back card-back-main">
							<div class="card-inner">
								<div class="card-symbol">✦</div>
								<strong>JOKENPÔ</strong>
								<small>JOGUE MAIS</small>
							</div>
						</div>
						<div class="mini-card">
							<div class="mini-card-suit">♠</div>
							<span>PLAY<br />YOUR<br />WAY</span>
						</div>
						<img class="hero-mascot" src="/Vetor/coelho-creme.svg" alt="" width="112" height="126" />
						<div class="die">20</div>
						<div class="sticker">BORA<br /><em>JOGAR?</em></div>
					</div>
					<div class="hero-note">SEG — SÁB<br />14H — 22H<span>LOJA 24 · NEW WAY CENTER</span></div>
					<div class="scroll-cue">
						<div class="scroll-cue-row">
							<span class="scroll-line"></span>
							<span class="scroll-label">DESÇA PRA JOGAR</span>
							<span class="scroll-line"></span>
						</div>
						<ArrowIcon direction="down" class="scroll-arrow" size={16} />
					</div>
				</section>

				<section class="marquee" aria-label="RPG, TCG, board games e torneios">
					<div class="marquee-track">
						<img src="/Vetor/faixa-categorias.svg" alt="RPG, TCG, board games e torneios" width="675" height="44" loading="lazy" />
						<img src="/Vetor/faixa-categorias.svg" alt="" width="675" height="44" loading="lazy" aria-hidden="true" />
					</div>
					<button class="marquee-toggle" type="button" aria-pressed="false">Pausar movimento</button>
				</section>

				<section class="section games-section" id="jogar" tabindex="-1" aria-labelledby="games-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow pink-text">JOGOS DE TABULEIRO</p>
							<h2 id="games-title">PASSE<br /><span>DA TARDE</span></h2>
						</div>
						<p class="heading-aside">Passe da Tarde: SEG · TER · QUA · SEX<br />14h às 18h · por pessoa</p>
					</div>
					<div class="category-grid">
						{categories.map((category, index) => (
							<a class={`category-card ${category.color}`} href="#agenda">
								<span class="category-number">0{index + 1}</span>
								<span class="category-icon">{category.icon}</span>
								<h3>{category.name}</h3>
								<p>{category.description}</p>
								<ArrowIcon class="category-arrow" size={24} />
							</a>
						))}
					</div>
				</section>

				<section class="section agenda-section" id="agenda" tabindex="-1" aria-labelledby="agenda-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow cyan-text">TODA SEMANA</p>
							<h2 id="agenda-title">A AGENDA<br /><span>DA GALERA</span></h2>
						</div>
						<p class="heading-aside">Inscrições no balcão<br />Capacidade máxima: 12 jogadores</p>
					</div>
					<div class="agenda-grid">
						{agenda.map((event) => (
							<article class={`agenda-card ${event.color}`}>
								<span class="agenda-day">{event.day}</span>
								<h3>{event.name}</h3>
								<p>{event.detail}</p>
								<ArrowIcon class="agenda-arrow" size={22} />
							</article>
						))}
					</div>
				</section>

				<section class="about-section" id="sobre" aria-labelledby="about-title">
					<div class="about-copy">
						<p class="eyebrow">CARD GAMES</p>
						<h2 id="about-title">TCG, MESA<br /><span>E COMUNIDADE</span></h2>
						<p>Temos produtos e cartas de Magic, Pokémon, Yu-Gi-Oh! e One Piece, além de espaço para sentar, jogar com calma e encontrar a sua turma.</p>
						<div class="tcg-list">
							<span>MAGIC</span><span>POKÉMON</span><span>YU-GI-OH!</span><span>ONE PIECE</span>
						</div>
						<a class="button button-pink" href="#agenda">Ver torneios <ArrowIcon direction="right" size={16} /></a>
					</div>
					<div class="about-note">
						<span class="quote-mark">“</span>
						<p>UM LUGAR PRA<br /><strong>JOGAR COM CALMA.</strong></p>
						<span class="quote-author">@jokenpoficial</span>
					</div>
				</section>

				<section class="section extras-section" aria-labelledby="extras-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow yellow-text">NO ESPAÇO DA LOJA</p>
							<h2 id="extras-title">FICA À VONTADE<br /><span>PARA VOLTAR</span></h2>
						</div>
						<p class="heading-aside">Um canto para a comunidade<br />jogar, reunir e comemorar</p>
					</div>
					<div class="extras-grid">
						{siteData.extras.map((extra) => (
							<article class={`extra-card extra-card-${extra.color}`}>
								<span>{extra.number}</span>
								<h3>{extra.title}</h3>
								<p set:html={extra.description}></p>
							</article>
						))}
					</div>
				</section>

				<section class="visit-section section" id="visite" tabindex="-1" aria-labelledby="visit-title">
					<div class="visit-content">
						<p class="eyebrow yellow-text">ONDE ESTAMOS</p>
						<h2 id="visit-title">COLA NA<br /><span>JOKENPO</span></h2>
						<div class="visit-details">
							<div><small>ONDE</small><strong>{siteData.location.venue}<br />{siteData.location.street}<br />{siteData.location.neighborhood}</strong></div>
							<div><small>QUANDO</small><strong>{siteData.hours.filter((hours) => !hours.closed).map((hours) => <span>{hours.day} · {hours.open}<br /></span>)}</strong></div>
						</div>
						<div class="visit-contact">
							<p><small>FALE COM A GALERA</small>Entre na comunidade para conversar sobre cada jogo e receber avisos gerais importantes.</p>
							<div class="visit-contact-links">
								<a href={siteData.contact.communityWhatsapp} target="_blank" rel="noreferrer">Comunidade no WhatsApp <ArrowIcon size={13} /></a>
							</div>
						</div>
						<a class="button button-yellow" href={siteData.location.mapsUrl} target="_blank" rel="noreferrer">Abrir no mapa <ArrowIcon size={16} /></a>
					</div>
					<div class="map-preview">
						<iframe
							title="Localização da Jokenpô no Shopping New Way Center"
							src={siteData.location.embedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
						<div class="map-label">LOJA 24<br /><strong>NEW WAY</strong></div>
					</div>
				</section>
			</main>

			<footer class="site-footer">
				<div class="footer-brand"><Image class="brand-logo brand-logo-header" src="/Vetor/jokenpo-logo-letras-pretas.svg" alt="Jokenpô" width={150} height={33} loading="lazy" /></div>
				<div class="footer-details">
					<p><strong>Jokenpo</strong> · Feito para quem gosta de jogar</p>
					<p>{siteData.location.venue}<br />{siteData.location.street}<br />{siteData.location.neighborhood}</p>
					<p><a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email}</a>{siteData.contact.cnpj && <><br />CNPJ: {siteData.contact.cnpj}</>}</p>
					<p>© 2026 Jokenpo</p>
				</div>
				<div class="footer-links">
					<a href={siteData.contact.communityWhatsapp} target="_blank" rel="noreferrer">WhatsApp</a>
					<a href={siteData.contact.instagram} target="_blank" rel="noreferrer">Instagram</a>
					<a href={`mailto:${siteData.contact.email}`}>E-mail</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<script>
	const marquee = document.querySelector('.marquee');
	const marqueeToggle = document.querySelector('.marquee-toggle');
	const siteHeader = document.querySelector('.site-header');
	const siteNav = document.querySelector('.main-nav');
	const siteMenu = document.querySelector('.site-menu');
	const menuButton = document.querySelector('.menu-button');
	const navLinks = [...document.querySelectorAll('.site-menu a[href^="#"]')];

	if (marquee instanceof HTMLElement && marqueeToggle instanceof HTMLButtonElement) {
		marqueeToggle.addEventListener('click', () => {
			const isPaused = marquee.classList.toggle('is-paused');
			marqueeToggle.setAttribute('aria-pressed', String(isPaused));
			marqueeToggle.textContent = isPaused ? 'Retomar movimento' : 'Pausar movimento';
		});
	}

	if (
		siteHeader instanceof HTMLElement &&
		siteNav instanceof HTMLElement &&
		siteMenu instanceof HTMLUListElement &&
		menuButton instanceof HTMLButtonElement
	) {
		const supportsPopover = 'popover' in HTMLElement.prototype;

		const updateNavigationLayout = () => {
			siteHeader.classList.add('is-measuring');
			siteHeader.classList.add('is-wide');
			siteMenu.removeAttribute('popover');
			const fits = siteHeader.scrollWidth <= siteHeader.clientWidth;

			if (fits) {
				siteHeader.classList.add('is-wide');
				siteMenu.removeAttribute('popover');
				menuButton.hidden = true;
			} else {
				siteHeader.classList.remove('is-wide');
				menuButton.hidden = false;
				if (supportsPopover) {
					siteMenu.setAttribute('popover', 'auto');
				}
			}

			siteHeader.classList.remove('is-measuring');
		};

		if (!supportsPopover) {
			siteMenu.hidden = true;
			menuButton.addEventListener('click', () => {
				const isOpen = !siteMenu.hidden;
				siteMenu.hidden = isOpen;
				menuButton.setAttribute('aria-expanded', String(!isOpen));
			});
		}

		updateNavigationLayout();
		new ResizeObserver(updateNavigationLayout).observe(siteHeader);
		document.fonts?.ready.then(updateNavigationLayout);
	}

	if (navLinks.length > 0) {
		const setCurrentLink = (currentLink: Element | null | undefined) => {
			navLinks.forEach((link) => {
				const isCurrent = link === currentLink;
				link.classList.toggle('target-current', isCurrent);
				if (isCurrent) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		if (CSS.supports('scroll-target-group: auto')) {
			const syncCurrentLink = () => {
				setCurrentLink(document.querySelector('.site-menu a:target-current'));
			};

			const currentMenu = document.querySelector('.site-menu');
			if (currentMenu instanceof HTMLUListElement) {
				currentMenu.style.setProperty('scroll-target-group', 'auto');
			}
			syncCurrentLink();
			document.addEventListener('scrollend', syncCurrentLink, { passive: true });
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					const visibleSection = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					const currentId = visibleSection?.target.id;
					setCurrentLink(navLinks.find((link) => link.getAttribute('href') === `#${currentId}`));
				},
				{ rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
			);

			navLinks
				.map((link) => {
					const href = link.getAttribute('href');
					return href ? document.querySelector(href) : null;
				})
				.filter((section): section is Element => section instanceof Element)
				.forEach((section) => observer.observe(section));
		}
	}
</script>

<style>
	:root {
		color-scheme: dark;
		--ink: #0e0e10;
		--ink-2: #1c1c21;
		--ink-3: #3a3a42;
		--mist: #cfcdd4;
		--white: #fff;
		--yellow: #ffd400;
		--cyan: #00c8ff;
		--pink: #ff3ea5;
		--purple: #2a1e5c;
	}

	* { box-sizing: border-box; }
	html {
		@media (prefers-reduced-motion: no-preference) {
			scroll-behavior: smooth;
		}
	}
	body { margin: 0; background: var(--ink); color: var(--white); font-family: 'Poppins', sans-serif; font-size-adjust: from-font; line-height: 1.5; }
	a { color: inherit; text-decoration: none; }
	:where(a, button):focus-visible {
		outline: 3px solid var(--yellow);
		outline-offset: 4px;
	}
	.skip-link {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 30;
		padding: 10px 14px;
		background: var(--yellow);
		color: var(--ink);
		font-size: 13px;
		font-weight: 700;
		transform: translateY(-150%);
	}
	.skip-link:focus-visible { transform: translateY(0); }
	:global(.arrow-icon) { display: inline-block; width: .6em; height: .6em; flex: none; vertical-align: middle; }
	.site-shell { min-height: 100vh; overflow: hidden; background: var(--ink); }
	.noise { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .07; mix-blend-mode: screen; }
	.noise::before { content: ''; position: absolute; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); }
	.site-header { position: absolute; z-index: 10; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; max-width: 1260px; margin: auto; padding: 28px 42px; }
	.site-header > * { flex-shrink: 0; white-space: nowrap; }
	.site-header.is-measuring > * { transition: none !important; }
	.brand, .footer-brand { display: flex; align-items: center; }
	.brand-logo { display: block; width: 150px; height: auto; }
	.brand-logo-header { filter: invert(1); }
	.main-nav { display: flex; align-items: center; color: var(--mist); font-size: .8125rem; font-weight: 700; }
	.menu-button {
		display: inline-flex;
		min-block-size: 44px;
		align-items: center;
		gap: 8px;
		padding: 9px 13px;
		border: 2px solid var(--white);
		border-radius: 999px;
		background: transparent;
		color: var(--white);
		font: inherit;
		cursor: pointer;
	}
	.menu-button span:first-child { color: var(--yellow); font-size: 1.1em; line-height: 1; }
	.site-menu {
		position: fixed;
		inset: 76px 24px auto auto;
		inline-size: min(80dvw, 24rem);
		max-inline-size: calc(100dvw - 2rem);
		max-block-size: calc(100dvh - 6rem);
		margin: 0;
		padding: 12px;
		overflow: auto;
		border: 1px solid var(--ink-3);
		border-radius: 18px;
		background: var(--ink-2);
		box-shadow: 8px 8px 0 var(--pink);
		list-style: none;
		scroll-target-group: auto;
	}
	.site-menu li + li { margin-top: 4px; }
	.site-menu a {
		display: block;
		min-block-size: 44px;
		padding: 12px 14px;
		border-radius: 10px;
		color: var(--mist);
	}
	.site-menu a:hover, .site-menu a:focus-visible, .text-link:hover, .site-footer a:hover { color: var(--yellow); }
	.site-menu a.target-current {
		background: var(--yellow);
		color: var(--ink);
		font-weight: 700;
	}
	.site-header.is-wide .menu-button { display: none; }
	.site-header.is-wide .site-menu {
		position: static;
		display: flex;
		align-items: center;
		gap: 36px;
		inline-size: auto;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		overflow: visible;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}
	.site-header.is-wide .site-menu li + li { margin-top: 0; }
	.site-header.is-wide .site-menu a { min-block-size: 24px; padding: 0; border-radius: 0; }
	.site-header.is-wide .site-menu a.target-current {
		background: transparent;
		color: var(--yellow);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
	.header-cta { padding: 11px 18px; border: 2px solid var(--white); border-radius: 30px; font-size: 12px; font-weight: 700; }
	:global(.header-cta .arrow-icon) { width: 11px; height: 11px; margin-left: 8px; color: var(--yellow); }
	.hero { position: relative; min-height: 760px; padding: 174px max(42px, calc((100% - 1176px) / 2)) 90px; overflow: hidden; background: radial-gradient(circle at 74% 40%, #4a3a99 0, var(--purple) 23%, var(--ink) 57%); }
	.hero::after { position: absolute; right: -9%; bottom: -34%; width: 60%; height: 80%; border: 2px solid #ffffff17; border-radius: 50%; content: ''; transform: rotate(-24deg); }
