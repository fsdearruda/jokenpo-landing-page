---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import GamesSection from '../components/GamesSection.astro';
import AgendaSection from '../components/AgendaSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ExtrasSection from '../components/ExtrasSection.astro';
import FaqSection from '../components/FaqSection.astro';
import VisitSection from '../components/VisitSection.astro';
import PromoBanners from '../components/PromoBanners.astro';
import { activeBanners } from '../lib/banners';

export const prerender = true;

const hasBanners = activeBanners('inicio').length > 0;
---

<BaseLayout>
	<Hero />
	<Marquee />
	{
		hasBanners && (
			<div class="home-banners">
				<PromoBanners placement="inicio" layout="feature" sizes="(min-width: 1176px) 1100px, 100vw" />
			</div>
		)
	}
	<HowItWorksSection />
	<GamesSection />
	<AgendaSection />
	<AboutSection />
	<ExtrasSection />
	<FaqSection />
	<VisitSection />
</BaseLayout>

<style>
	.home-banners {
		max-width: 1176px;
		margin-inline: auto;
		padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 2.625rem) 0;
	}

	.home-banners :global(.layout-feature > .promo-banner) {
		--max-h: 26rem;
		margin-inline: auto;
	}
</style>
