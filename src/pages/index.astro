---
import siteData from '../data/site.json';

const categories = siteData.boardgameCategories;
const agenda = siteData.agenda;

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const canonicalUrl = siteUrl ? `${siteUrl}/` : '/';
const socialImageUrl = `${siteUrl}/Vetor/jokenpo-coelho-branco.svg`;
const directWhatsappUrl = `https://wa.me/${siteData.contact.whatsapp.replace(/\D/g, '')}`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'GameStore',
	name: siteData.name,
	description: siteData.description,
	url: canonicalUrl,
	image: socialImageUrl,
	telephone: siteData.contact.whatsapp,
	email: siteData.contact.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${siteData.location.street}, ${siteData.location.venue}`,
		addressLocality: 'Natal',
		addressRegion: 'RN',
		postalCode: siteData.location.postalCode,
		addressCountry: 'BR',
	},
	openingHoursSpecification: siteData.hours
		.filter((hours) => !hours.closed && hours.opens && hours.closes)
		.map((hours) => ({
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: hours.schemaDays,
			opens: hours.opens,
			closes: hours.closes,
		})),
	sameAs: [siteData.contact.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/Vetor/coelho.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={siteData.description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="author" content="Jokenpo" />
		<meta name="theme-color" content="#0e0e10" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteData.name} />
		<meta property="og:title" content={siteData.title} />
		<meta property="og:description" content={siteData.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Jokenpo — card games, boardgames e torneios" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={siteData.title} />
		<meta name="twitter:description" content={siteData.description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Jokenpo — card games, boardgames e torneios" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Poppins:ital,wght@0,400;0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>{siteData.title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<div class="site-shell">
			<div class="noise" aria-hidden="true"></div>
			<header class="site-header">
				<a class="brand" href="/" aria-label="Jokenpô início">
					<img class="brand-logo" src="/Vetor/jokenpo-coelho-branco.svg" alt="Jokenpô" />
				</a>
				<nav class="main-nav" aria-label="Navegação principal">
					<a href="#agenda">Agenda</a>
					<a href="#jogar">Jogue aqui</a>
					<a href="#visite">Visite</a>
				</nav>
				<a class="header-cta" href="#visite">Cola lá <span>↗</span></a>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-bg-word" aria-hidden="true">PLAY</div>
					<div class="hero-copy">
						<p class="eyebrow"><span class="eyebrow-dot"></span> {siteData.hero.eyebrow}</p>
						<h1 id="hero-title">{siteData.hero.titleLine1}<br /><span>{siteData.hero.titleLine2}</span><br />{siteData.hero.titleLine3}</h1>
						<p class="hero-text">{siteData.hero.description}</p>
						<div class="hero-actions">
							<a class="button button-yellow" href="#agenda">Ver agenda <span>→</span></a>
							<a class="button button-outline" href="#visite">Como chegar <span>↗</span></a>
						</div>
					</div>
					<div class="hero-stage" aria-label="Composição ilustrada com cartas e dados">
						<div class="burst burst-one">✦</div>
						<div class="burst burst-two">✦</div>
						<div class="card-back card-back-main">
							<div class="card-inner">
								<div class="card-symbol">✦</div>
								<strong>JOKENPÔ</strong>
								<small>JOGUE MAIS</small>
							</div>
						</div>
						<div class="mini-card">
							<div class="mini-card-suit">♠</div>
							<span>PLAY<br />YOUR<br />WAY</span>
						</div>
						<img class="hero-mascot" src="/Vetor/coelho.svg" alt="" />
						<div class="die">20</div>
						<div class="sticker">BORA<br /><em>JOGAR?</em></div>
					</div>
					<div class="hero-note">SEG — SÁB<br />14H — 22H<span>LOJA 24 · NEW WAY CENTER</span></div>
					<div class="scroll-cue"><span></span> DESÇA PARA JOGAR</div>
				</section>

				<section class="marquee" aria-label="Mensagem da marca">
					<div>CARD GAMES · BOARDGAMES · TORNEIOS TODA SEMANA <span>✦</span> CARD GAMES · BOARDGAMES · TORNEIOS TODA SEMANA <span>✦</span></div>
				</section>

				<section class="section games-section" id="jogar" aria-labelledby="games-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow pink-text">JOGOS DE TABULEIRO</p>
							<h2 id="games-title">PASSE<br /><span>DA TARDE</span></h2>
						</div>
						<p class="heading-aside">Passe da Tarde: SEG · TER · QUA · SEX<br />14h às 18h · por pessoa</p>
					</div>
					<div class="category-grid">
						{categories.map((category, index) => (
							<a class={`category-card ${category.color}`} href="#agenda">
								<span class="category-number">0{index + 1}</span>
								<span class="category-icon">{category.icon}</span>
								<h3>{category.name}</h3>
								<p>{category.description}</p>
								<span class="category-arrow">↗</span>
							</a>
						))}
					</div>
				</section>

				<section class="section agenda-section" id="agenda" aria-labelledby="agenda-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow cyan-text">TODA SEMANA</p>
							<h2 id="agenda-title">A AGENDA<br /><span>DA GALERA</span></h2>
						</div>
						<p class="heading-aside">Inscrições no balcão<br />Capacidade máxima: 12 jogadores</p>
					</div>
					<div class="agenda-grid">
						{agenda.map((event) => (
							<article class={`agenda-card ${event.color}`}>
								<span class="agenda-day">{event.day}</span>
								<h3>{event.name}</h3>
								<p>{event.detail}</p>
								<span class="agenda-arrow">↗</span>
							</article>
						))}
					</div>
				</section>

				<section class="about-section" id="sobre" aria-labelledby="about-title">
					<div class="about-shape" aria-hidden="true"></div>
					<div class="about-copy">
						<p class="eyebrow">CARD GAMES</p>
						<h2 id="about-title">TCG, MESA<br /><span>E COMUNIDADE</span></h2>
						<p>Temos produtos e cartas de Magic, Pokémon, Yu-Gi-Oh! e One Piece, além de espaço para sentar, jogar com calma e encontrar a sua turma.</p>
						<div class="tcg-list">
							<span>MAGIC</span><span>POKÉMON</span><span>YU-GI-OH!</span><span>ONE PIECE</span>
						</div>
						<a class="button button-pink" href="#agenda">Ver torneios <span>→</span></a>
					</div>
					<div class="about-note">
						<span class="quote-mark">“</span>
						<p>UM LUGAR PRA<br /><strong>JOGAR COM CALMA.</strong></p>
						<span class="quote-author">@jokenpoficial</span>
					</div>
				</section>

				<section class="section extras-section" aria-labelledby="extras-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow yellow-text">NO ESPAÇO DA LOJA</p>
							<h2 id="extras-title">FICA À VONTADE<br /><span>PARA VOLTAR</span></h2>
						</div>
						<p class="heading-aside">Um canto para a comunidade<br />jogar, reunir e comemorar</p>
					</div>
					<div class="extras-grid">
						{siteData.extras.map((extra) => (
							<article class={`extra-card extra-card-${extra.color}`}>
								<span>{extra.number}</span>
								<h3>{extra.title}</h3>
								<p set:html={extra.description}></p>
							</article>
						))}
					</div>
				</section>

				<section class="visit-section section" id="visite" aria-labelledby="visit-title">
					<div class="visit-content">
						<p class="eyebrow yellow-text">ONDE ESTAMOS</p>
						<h2 id="visit-title">COLA NA<br /><span>JOKENPO</span></h2>
						<div class="visit-details">
							<div><small>ONDE</small><strong>{siteData.location.venue}<br />{siteData.location.street}<br />{siteData.location.neighborhood}</strong></div>
							<div><small>QUANDO</small><strong>{siteData.hours.filter((hours) => !hours.closed).map((hours) => <span>{hours.day} · {hours.open}<br /></span>)}</strong></div>
						</div>
						<div class="visit-contact">
							<p><small>FALE COM A GALERA</small>Entre na comunidade para conversar sobre cada jogo e receber avisos gerais importantes.</p>
							<div class="visit-contact-links">
								<a href={siteData.contact.communityWhatsapp} target="_blank" rel="noreferrer">Comunidade no WhatsApp <span>↗</span></a>
								<a href={directWhatsappUrl} target="_blank" rel="noreferrer">Contato direto: {siteData.contact.whatsapp} <span>↗</span></a>
								<a href={`mailto:${siteData.contact.email}`}>{siteData.contact.email} <span>↗</span></a>
							</div>
						</div>
						<a class="button button-yellow" href={siteData.location.mapsUrl} target="_blank" rel="noreferrer">Abrir no mapa <span>↗</span></a>
					</div>
					<div class="map-preview">
						<iframe
							title="Localização da Jokenpô no Shopping New Way Center"
							src={siteData.location.embedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
						<div class="map-label">LOJA 24<br /><strong>NEW WAY</strong></div>
					</div>
				</section>
			</main>

			<footer class="site-footer">
				<div class="footer-brand"><img class="brand-logo" src="/Vetor/jokenpo-coelho-branco.svg" alt="Jokenpô" /></div>
				<p>© 2026 Jokenpo · Feito para quem gosta de jogar</p>
				<div class="footer-links">
					<a href={siteData.contact.instagram} target="_blank" rel="noreferrer">@jokenpoficial ↗</a>
					<a href={siteData.contact.communityWhatsapp} target="_blank" rel="noreferrer">WhatsApp ↗</a>
					<a href={`mailto:${siteData.contact.email}`}>E-mail ↗</a>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--ink: #0e0e10;
		--ink-2: #1c1c21;
		--ink-3: #3a3a42;
		--mist: #cfcdd4;
		--white: #fff;
		--yellow: #ffd400;
		--cyan: #00c8ff;
		--pink: #ff3ea5;
		--purple: #2a1e5c;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; background: var(--ink); color: var(--white); font-family: 'Poppins', sans-serif; }
	a { color: inherit; text-decoration: none; }
	.site-shell { min-height: 100vh; overflow: hidden; background: var(--ink); }
	.noise { position: fixed; inset: 0; z-index: 20; pointer-events: none; opacity: .07; mix-blend-mode: screen; }
	.noise::before { content: ''; position: absolute; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); }
	.site-header { position: absolute; z-index: 10; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; max-width: 1260px; margin: auto; padding: 28px 42px; }
	.brand, .footer-brand { display: flex; align-items: center; }
	.brand-logo { display: block; width: 150px; height: auto; }
	.main-nav { display: flex; gap: 36px; color: var(--mist); font-size: 13px; font-weight: 700; }
	.main-nav a:hover, .text-link:hover, .site-footer a:hover { color: var(--yellow); }
	.header-cta { padding: 11px 18px; border: 2px solid var(--white); border-radius: 30px; font-size: 12px; font-weight: 700; }
	.header-cta span { margin-left: 8px; color: var(--yellow); font-size: 16px; }
	.hero { position: relative; min-height: 760px; padding: 174px max(42px, calc((100% - 1176px) / 2)) 90px; overflow: hidden; background: radial-gradient(circle at 74% 40%, #4a3a99 0, var(--purple) 23%, var(--ink) 57%); }
	.hero::after { position: absolute; right: -9%; bottom: -34%; width: 60%; height: 80%; border: 2px solid #ffffff17; border-radius: 50%; content: ''; transform: rotate(-24deg); }
	.hero-bg-word { position: absolute; top: 130px; right: -46px; color: transparent; font-family: 'Archivo Black', sans-serif; font-size: clamp(150px, 22vw, 290px); line-height: .8; opacity: .15; -webkit-text-stroke: 2px var(--white); transform: rotate(-8deg); }
	.hero-copy { position: relative; z-index: 2; max-width: 550px; }
	.eyebrow { margin: 0 0 22px; color: var(--cyan); font-size: 12px; font-weight: 700; letter-spacing: 3px; }
	.eyebrow-dot { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--pink); }
	h1, h2, h3, p { margin-top: 0; }
	h1, h2 { font-family: 'Archivo Black', sans-serif; letter-spacing: -3px; line-height: .91; }
	h1 { margin-bottom: 26px; font-size: clamp(65px, 9.5vw, 132px); }
	h1 span, h2 span { color: var(--pink); }
	.hero-text { margin-bottom: 30px; color: var(--mist); font-size: 17px; font-weight: 600; line-height: 1.65; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
	.button { display: inline-flex; align-items: center; gap: 25px; padding: 16px 21px 16px 24px; border-radius: 24px; color: var(--ink); font-size: 13px; font-weight: 700; transition: transform .2s, box-shadow .2s; }
	.button:hover { box-shadow: 7px 7px 0 var(--ink); transform: translate(-2px, -2px); }
	.button span { font-size: 20px; line-height: .5; }
	.button-yellow { background: var(--yellow); }
	.button-pink { background: var(--pink); }
	.button-outline { border: 2px solid var(--white); color: var(--white); }
	.hero-stage { position: absolute; z-index: 1; top: 150px; right: max(42px, calc((100% - 1160px) / 2)); width: min(45vw, 540px); height: 515px; }
	.card-back { position: absolute; border: 10px solid var(--white); border-radius: 22px; background: var(--ink); box-shadow: 24px 28px 40px #00000055; }
	.card-back-main { top: 42px; right: 65px; width: 270px; height: 390px; padding: 12px; transform: rotate(9deg); }
	.card-inner { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; border: 3px solid var(--pink); border-radius: 11px; background: repeating-linear-gradient(135deg, #ff3ea51c 0 13px, transparent 13px 28px); }
	.card-symbol { display: grid; width: 95px; height: 95px; place-items: center; margin-bottom: 22px; border: 3px solid var(--yellow); border-radius: 50%; color: var(--yellow); font-size: 54px; }
	.card-inner strong { font-family: 'Archivo Black', sans-serif; font-size: 25px; }
	.card-inner small { margin-top: 5px; color: var(--cyan); font-size: 10px; font-weight: 700; letter-spacing: 3px; }
	.mini-card { position: absolute; top: 148px; left: 40px; width: 148px; height: 214px; padding: 14px; border: 7px solid var(--white); border-radius: 14px; background: var(--cyan); color: var(--ink); box-shadow: 14px 18px 25px #00000040; transform: rotate(-13deg); }
	.mini-card-suit { margin-bottom: 18px; color: var(--pink); font-size: 38px; line-height: 1; }
	.mini-card span { font-family: 'Archivo Black', sans-serif; font-size: 17px; line-height: .9; }
	.die { position: absolute; right: 8px; bottom: 32px; display: grid; width: 80px; height: 80px; place-items: center; border: 5px solid var(--ink); border-radius: 18px; background: var(--yellow); box-shadow: 8px 8px 0 var(--ink); color: var(--ink); font-family: 'Archivo Black', sans-serif; font-size: 28px; transform: rotate(16deg); }
	.hero-mascot { position: absolute; right: 75px; bottom: 25px; width: 98px; height: auto; filter: invert(1) drop-shadow(4px 5px 0 var(--ink)); transform: rotate(8deg); }
	.sticker { position: absolute; bottom: 12px; left: 65px; padding: 18px 22px; background: var(--pink); color: var(--ink); font-family: 'Archivo Black', sans-serif; font-size: 17px; line-height: .9; text-align: center; transform: rotate(-9deg); filter: drop-shadow(4px 0 0 var(--ink)) drop-shadow(-4px 0 0 var(--ink)) drop-shadow(0 4px 0 var(--ink)) drop-shadow(0 -4px 0 var(--ink)); }
	.sticker em { color: var(--white); font-style: normal; }
	.burst { position: absolute; color: var(--yellow); font-size: 47px; }
	.burst-one { top: 20px; right: 5px; }
	.burst-two { bottom: 100px; left: -20px; color: var(--cyan); font-size: 32px; }
	.hero-note { position: absolute; right: max(42px, calc((100% - 1176px) / 2)); bottom: 52px; z-index: 3; color: var(--yellow); font-family: 'Archivo Black', sans-serif; font-size: 18px; line-height: .9; text-align: right; transform: rotate(-4deg); }
	.hero-note span { display: block; margin-top: 9px; color: var(--white); font-family: 'Poppins', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 2px; }
	.scroll-cue { position: absolute; bottom: 52px; left: max(42px, calc((100% - 1176px) / 2)); color: var(--mist); font-size: 9px; font-weight: 700; letter-spacing: 2px; }
	.scroll-cue span { display: inline-block; width: 28px; height: 1px; margin-right: 10px; vertical-align: middle; background: var(--mist); }
	.marquee { overflow: hidden; padding: 15px 0; background: var(--yellow); color: var(--ink); font-family: 'Archivo Black', sans-serif; font-size: 17px; white-space: nowrap; transform: rotate(-1.5deg) scale(1.03); }
	.marquee div { animation: slide 24s linear infinite; }
	.marquee span { margin: 0 22px; color: var(--pink); }
	@keyframes slide { to { transform: translateX(-50%); } }
	.section { max-width: 1176px; margin: auto; padding: 130px 42px; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 50px; }
	.section-heading .eyebrow { margin-bottom: 18px; }
	h2 { margin-bottom: 0; font-size: clamp(48px, 6vw, 78px); }
	.heading-aside { margin: 0 0 4px; color: var(--mist); font-size: 14px; font-weight: 600; line-height: 1.6; text-align: right; }
	.pink-text { color: var(--pink); }
	.cyan-text { color: var(--cyan); }
	.yellow-text { color: var(--yellow); }
	.category-grid, .product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
	.category-card { position: relative; min-height: 270px; padding: 27px; border-radius: 29px; color: var(--ink); transition: transform .2s; }
	.category-card:hover { transform: translateY(-8px) rotate(-1deg); }
	.category-card.cyan { background: var(--cyan); }
	.category-card.yellow { background: var(--yellow); }
	.category-card.pink { background: var(--pink); }
	.category-number { position: absolute; top: 24px; right: 27px; font-size: 12px; font-weight: 700; }
	.category-icon { display: block; margin-bottom: 55px; font-size: 43px; }
	.category-card h3 { margin-bottom: 8px; font-family: 'Archivo Black', sans-serif; font-size: 33px; letter-spacing: -1px; }
	.category-card p { margin-bottom: 0; max-width: 180px; font-size: 13px; font-weight: 600; line-height: 1.4; }
	.category-arrow { position: absolute; right: 27px; bottom: 24px; font-size: 28px; }
	.featured-section { padding-top: 60px; }
	.text-link { margin-bottom: 7px; color: var(--yellow); font-size: 13px; font-weight: 700; }
	.text-link span { margin-left: 12px; font-size: 18px; }
	.product-card { overflow: hidden; border-radius: 22px; background: var(--ink-2); box-shadow: 0 20px 30px #00000020; }
	.product-art { position: relative; height: 285px; overflow: hidden; color: var(--ink); }
	.product-art.cat { background: var(--yellow); }
	.product-art.dobble { background: var(--cyan); }
	.product-art.dixit { background: var(--pink); }
	.product-art::before { position: absolute; inset: 24px; border: 2px solid #0e0e1044; border-radius: 50%; content: ''; transform: rotate(22deg) scaleX(.7); }
	.product-art-shape { position: absolute; right: 25px; bottom: 20px; width: 130px; height: 130px; border: 12px solid var(--ink); border-radius: 42% 58% 53% 47%; background: var(--pink); transform: rotate(15deg); }
	.dobble .product-art-shape { border-radius: 50%; background: var(--yellow); box-shadow: -55px -45px 0 -18px var(--pink), 52px -25px 0 -27px var(--white); }
	.dixit .product-art-shape { border-radius: 55% 45% 45% 55%; background: var(--cyan); transform: rotate(-14deg); }
	.product-stamp { position: absolute; top: 23px; left: 23px; padding: 7px 10px; border: 2px solid var(--ink); border-radius: 16px; font-size: 9px; font-weight: 700; }
	.product-art-title { position: absolute; z-index: 1; left: 24px; bottom: 25px; font-family: 'Archivo Black', sans-serif; font-size: 28px; line-height: .86; letter-spacing: -1px; }
	.dobble .product-art-title, .dixit .product-art-title { font-size: 43px; }
