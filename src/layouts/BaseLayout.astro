---
import siteData from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import archivoBlackLatinWoff2 from '@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url';
import poppinsSemiBoldLatinWoff2 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppinsBoldLatinWoff2 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	robots?: string;
}

const {
	title = siteData.title,
	description = siteData.description,
	robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '') ?? 'https://jokenpo.cards';
const canonicalUrl = siteUrl ? `${siteUrl}/` : '/';
const socialImageUrl = `${siteUrl}/og-image.png`;
const storeId = `${siteUrl}/#store`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${siteUrl}/#webpage`;
const faqId = `${siteUrl}/#faq`;

const parseTournamentPrice = (detail: string, name: string) => {
	const match = detail.match(/R\$\s*(\d+)/);
	if (match) return match[1];
	if (/free\s*play/i.test(name)) return '0';
	return undefined;
};

const parseEventCapacity = (detail: string): number | undefined => {
	const match = detail.match(/(\d+)\s*vagas/i);
	return match ? Number(match[1]) : undefined;
};

const inferSchemaDays = (dayText: string, explicitDays?: string[]): string[] => {
	if (explicitDays && explicitDays.length > 0) return explicitDays;
	const normalized = dayText
		.toUpperCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '');

	if (normalized.includes('SEG') && normalized.includes('SAB')) {
		return ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
	}
	if (normalized.includes('SEG') && normalized.includes('SEX')) {
		return ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'];
	}

	const map: Array<[string, string]> = [
		['SEG', 'Monday'],
		['TER', 'Tuesday'],
		['QUA', 'Wednesday'],
		['QUI', 'Thursday'],
		['SEX', 'Friday'],
		['SAB', 'Saturday'],
		['DOM', 'Sunday'],
	];

	const matched = map.filter(([abbr]) => normalized.includes(abbr)).map(([, schemaDay]) => schemaDay);
	return matched.length > 0 ? matched : ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
};

const dayIndexMap: Record<string, number> = {
	Sunday: 0,
	Monday: 1,
	Tuesday: 2,
	Wednesday: 3,
	Thursday: 4,
	Friday: 5,
	Saturday: 6,
};

const computeEventWindow = (dayText: string, detail: string) => {
	const schemaDay = inferSchemaDays(dayText)[0] ?? 'Monday';
	const targetDow = dayIndexMap[schemaDay] ?? 1;
	const now = new Date();
	const currentDow = now.getUTCDay();
	const daysAhead = (targetDow - currentDow + 7) % 7;
	const eventDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysAhead));
	const yyyyMmDd = eventDate.toISOString().slice(0, 10);

	const timeMatch = detail.match(/(\d{1,2})h(\d{2})?/i);
	const startHour = timeMatch ? timeMatch[1].padStart(2, '0') : '14';
	const startMin = timeMatch && timeMatch[2] ? timeMatch[2] : '00';
	const startTime = `${startHour}:${startMin}:00`;
	const endTime = '22:00:00';

	return {
		schemaDay: `https://schema.org/${schemaDay}`,
		startTime,
		endTime,
		startDate: `${yyyyMmDd}T${startTime}-03:00`,
		endDate: `${yyyyMmDd}T${endTime}-03:00`,
	};
};

const storePostalAddress = {
	'@type': 'PostalAddress',
	streetAddress: `${siteData.location.street}, ${siteData.location.venue}`,
	addressLocality: 'Natal',
	addressRegion: 'RN',
	postalCode: siteData.location.postalCode,
	addressCountry: 'BR',
};

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: canonicalUrl,
			name: siteData.name,
			description: siteData.description,
			inLanguage: 'pt-BR',
			publisher: { '@id': storeId },
		},
		{
			'@type': 'WebPage',
			'@id': webpageId,
			url: canonicalUrl,
			name: title,
			description,
			inLanguage: 'pt-BR',
			isPartOf: { '@id': websiteId },
			about: { '@id': storeId },
			mainEntity: { '@id': storeId },
			primaryImageOfPage: {
				'@type': 'ImageObject',
				url: socialImageUrl,
				width: 1200,
				height: 630,
			},
		},
		{
			'@type': ['GameStore', 'LocalBusiness'],
			'@id': storeId,
			name: siteData.name,
			description: siteData.description,
			url: canonicalUrl,
			image: socialImageUrl,
			logo: `${siteUrl}/Vetor/coelho.svg`,
			telephone: siteData.contact.whatsapp,
			email: siteData.contact.email,
			...(siteData.contact.cnpj ? { taxID: siteData.contact.cnpj } : {}),
			priceRange: '$$',
			currenciesAccepted: 'BRL',
			paymentAccepted: 'Pix, Cartão de Crédito, Cartão de Débito, Dinheiro',
			hasMap: siteData.location.mapsUrl,
			address: storePostalAddress,
			geo: {
				'@type': 'GeoCoordinates',
				latitude: -5.7483,
				longitude: -35.2536,
			},
			areaServed: {
				'@type': 'City',
				name: 'Natal',
				containedInPlace: {
					'@type': 'State',
					name: 'Rio Grande do Norte',
				},
			},
			openingHoursSpecification: siteData.hours
				.filter((hours) => !hours.closed && hours.opens && hours.closes)
				.map((hours) => ({
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: inferSchemaDays(hours.day, hours.schemaDays),
					opens: hours.opens,
					closes: hours.closes,
				})),
			event: siteData.agenda.map((item) => {
				const price = parseTournamentPrice(item.detail, item.name);
				const capacity = parseEventCapacity(item.detail);
				const schedule = computeEventWindow(item.day, item.detail);
				return {
					'@type': 'Event',
					name: `${item.name} — Jokenpo`,
					description: `${item.day}: ${item.name} (${item.detail}) na Jokenpo em Natal/RN.`,
					startDate: schedule.startDate,
					endDate: schedule.endDate,
					eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
					eventStatus: 'https://schema.org/EventScheduled',
					eventSchedule: {
						'@type': 'Schedule',
						repeatFrequency: 'P1W',
						byDay: schedule.schemaDay,
						startTime: schedule.startTime,
						endTime: schedule.endTime,
						scheduleTimezone: 'America/Fortaleza',
					},
					organizer: { '@id': storeId },
					performer: { '@id': storeId },
					...(capacity ? { maximumAttendeeCapacity: capacity } : {}),
					location: {
						'@type': 'Place',
						name: `${siteData.name} — ${siteData.location.venue}`,
						address: storePostalAddress,
					},
					...(price !== undefined
						? {
								offers: {
									'@type': 'Offer',
									price,
									priceCurrency: 'BRL',
									url: `${canonicalUrl}#agenda`,
									availability: 'https://schema.org/InStock',
								},
							}
						: {}),
				};
			}),
			sameAs: [siteData.contact.instagram, siteData.contact.communityWhatsapp],
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			isPartOf: { '@id': webpageId },
			mainEntity: siteData.faq.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
	],
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/Vetor/coelho.svg" />
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href={archivoBlackLatinWoff2}
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href={poppinsSemiBoldLatinWoff2}
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href={poppinsBoldLatinWoff2}
			crossorigin="anonymous"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content="Jokenpo" />
		<meta name="theme-color" content="#0e0e10" />
		<meta name="geo.region" content="BR-RN" />
		<meta name="geo.placename" content="Natal" />
		<meta name="geo.position" content="-5.7483;-35.2536" />
		<meta name="ICBM" content="-5.7483, -35.2536" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link
			rel="alternate"
			type="text/plain"
			href="/llms.txt"
			title="Resumo estruturado da Jokenpo para assistentes de IA"
		/>
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteData.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content="Jokenpo — card games, boardgames e torneios em Natal" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Jokenpo — card games, boardgames e torneios em Natal" />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
		<div class="site-shell">
			<div class="noise" aria-hidden="true"></div>
			<a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
			<Header />
			<main id="main-content" tabindex="-1">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 40;
		padding: 0.625rem 1rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-pill);
		background: var(--yellow);
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 700;
		box-shadow: 4px 4px 0 var(--pink);
		transform: translateY(-180%);
		transition: transform var(--duration-fast) var(--ease-out);
	}
	.skip-link:focus-visible {
		transform: translateY(0);
	}
	.site-shell {
		min-height: 100vh;
		min-height: 100dvh;
		overflow: hidden;
		background: var(--ink);
	}
	.noise {
		position: fixed;
		inset: 0;
		z-index: 20;
		pointer-events: none;
		mix-blend-mode: overlay;
		opacity: 0.16;
	}
	.noise::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' width='180' height='180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' seed='1' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
		background-size: 180px 180px;
	}
</style>
