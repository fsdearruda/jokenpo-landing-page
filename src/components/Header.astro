---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
---

<header class="site-header">
	<div class="site-header-inner">
		<a class="brand" href="/" aria-label="Jokenpô início">
			<Image class="brand-logo brand-logo-header" src="/Vetor/jokenpo-logo-letras-pretas.svg" alt="Jokenpô" width={150} height={33} loading="eager" />
		</a>
		<nav class="main-nav" aria-label="Navegação principal">
			<button
				class="menu-button"
				id="menu-toggle-btn"
				type="button"
				aria-expanded="false"
				aria-controls="site-menu"
			>
				<span class="menu-icon" aria-hidden="true">
					<span class="icon-open">☰</span>
					<span class="icon-close">✕</span>
				</span>
				<span>Menu</span>
			</button>
			<ul id="site-menu" class="site-menu">
				<li><a href="#como-funciona">Como funciona</a></li>
				<li><a href="#jogar">Jogos</a></li>
				<li><a href="#agenda">Agenda</a></li>
				<li><a href="#duvidas">Dúvidas</a></li>
				<li><a href="#visite">Visite</a></li>
			</ul>
		</nav>
		<a class="header-cta" href="#visite">Cola lá <ArrowIcon size={14} /></a>
	</div>
</header>

<script>
	const siteHeader = document.querySelector<HTMLElement>('.site-header');
	const siteMenu = document.querySelector<HTMLUListElement>('#site-menu');
	const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle-btn');
	const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-menu a[href^="#"]')];

	if (siteHeader) {
		const updateScrolledState = () => {
			siteHeader.classList.toggle('is-scrolled', window.scrollY > 24);
		};
		updateScrolledState();
		window.addEventListener('scroll', updateScrolledState, { passive: true });
	}

	if (siteHeader && siteMenu && menuButton) {
		const setMenuOpen = (open: boolean) => {
			siteMenu.classList.toggle('is-open', open);
			menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
		};

		// Handle pointerdown on button so even rapid clicks or slight pointer movement
		// between spans never swallows the click event
		menuButton.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			event.preventDefault();
			const isOpen = siteMenu.classList.contains('is-open');
			setMenuOpen(!isOpen);
		});

		// Fallback for keyboard activation (Space / Enter) which fires 'click' with detail === 0
		menuButton.addEventListener('click', (event) => {
			if (event.detail === 0) {
				const isOpen = siteMenu.classList.contains('is-open');
				setMenuOpen(!isOpen);
			}
		});

		// Close when pressing outside the menu and button
		document.addEventListener('pointerdown', (event) => {
			if (
				siteMenu.classList.contains('is-open') &&
				event.target instanceof Node &&
				!siteMenu.contains(event.target) &&
				!menuButton.contains(event.target)
			) {
				setMenuOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && siteMenu.classList.contains('is-open')) {
				setMenuOpen(false);
				menuButton.focus();
			}
		});

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setMenuOpen(false);
			});
		});

		window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => {
			if (e.matches) {
				setMenuOpen(false);
			}
		});
	}

	if (navLinks.length > 0) {
		const setCurrentLink = (currentLink: Element | null | undefined) => {
			navLinks.forEach((link) => {
				const isCurrent = link === currentLink;
				link.classList.toggle('target-current', isCurrent);
				if (isCurrent) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		if (CSS.supports('scroll-target-group: auto')) {
			const syncCurrentLink = () => {
				setCurrentLink(document.querySelector('.site-menu a:target-current'));
			};

			if (siteMenu instanceof HTMLUListElement) {
				siteMenu.style.setProperty('scroll-target-group', 'auto');
			}
			syncCurrentLink();
			document.addEventListener('scrollend', syncCurrentLink, { passive: true });
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					const visibleSection = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					const currentId = visibleSection?.target.id;
					setCurrentLink(navLinks.find((link) => link.getAttribute('href') === `#${currentId}`));
				},
				{ rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
			);

			navLinks
				.map((link) => {
					const href = link.getAttribute('href');
					return href ? document.querySelector(href) : null;
				})
				.filter((section): section is Element => section instanceof Element)
				.forEach((section) => observer.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 25;
		top: 0;
		left: 0;
		right: 0;
		transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
		border-bottom: 2px solid transparent;
	}

	.site-header.is-scrolled {
		background: rgba(14, 14, 16, 0.92);
		backdrop-filter: blur(12px);
		border-bottom-color: var(--ink-3);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1260px;
		margin: auto;
		padding: 24px 42px;
		transition: padding 0.2s ease;
	}

	.site-header.is-scrolled .site-header-inner {
		padding-top: 14px;
		padding-bottom: 14px;
	}

	.site-header-inner > * {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.brand {
		display: flex;
		align-items: center;
	}

	.brand-logo {
		display: block;
		width: 150px;
		height: auto;
		transition: width 0.2s ease;
	}

	.site-header.is-scrolled .brand-logo {
		width: 134px;
	}

	.brand-logo-header {
		filter: invert(1);
	}

	.main-nav {
		position: relative;
		display: flex;
		align-items: center;
		color: var(--mist);
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.menu-button {
		display: none;
		min-block-size: 44px;
		align-items: center;
		gap: 8px;
		padding: 9px 14px;
		border: 2px solid var(--white);
		border-radius: 999px;
		background: var(--ink-2);
		color: var(--white);
		font: inherit;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		touch-action: manipulation;
		transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
	}

	.menu-button > * {
		pointer-events: none;
	}

	.menu-button:hover {
		border-color: var(--yellow);
	}

	.menu-button[aria-expanded='true'] {
		background: var(--yellow);
		border-color: var(--yellow);
		color: var(--ink);
	}

	.menu-icon {
		display: inline-grid;
		place-items: center;
		width: 1.1em;
		color: var(--yellow);
		font-size: 1.1em;
		line-height: 1;
	}

	.menu-icon .icon-close {
		display: none;
	}

	.menu-button[aria-expanded='true'] .menu-icon {
		color: var(--ink);
	}

	.menu-button[aria-expanded='true'] .menu-icon .icon-open {
		display: none;
	}

	.menu-button[aria-expanded='true'] .menu-icon .icon-close {
		display: inline;
	}

	/* Desktop navigation (default > 960px) */
	.site-menu {
		display: flex;
		align-items: center;
		gap: 36px;
		margin: 0;
		padding: 0;
		list-style: none;
		scroll-target-group: auto;
	}

	.site-menu a {
		display: block;
		padding: 6px 0;
		color: var(--mist);
		transition: color 0.15s ease;
	}

	.site-menu a:hover,
	.site-menu a:focus-visible {
		color: var(--yellow);
	}

	.site-menu a.target-current {
		color: var(--yellow);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		font-weight: 700;
	}

	.header-cta {
		padding: 10px 18px;
		border: 2px solid var(--white);
		border-radius: 30px;
		font-size: 12px;
		font-weight: 700;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}

	.header-cta:hover {
		background: var(--yellow);
		border-color: var(--yellow);
		color: var(--ink);
		transform: translateY(-2px);
	}

	.header-cta:hover :global(.arrow-icon) {
		color: var(--ink);
	}

	:global(.header-cta .arrow-icon) {
		width: 11px;
		height: 11px;
		margin-left: 8px;
		color: var(--yellow);
	}

	/* Mobile / Tablet dropdown menu (<= 960px) */
	@media (max-width: 960px) {
		.menu-button {
			display: inline-flex;
		}

		.site-menu {
			display: none;
			position: fixed;
			top: 76px;
			right: 24px;
			flex-direction: column;
			align-items: stretch;
			gap: 4px;
			inline-size: min(80dvw, 22rem);
			max-inline-size: calc(100dvw - 2rem);
			max-block-size: calc(100dvh - 6rem);
			padding: 12px;
			overflow: auto;
			border: 2px solid var(--ink-3);
			border-radius: 18px;
			background: var(--ink-2);
			box-shadow: 8px 8px 0 var(--pink);
		}

		.site-header.is-scrolled .site-menu {
			top: 66px;
		}

		.site-menu.is-open {
			display: flex;
		}

		.site-menu a {
			min-block-size: 44px;
			padding: 12px 14px;
			border-radius: 10px;
		}

		.site-menu a.target-current {
			background: var(--yellow);
			color: var(--ink);
			text-decoration: none;
		}
	}

	@media (forced-colors: active) {
		.menu-button,
		.header-cta,
		.site-menu {
			border-color: ButtonText;
		}
		.site-menu a.target-current {
			background: Highlight;
			color: HighlightText;
		}
	}

	@media (max-width: 800px) {
		.site-header-inner {
			padding: 18px 24px;
		}
		.site-header.is-scrolled .site-header-inner {
			padding-top: 12px;
			padding-bottom: 12px;
		}
		.brand-logo,
		.site-header.is-scrolled .brand-logo {
			width: 124px;
		}
		.header-cta {
			padding: 9px 13px;
		}
	}
</style>
