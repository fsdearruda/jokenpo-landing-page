---
import { Image } from 'astro:assets';
---

<header class="site-header">
	<div class="site-header-inner">
		<a class="brand" href="/" aria-label="Jokenpo início">
			<Image
				class="brand-logo brand-logo-header"
				src="/Vetor/jokenpo-logo-letras-pretas.svg"
				alt="Jokenpo"
				width={150}
				height={33}
				loading="eager"
				fetchpriority="high"
			/>
		</a>
		<nav class="main-nav" aria-label="Navegação principal">
			<button
				class="menu-button"
				id="menu-toggle-btn"
				type="button"
				aria-expanded="false"
				aria-controls="site-menu"
			>
				<span class="menu-icon" aria-hidden="true">
					<span class="icon-open">☰</span>
					<span class="icon-close">✕</span>
				</span>
				<span>Menu</span>
			</button>
			<ul id="site-menu" class="site-menu">
				<li><a href="#como-funciona">Como funciona</a></li>
				<li><a href="#jogar">Jogos</a></li>
				<li><a href="#agenda">Agenda</a></li>
				<li><a href="#duvidas">Dúvidas</a></li>
				<li><a href="#visite">Visite</a></li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const siteHeader = document.querySelector<HTMLElement>('.site-header');
	const siteMenu = document.querySelector<HTMLUListElement>('#site-menu');
	const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle-btn');
	const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-menu a[href^="#"]')];

	if (siteHeader) {
		const updateScrolledState = () => {
			siteHeader.classList.toggle('is-scrolled', window.scrollY > 24);
		};
		updateScrolledState();
		window.addEventListener('scroll', updateScrolledState, { passive: true });
	}

	if (siteHeader && siteMenu && menuButton) {
		const setMenuOpen = (open: boolean) => {
			siteMenu.classList.toggle('is-open', open);
			menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
		};

		menuButton.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			event.preventDefault();
			const isOpen = siteMenu.classList.contains('is-open');
			setMenuOpen(!isOpen);
		});

		menuButton.addEventListener('click', (event) => {
			if (event.detail === 0) {
				const isOpen = siteMenu.classList.contains('is-open');
				setMenuOpen(!isOpen);
			}
		});

		document.addEventListener('pointerdown', (event) => {
			if (
				siteMenu.classList.contains('is-open') &&
				event.target instanceof Node &&
				!siteMenu.contains(event.target) &&
				!menuButton.contains(event.target)
			) {
				setMenuOpen(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && siteMenu.classList.contains('is-open')) {
				setMenuOpen(false);
				menuButton.focus();
			}
		});

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				setMenuOpen(false);
			});
		});

		window.matchMedia('(min-width: 801px)').addEventListener('change', (e) => {
			if (e.matches) {
				setMenuOpen(false);
			}
		});
	}

	if (navLinks.length > 0) {
		const setCurrentLink = (currentLink: Element | null | undefined) => {
			navLinks.forEach((link) => {
				const isCurrent = link === currentLink;
				link.classList.toggle('target-current', isCurrent);
				if (isCurrent) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		if (CSS.supports('scroll-target-group: auto')) {
			const syncCurrentLink = () => {
				setCurrentLink(document.querySelector('.site-menu a:target-current'));
			};

			if (siteMenu instanceof HTMLUListElement) {
				siteMenu.style.setProperty('scroll-target-group', 'auto');
			}
			syncCurrentLink();
			document.addEventListener('scrollend', syncCurrentLink, { passive: true });
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					const visibleSection = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					const currentId = visibleSection?.target.id;
					setCurrentLink(navLinks.find((link) => link.getAttribute('href') === `#${currentId}`));
				},
				{ rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
			);

			navLinks
				.map((link) => {
					const href = link.getAttribute('href');
					return href ? document.querySelector(href) : null;
				})
				.filter((section): section is Element => section instanceof Element)
				.forEach((section) => observer.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 25;
		top: 0;
		left: 0;
		right: 0;
		border-bottom: 2px solid transparent;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out);
	}

	.site-header.is-scrolled {
		background: oklch(0.16 0.006 285 / 0.94);
		backdrop-filter: blur(10px);
		border-bottom-color: var(--ink-3);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1260px;
		margin-inline: auto;
		padding: 1.25rem clamp(1.5rem, 4vw, 2.625rem);
		transition: padding var(--duration-fast) var(--ease-out);
	}

	.site-header.is-scrolled .site-header-inner {
		padding-top: 0.875rem;
		padding-bottom: 0.875rem;
	}

	.site-header-inner > * {
		flex-shrink: 0;
		white-space: nowrap;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem;
		border-radius: 8px;
	}

	.brand-logo {
		display: block;
		width: 150px;
		height: auto;
		transform-origin: left center;
		transition: transform var(--duration-fast) var(--ease-out);
	}

	.site-header.is-scrolled .brand-logo {
		transform: scale(0.92);
	}

	.brand-logo-header {
		filter: invert(1);
	}

	.main-nav {
		position: relative;
		display: flex;
		align-items: center;
		color: var(--mist);
		font-size: 0.875rem;
		font-weight: 700;
	}

	.menu-button {
		display: none;
		min-block-size: 2.75rem;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5625rem 1rem;
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-pill);
		background: var(--ink-2);
		color: var(--white);
		font: inherit;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		touch-action: manipulation;
		box-shadow: 3px 3px 0 var(--ink-3);
		transition:
			background-color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			transform var(--duration-instant) var(--ease-out);
	}

	.menu-button > * {
		pointer-events: none;
	}

	@media (hover: hover) {
		.menu-button:hover {
			background: var(--ink-3);
			border-color: var(--mist);
		}
	}

	.menu-button:active {
		transform: scale(0.97);
	}

	.menu-button[aria-expanded='true'] {
		background: var(--yellow);
		border-color: var(--ink);
		color: var(--ink);
		box-shadow: 4px 4px 0 var(--pink);
	}

	.menu-icon {
		display: inline-grid;
		place-items: center;
		width: 1.1em;
		color: var(--yellow);
		font-size: 1.1em;
		line-height: 1;
	}

	.menu-icon .icon-close {
		display: none;
	}

	.menu-button[aria-expanded='true'] .menu-icon {
		color: var(--ink);
	}

	.menu-button[aria-expanded='true'] .menu-icon .icon-open {
		display: none;
	}

	.menu-button[aria-expanded='true'] .menu-icon .icon-close {
		display: inline;
	}

	/* Desktop navigation (default > 800px) */
	.site-menu {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		scroll-target-group: auto;
	}

	.site-menu a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.5rem;
		padding: 0.375rem 0.5rem;
		border-radius: 8px;
		color: var(--mist);
		transition: color var(--duration-fast) var(--ease-out);
	}

	.site-menu a:hover,
	.site-menu a:focus-visible {
		color: var(--yellow);
	}

	.site-menu a.target-current,
	.site-menu a[aria-current='true'] {
		color: var(--yellow);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	/* Mobile dropdown menu (<= 800px) */
	@media (max-width: 800px) {
		.site-header-inner {
			padding: 1rem 1.5rem;
		}
		.site-header.is-scrolled .site-header-inner {
			padding-top: 0.75rem;
			padding-bottom: 0.75rem;
		}
		.brand-logo {
			width: 128px;
		}
		.site-header.is-scrolled .brand-logo {
			transform: none;
		}

		.menu-button {
			display: inline-flex;
		}

		.site-menu {
			display: none;
			position: fixed;
			top: 4.5rem;
			right: 1.5rem;
			flex-direction: column;
			align-items: stretch;
			gap: 0.25rem;
			inline-size: min(82dvw, 21rem);
			max-inline-size: calc(100dvw - 2rem);
			max-block-size: calc(100dvh - 6rem);
			padding: 0.75rem;
			overflow: auto;
			border: 2px solid var(--ink-3);
			border-radius: var(--radius-card);
			background: var(--ink-2);
			box-shadow: 8px 8px 0 var(--pink);
			transform-origin: top right;
		}

		.site-header.is-scrolled .site-menu {
			top: 4rem;
		}

		.site-menu.is-open {
			display: flex;
			@media (prefers-reduced-motion: no-preference) {
				animation: menuPop var(--duration-fast) var(--ease-out) both;
			}
		}

		@keyframes menuPop {
			from {
				opacity: 0;
				transform: scale(0.94);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}

		.site-menu a {
			min-block-size: 2.75rem;
			padding: 0.75rem 0.875rem;
			border-radius: 10px;
		}

		.site-menu a.target-current,
		.site-menu a[aria-current='true'] {
			background: var(--yellow);
			color: var(--ink);
			text-decoration: none;
		}
	}

	@media (forced-colors: active) {
		.menu-button,
		.site-menu {
			border-color: ButtonText;
		}
		.site-menu a.target-current,
		.site-menu a[aria-current='true'] {
			background: Highlight;
			color: HighlightText;
		}
	}
</style>
