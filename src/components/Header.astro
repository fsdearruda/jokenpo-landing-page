---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
---

<header class="site-header">
	<div class="site-header-inner">
		<a class="brand" href="/" aria-label="Jokenpô início">
			<Image class="brand-logo brand-logo-header" src="/Vetor/jokenpo-logo-letras-pretas.svg" alt="Jokenpô" width={150} height={33} loading="eager" />
		</a>
		<nav class="main-nav" aria-label="Navegação principal">
			<button class="menu-button" type="button" popovertarget="site-menu" popovertargetaction="toggle" aria-controls="site-menu">
				<span aria-hidden="true">☰</span>
				<span>Menu</span>
			</button>
			<ul id="site-menu" class="site-menu" popover="auto">
				<li><a href="#como-funciona">Como funciona</a></li>
				<li><a href="#jogar">Jogos</a></li>
				<li><a href="#agenda">Agenda</a></li>
				<li><a href="#duvidas">Dúvidas</a></li>
				<li><a href="#visite">Visite</a></li>
			</ul>
		</nav>
		<a class="header-cta" href="#visite">Cola lá <ArrowIcon size={14} /></a>
	</div>
</header>

<script>
	const siteHeader = document.querySelector('.site-header');
	const siteHeaderInner = document.querySelector('.site-header-inner');
	const siteNav = document.querySelector('.main-nav');
	const siteMenu = document.querySelector('.site-menu');
	const menuButton = document.querySelector('.menu-button');
	const navLinks = [...document.querySelectorAll('.site-menu a[href^="#"]')];

	if (siteHeader instanceof HTMLElement) {
		const updateScrolledState = () => {
			siteHeader.classList.toggle('is-scrolled', window.scrollY > 24);
		};
		updateScrolledState();
		window.addEventListener('scroll', updateScrolledState, { passive: true });
	}

	if (
		siteHeader instanceof HTMLElement &&
		siteHeaderInner instanceof HTMLElement &&
		siteNav instanceof HTMLElement &&
		siteMenu instanceof HTMLUListElement &&
		menuButton instanceof HTMLButtonElement
	) {
		const supportsPopover = 'popover' in HTMLElement.prototype;

		const updateNavigationLayout = () => {
			siteHeader.classList.add('is-measuring');
			siteHeader.classList.add('is-wide');
			siteMenu.removeAttribute('popover');
			const fits = siteHeaderInner.scrollWidth <= siteHeaderInner.clientWidth;

			if (fits) {
				siteHeader.classList.add('is-wide');
				siteMenu.removeAttribute('popover');
				menuButton.hidden = true;
			} else {
				siteHeader.classList.remove('is-wide');
				menuButton.hidden = false;
				if (supportsPopover) {
					siteMenu.setAttribute('popover', 'auto');
				}
			}

			siteHeader.classList.remove('is-measuring');
		};

		if (supportsPopover) {
			siteMenu.addEventListener('beforetoggle', (event) => {
				const isOpening = (event as ToggleEvent).newState === 'open';
				menuButton.setAttribute('aria-expanded', String(isOpening));
			});
		} else {
			siteMenu.hidden = true;
			menuButton.addEventListener('click', () => {
				const isOpen = !siteMenu.hidden;
				siteMenu.hidden = isOpen;
				menuButton.setAttribute('aria-expanded', String(!isOpen));
			});
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (!siteHeader.classList.contains('is-wide')) {
					if (supportsPopover && siteMenu.matches(':popover-open')) {
						siteMenu.hidePopover();
					} else {
						siteMenu.hidden = true;
						menuButton.setAttribute('aria-expanded', 'false');
					}
				}
			});
		});

		updateNavigationLayout();
		new ResizeObserver(updateNavigationLayout).observe(siteHeaderInner);
		document.fonts?.ready.then(updateNavigationLayout);
	}

	if (navLinks.length > 0) {
		const setCurrentLink = (currentLink: Element | null | undefined) => {
			navLinks.forEach((link) => {
				const isCurrent = link === currentLink;
				link.classList.toggle('target-current', isCurrent);
				if (isCurrent) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		if (CSS.supports('scroll-target-group: auto')) {
			const syncCurrentLink = () => {
				setCurrentLink(document.querySelector('.site-menu a:target-current'));
			};

			if (siteMenu instanceof HTMLUListElement) {
				siteMenu.style.setProperty('scroll-target-group', 'auto');
			}
			syncCurrentLink();
			document.addEventListener('scrollend', syncCurrentLink, { passive: true });
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					const visibleSection = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					const currentId = visibleSection?.target.id;
					setCurrentLink(navLinks.find((link) => link.getAttribute('href') === `#${currentId}`));
				},
				{ rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5] },
			);

			navLinks
				.map((link) => {
					const href = link.getAttribute('href');
					return href ? document.querySelector(href) : null;
				})
				.filter((section): section is Element => section instanceof Element)
				.forEach((section) => observer.observe(section));
		}
	}
</script>

<style>
	.site-header {
		position: fixed;
		z-index: 25;
		top: 0;
		left: 0;
		right: 0;
		transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
		border-bottom: 2px solid transparent;
	}

	.site-header.is-scrolled {
		background: rgba(14, 14, 16, 0.9);
		backdrop-filter: blur(12px);
		border-bottom-color: var(--ink-3);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1260px;
		margin: auto;
		padding: 24px 42px;
		transition: padding 0.2s ease;
	}

	.site-header.is-scrolled .site-header-inner {
		padding-top: 14px;
		padding-bottom: 14px;
	}

	.site-header-inner > * { flex-shrink: 0; white-space: nowrap; }
	.site-header.is-measuring .site-header-inner > * { transition: none !important; }
	.brand { display: flex; align-items: center; }
	.brand-logo { display: block; width: 150px; height: auto; transition: width 0.2s ease; }
	.site-header.is-scrolled .brand-logo { width: 134px; }
	.brand-logo-header { filter: invert(1); }
	.main-nav { display: flex; align-items: center; color: var(--mist); font-size: .8125rem; font-weight: 700; }
	.menu-button {
		display: inline-flex;
		min-block-size: 44px;
		align-items: center;
		gap: 8px;
		padding: 9px 13px;
		border: 2px solid var(--white);
		border-radius: 999px;
		background: var(--ink-2);
		color: var(--white);
		font: inherit;
		cursor: pointer;
	}
	.menu-button:active { transform: scale(.97); }
	.menu-button span:first-child { color: var(--yellow); font-size: 1.1em; line-height: 1; }
	.site-menu {
		position: fixed;
		inset: 76px 24px auto auto;
		inline-size: min(80dvw, 24rem);
		max-inline-size: calc(100dvw - 2rem);
		max-block-size: calc(100dvh - 6rem);
		margin: 0;
		padding: 12px;
		overflow: auto;
		border: 2px solid var(--ink-3);
		border-radius: 18px;
		background: var(--ink-2);
		box-shadow: 8px 8px 0 var(--pink);
		list-style: none;
		scroll-target-group: auto;
	}
	.site-menu li + li { margin-top: 4px; }
	.site-menu a {
		display: block;
		min-block-size: 44px;
		padding: 12px 14px;
		border-radius: 10px;
		color: var(--mist);
	}
	.site-menu a:hover, .site-menu a:focus-visible { color: var(--yellow); }
	.site-menu a.target-current {
		background: var(--yellow);
		color: var(--ink);
		font-weight: 700;
	}
	.site-header.is-wide .menu-button { display: none; }
	.site-header.is-wide .site-menu {
		position: static;
		display: flex;
		align-items: center;
		gap: 36px;
		inline-size: auto;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		overflow: visible;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}
	.site-header.is-wide .site-menu li + li { margin-top: 0; }
	.site-header.is-wide .site-menu a { min-block-size: 24px; padding: 0; border-radius: 0; }
	.site-header.is-wide .site-menu a.target-current {
		background: transparent;
		color: var(--yellow);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
	.header-cta {
		padding: 10px 18px;
		border: 2px solid var(--white);
		border-radius: 30px;
		font-size: 12px;
		font-weight: 700;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
	}
	.header-cta:hover {
		background: var(--yellow);
		border-color: var(--yellow);
		color: var(--ink);
		transform: translateY(-2px);
	}
	.header-cta:hover :global(.arrow-icon) {
		color: var(--ink);
	}
	:global(.header-cta .arrow-icon) { width: 11px; height: 11px; margin-left: 8px; color: var(--yellow); }

	@media (forced-colors: active) {
		.menu-button, .header-cta, .site-menu { border-color: ButtonText; }
		.site-menu a.target-current { background: Highlight; color: HighlightText; }
	}

	@media (max-width: 800px) {
		.site-header-inner { padding: 18px 24px; }
		.site-header.is-scrolled .site-header-inner { padding-top: 12px; padding-bottom: 12px; }
		.brand-logo, .site-header.is-scrolled .brand-logo { width: 124px; }
		.header-cta { padding: 9px 13px; }
	}
</style>
