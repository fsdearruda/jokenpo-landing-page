---
import siteData from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const { faq, contact } = siteData;
const whatsappDigits = contact.whatsapp.replace(/\D/g, '');
const colors = ['cyan', 'yellow', 'pink'];
---

<section class="section faq-section" id="duvidas" tabindex="-1" aria-labelledby="faq-title">
	<SectionHeading
		eyebrow="TIRE SUAS DÚVIDAS"
		eyebrowColor="yellow"
		titleId="faq-title"
		title="PERGUNTAS"
		highlight="FREQUENTES"
	>
		Tudo o que você precisa saber antes de<br />colar na loja para jogar com a galera
	</SectionHeading>

	<div class="faq-list">
		{faq.map((item, index) => {
			const accent = colors[index % colors.length];
			const num = String(index + 1).padStart(2, '0');
			return (
				<details class={`faq-item accent-${accent}`}>
					<summary class="faq-summary">
						<span class="faq-num" aria-hidden="true">{num}</span>
						<span class="faq-question-text">{item.question}</span>
						<span class="faq-toggle-icon" aria-hidden="true">
							<svg
								viewBox="0 0 16 16"
								width="14"
								height="14"
								fill="none"
								stroke="currentColor"
								stroke-width="2.75"
								stroke-linecap="round"
							>
								<path d="M8 2.5v11M2.5 8h11" />
							</svg>
						</span>
					</summary>
					<div class="faq-content">
						<p>{item.answer}</p>
					</div>
				</details>
			);
		})}
	</div>

	<p class="faq-footer-note">
		Ficou com mais alguma dúvida?{' '}
		<a
			href={`https://wa.me/${whatsappDigits}?text=Ol%C3%A1!%20Tenho%20uma%20d%C3%BAvida%20sobre%20a%20Jokenp%C3%B4`}
			target="_blank"
			rel="noopener noreferrer"
		>
			Chama a gente no WhatsApp
		</a>{' '}
		ou entre na{' '}
		<a href={contact.communityWhatsapp} target="_blank" rel="noopener noreferrer">
			comunidade
		</a>.
	</p>
</section>

<style>
	@media (width > 800px) {
		.faq-section {
			padding-top: 5rem;
			padding-bottom: 5rem;
		}
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.faq-item {
		border-radius: var(--radius-card);
		background: var(--ink-2);
		border: 2px solid var(--ink-3);
		box-shadow: 5px 5px 0 var(--ink-3);
		overflow: hidden;
		transition:
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out);
	}

	.faq-item.accent-cyan[open] {
		border-color: var(--cyan);
		box-shadow: 6px 6px 0 var(--cyan);
	}

	.faq-item.accent-yellow[open] {
		border-color: var(--yellow);
		box-shadow: 6px 6px 0 var(--yellow);
	}

	.faq-item.accent-pink[open] {
		border-color: var(--pink);
		box-shadow: 6px 6px 0 var(--pink);
	}

	.faq-item::details-content {
		interpolate-size: allow-keywords;
		overflow: clip;
		contain: layout;
	}

	.faq-item:not([open])::details-content {
		block-size: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.faq-item::details-content {
			transition: block-size, content-visibility, display;
			transition-duration: var(--duration-normal);
			transition-timing-function: var(--ease-in-out);
			transition-behavior: allow-discrete;
		}
	}

	.faq-summary {
		display: flex;
		align-items: center;
		gap: 1.125rem;
		padding: 1.375rem 1.625rem;
		cursor: pointer;
		user-select: none;
		list-style: none;
		color: var(--white);
		transition: background-color var(--duration-fast) var(--ease-out);
	}

	.faq-summary::-webkit-details-marker {
		display: none;
	}

	@media (hover: hover) {
		.faq-summary:hover {
			background: oklch(1 0 0 / 0.03);
		}
	}

	.faq-summary:focus-visible {
		outline: 2px solid transparent;
		box-shadow: inset 0 0 0 3px var(--yellow);
	}

	.faq-num {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-inline-size: 2rem;
		min-block-size: 2rem;
		padding: 0.25rem 0.5rem;
		border-radius: 8px;
		background: var(--ink);
		border: 2px solid var(--ink-3);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		font-variant-numeric: tabular-nums;
	}

	.faq-item.accent-cyan .faq-num {
		color: var(--cyan);
	}
	.faq-item.accent-yellow .faq-num {
		color: var(--yellow);
	}
	.faq-item.accent-pink .faq-num {
		color: var(--pink);
	}

	.faq-question-text {
		flex: 1;
		font-family: var(--font-display);
		font-size: clamp(1.0625rem, 0.95rem + 0.35vw, 1.25rem);
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.faq-toggle-icon {
		flex-shrink: 0;
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--ink);
		color: var(--mist);
		transition:
			transform var(--duration-normal) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			background-color var(--duration-fast) var(--ease-out);
	}

	.faq-toggle-icon svg {
		display: block;
		width: 0.875rem;
		height: 0.875rem;
	}

	.faq-summary:hover .faq-toggle-icon {
		color: var(--white);
	}

	.faq-item[open] .faq-toggle-icon {
		transform: rotate(45deg);
		background: var(--yellow);
		color: var(--ink);
	}

	.faq-content {
		padding: 1.25rem 2.25rem 1.75rem 5.125rem;
		border-top: 2px dashed oklch(1 0 0 / 0.08);
		color: var(--mist);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.65;
	}

	.faq-content p {
		margin: 0;
		max-width: 68ch;
	}

	.faq-footer-note {
		margin: 1.75rem 0 0;
		color: var(--mist);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.faq-footer-note a {
		color: var(--yellow);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.faq-footer-note a:hover {
		color: var(--cyan);
	}

	@media (max-width: 800px) {
		.faq-summary {
			padding: 1.125rem 1.25rem;
			gap: 0.75rem;
		}

		.faq-content {
			padding: 1rem 1.25rem 1.5rem 1.25rem;
			font-size: 0.875rem;
		}
	}
</style>
