---
import siteData from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const { faq, contact } = siteData;
const colors = ['cyan', 'yellow', 'pink'];
---

<section class="section faq-section" id="duvidas" tabindex="-1" aria-labelledby="faq-title">
	<SectionHeading
		eyebrow="TIRE SUAS DÚVIDAS"
		eyebrowColor="yellow"
		titleId="faq-title"
		title="PERGUNTAS"
		highlight="FREQUENTES"
	>
		Tudo o que você precisa saber antes de<br />colar na loja para jogar com a galera
	</SectionHeading>

	<div class="faq-list" role="region" aria-label="Lista de perguntas frequentes">
		{faq.map((item, index) => {
			const accent = colors[index % colors.length];
			const num = String(index + 1).padStart(2, '0');
			return (
				<details class={`faq-item accent-${accent}`}>
					<summary class="faq-summary">
						<span class="faq-num" aria-hidden="true">{num}</span>
						<span class="faq-question-text">{item.question}</span>
						<span class="faq-toggle-icon" aria-hidden="true">+</span>
					</summary>
					<div class="faq-content">
						<p>{item.answer}</p>
					</div>
				</details>
			);
		})}
	</div>

	<p class="faq-footer-note">
		Ficou com mais alguma dúvida?
		<a
			href="https://wa.me/5584987655623?text=Ol%C3%A1!%20Tenho%20uma%20d%C3%BAvida%20sobre%20a%20Jokenp%C3%B4"
			target="_blank"
			rel="noreferrer"
		>
			Chama a gente no WhatsApp
		</a>
		ou entre na
		<a href={contact.communityWhatsapp} target="_blank" rel="noreferrer">comunidade</a>.
	</p>
</section>

<style>
	/* No mobile vale o espaçamento padrão de `.section`. */
	@media (width > 800px) {
		.faq-section {
			padding-top: 80px;
			padding-bottom: 80px;
		}
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.faq-item {
		border-radius: 22px;
		background: var(--ink-2);
		border: 2px solid var(--ink-3);
		overflow: hidden;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.faq-item.accent-cyan[open] {
		border-color: var(--cyan);
	}

	.faq-item.accent-yellow[open] {
		border-color: var(--yellow);
	}

	.faq-item.accent-pink[open] {
		border-color: var(--pink);
	}

	.faq-summary {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 22px 26px;
		cursor: pointer;
		user-select: none;
		list-style: none;
		color: var(--white);
	}

	.faq-summary::-webkit-details-marker {
		display: none;
	}

	.faq-summary:focus-visible {
		outline: 3px solid var(--yellow);
		outline-offset: -3px;
	}

	.faq-num {
		flex-shrink: 0;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.faq-item.accent-cyan .faq-num {
		color: var(--cyan);
	}
	.faq-item.accent-yellow .faq-num {
		color: var(--yellow);
	}
	.faq-item.accent-pink .faq-num {
		color: var(--pink);
	}

	.faq-question-text {
		flex: 1;
		font-family: 'Archivo Black', sans-serif;
		font-size: 20px;
		letter-spacing: -0.5px;
		line-height: 1.15;
	}

	.faq-toggle-icon {
		flex-shrink: 0;
		font-family: 'Archivo Black', sans-serif;
		font-size: 24px;
		line-height: 1;
		color: var(--mist);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.faq-summary:hover .faq-toggle-icon {
		color: var(--white);
	}

	.faq-item[open] .faq-toggle-icon {
		transform: rotate(45deg);
		color: var(--yellow);
	}

	.faq-content {
		padding: 0 26px 24px 60px;
		color: var(--mist);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.65;
	}

	.faq-content p {
		margin: 0;
		max-width: 72ch;
	}

	.faq-footer-note {
		margin: 26px 0 0;
		color: var(--mist);
		font-size: 13px;
		font-weight: 600;
	}

	.faq-footer-note a {
		color: var(--yellow);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.faq-footer-note a:hover {
		color: var(--white);
	}

	@media (max-width: 800px) {
		.faq-summary {
			padding: 18px 20px;
			gap: 12px;
		}

		.faq-question-text {
			font-size: 17px;
		}

		.faq-content {
			padding: 0 20px 20px 20px;
			font-size: 13px;
		}
	}
</style>
