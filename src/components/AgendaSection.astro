---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';
import SectionHeading from './SectionHeading.astro';

const agenda = siteData.agenda;
const whatsappDigits = siteData.contact.whatsapp.replace(/\D/g, '');
---

<section class="section agenda-section" id="agenda" tabindex="-1" aria-labelledby="agenda-title">
	<SectionHeading
		eyebrow="TODA SEMANA"
		eyebrowColor="cyan"
		titleId="agenda-title"
		title="A AGENDA"
		highlight="DA GALERA"
	>
		Inscrições no balcão<br />Capacidade máxima: 12 jogadores
	</SectionHeading>

	<div class="agenda-grid">
		{agenda.map((event) => (
			<article class={`agenda-card ${event.color}`}>
				<div class="agenda-top">
					<span class="agenda-day">{event.day}</span>
					<span class="agenda-dot" aria-hidden="true"></span>
				</div>
				<div class="agenda-body">
					<h3>{event.name}</h3>
					<p>{event.detail}</p>
				</div>
			</article>
		))}
	</div>

	<div class="agenda-cta-bar">
		<p>
			<strong>Uma vez por mês rola Challenger ou Cup!</strong> Acompanhe avisos de datas, listas e resultados na comunidade.
		</p>
		<a
			class="agenda-cta-link"
			href={`https://wa.me/${whatsappDigits}?text=Ol%C3%A1!%20Quero%20saber%20sobre%20os%20torneios%20da%20semana%20na%20Jokenp%C3%B4`}
			target="_blank"
			rel="noreferrer"
		>
			<span>Tirar dúvida sobre torneios</span>
			<ArrowIcon direction="right" size={14} />
		</a>
	</div>
</section>

<style>
	@media (width > 800px) {
		.agenda-section {
			padding-top: 3.5rem;
		}
	}

	.agenda-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.agenda-card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 184px;
		padding: 1.5rem 1.625rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-card);
		color: var(--ink);
		box-shadow: var(--shadow-hard-surface);
		transition:
			transform var(--duration-normal) var(--ease-out),
			box-shadow var(--duration-normal) var(--ease-out);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.agenda-card:hover {
			transform: translateY(-4px) rotate(-1deg);
			box-shadow: 9px 9px 0 var(--ink-3);
		}
	}

	.agenda-card.yellow {
		background: var(--yellow);
	}

	.agenda-card.cyan {
		background: var(--cyan);
	}

	.agenda-card.pink {
		background: var(--pink);
	}

	.agenda-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.875rem;
		margin-bottom: 1rem;
		border-bottom: 2px dashed oklch(0.16 0.006 285 / 0.25);
	}

	.agenda-day {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6875rem;
		border-radius: var(--radius-pill);
		background: var(--ink);
		color: var(--white);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.agenda-dot {
		width: 0.625rem;
		height: 0.625rem;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--surface-warm);
	}

	.agenda-body h3 {
		margin-bottom: 0.5rem;
		font-family: var(--font-display);
		font-size: clamp(1.3125rem, 1.1rem + 0.5vw, 1.5rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.agenda-body p {
		margin: 0;
		color: var(--ink-on-color);
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.45;
		font-variant-numeric: tabular-nums;
	}

	.agenda-cta-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		margin-top: 1.5rem;
		padding: 1.125rem 1.5rem;
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-card);
		background: var(--ink-2);
		color: var(--mist);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.agenda-cta-bar p {
		margin: 0;
	}

	.agenda-cta-bar strong {
		color: var(--yellow);
	}

	.agenda-cta-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-block-size: 2.5rem;
		padding: 0.375rem 0.75rem;
		border-radius: 8px;
		color: var(--cyan);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.agenda-cta-link:hover {
		color: var(--yellow);
	}

	@media (max-width: 800px) {
		.agenda-grid {
			grid-template-columns: 1fr;
			gap: 1.125rem;
		}

		.agenda-card {
			min-height: auto;
		}
	}
</style>
