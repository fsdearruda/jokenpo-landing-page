---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';
import SectionHeading from './SectionHeading.astro';

const whatsappDigits = siteData.contact.whatsapp.replace(/\D/g, '');
---

<section class="section extras-section" aria-labelledby="extras-title">
	<SectionHeading eyebrow="NO ESPAÇO DA LOJA" eyebrowColor="yellow" titleId="extras-title" title="FICA À VONTADE" highlight="PARA VOLTAR">Um canto para a comunidade<br />jogar, reunir e comemorar</SectionHeading>
	<div class="extras-grid">
		{siteData.extras.map((extra) => (
			<article class={`extra-card extra-card-${extra.color}`}>
				<div class="card-top">
					<span>{extra.number}</span>
					{extra.number === '02' && (
						<a
							class="card-link"
							href={`https://wa.me/${whatsappDigits}?text=Ol%C3%A1!%20Gostaria%20de%20saber%20sobre%20reserva%20de%20mesa%20na%20Jokenp%C3%B4`}
							target="_blank"
							rel="noreferrer"
							aria-label="Reservar mesa pelo WhatsApp"
						>
							Reservar <ArrowIcon size={12} />
						</a>
					)}
				</div>
				<h3>{extra.title}</h3>
				<p set:html={extra.description}></p>
			</article>
		))}
	</div>
</section>

<style>
	/* No mobile vale o espaçamento padrão de `.section`. */
	@media (width > 800px) {
		.extras-section { padding-top: 115px; padding-bottom: 115px; }
	}
	.extras-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
	.extra-card { display: flex; flex-direction: column; min-height: 220px; padding: 25px; border-radius: 22px; color: var(--ink); transition: transform 0.2s ease; }
	.extra-card:hover { transform: translateY(-4px); }
	.extra-card-cyan { background: var(--cyan); }
	.extra-card-yellow { background: var(--yellow); }
	.extra-card-pink { background: var(--pink); }

	.card-top { display: flex; justify-content: space-between; align-items: center; }
	.card-top > span { font-size: 11px; font-weight: 700; letter-spacing: 2px; }

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--white);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.card-link:hover { opacity: 0.85; transform: scale(1.03); }
	:global(.card-link .arrow-icon) { width: 10px; height: 10px; }

	.extra-card h3 { margin: 38px 0 10px; font-family: 'Archivo Black', sans-serif; font-size: 25px; letter-spacing: -1px; }
	.extra-card p { margin: 0; font-size: 12px; font-weight: 600; line-height: 1.55; }

	@media (max-width: 800px) {
		.extras-grid { grid-template-columns: 1fr; }
	}
</style>
