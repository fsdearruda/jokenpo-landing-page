---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';
import SectionHeading from './SectionHeading.astro';

const whatsappDigits = siteData.contact.whatsapp.replace(/\D/g, '');
---

<section class="section extras-section" aria-labelledby="extras-title">
	<SectionHeading
		eyebrow="NO ESPAÇO DA LOJA"
		eyebrowColor="yellow"
		titleId="extras-title"
		title="FICA À VONTADE"
		highlight="PARA VOLTAR"
	>
		Um canto para a comunidade<br />jogar, reunir e comemorar
	</SectionHeading>

	<div class="extras-grid">
		{siteData.extras.map((extra) => (
			<article class={`extra-card extra-card-${extra.color}`}>
				<div class="card-top">
					<span class="extra-num">{extra.number}</span>
					{extra.number === '02' && (
						<a
							class="card-link"
							href={`https://wa.me/${whatsappDigits}?text=Ol%C3%A1!%20Gostaria%20de%20saber%20sobre%20reserva%20de%20mesa%20na%20Jokenp%C3%B4`}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Reservar mesa pelo WhatsApp"
						>
							<span>Reservar</span>
							<ArrowIcon size={12} />
						</a>
					)}
				</div>
				<h3>{extra.title}</h3>
				<p set:html={extra.description}></p>
			</article>
		))}
	</div>
</section>

<style>
	@media (width > 800px) {
		.extras-section {
			padding-top: 6rem;
			padding-bottom: 5.5rem;
		}
	}

	.extras-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.375rem;
	}

	.extra-card {
		display: flex;
		flex-direction: column;
		min-height: 230px;
		padding: 1.75rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-card);
		color: var(--ink);
		box-shadow: var(--shadow-hard-surface);
		transition:
			transform var(--duration-normal) var(--ease-out),
			box-shadow var(--duration-normal) var(--ease-out);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.extra-card:hover {
			transform: translateY(-4px);
			box-shadow: 9px 9px 0 var(--ink-3);
		}
	}

	.extra-card-cyan {
		background: var(--cyan);
	}

	.extra-card-yellow {
		background: var(--yellow);
	}

	.extra-card-pink {
		background: var(--pink);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		min-block-size: 2.5rem;
		margin-bottom: 1.25rem;
	}

	.extra-num {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6875rem;
		border: 1.5px solid oklch(0.16 0.006 285 / 0.28);
		border-radius: var(--radius-pill);
		background: oklch(1 0 0 / 0.24);
		color: var(--ink);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		font-variant-numeric: tabular-nums;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		min-block-size: 2.5rem;
		padding: 0.4375rem 0.9375rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-pill);
		background: var(--ink);
		color: var(--white);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		box-shadow: 3px 3px 0 oklch(0.16 0.006 285 / 0.28);
		transition:
			transform var(--duration-fast) var(--ease-out),
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.card-link:hover {
			transform: translate(-1px, -1px);
			background: var(--surface-warm);
			color: var(--ink);
		}
	}

	.card-link:active {
		transform: scale(0.97);
	}

	:global(.card-link .arrow-icon) {
		width: 0.75rem;
		height: 0.75rem;
	}

	.extra-card h3 {
		margin: auto 0 0.625rem;
		font-family: var(--font-display);
		font-size: clamp(1.375rem, 1.15rem + 0.5vw, 1.5625rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.extra-card p {
		margin: 0;
		color: var(--ink-on-color);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.55;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 800px) {
		.extras-grid {
			grid-template-columns: 1fr;
			gap: 1.125rem;
		}

		.extra-card {
			min-height: auto;
		}
	}
</style>
