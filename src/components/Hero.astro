---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';

const { hero, contact } = siteData;
const communityBtnColor = hero.communityButtonColor || '#14532d';
const heroDescriptionHtml = hero.description.replace(
	/\bNatal\b/,
	'<a href="#visite" class="hero-location-link">Natal</a>',
);
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero-bg-word" aria-hidden="true">PLAY</div>
	<div class="hero-grid">
		<div class="hero-copy">
			<p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> {hero.eyebrow}</p>
			<h1 id="hero-title">{hero.titleLine1}<br /><span>{hero.titleLine2}</span><br />{hero.titleLine3}</h1>
			<p class="hero-text" set:html={heroDescriptionHtml}></p>
			<div class="hero-actions">
				<a class="button button-yellow" href="#agenda">
					<span>Ver agenda</span>
					<ArrowIcon direction="right" size={16} />
				</a>
				<a
					class="button button-community"
					style={`--community-btn-bg: ${communityBtnColor};`}
					href={contact.communityWhatsapp}
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg
						class="whatsapp-icon"
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M12.031 2c-5.506 0-9.989 4.478-9.99 9.984a9.964 9.964 0 0 0 1.333 4.993L2 22l5.233-1.237a9.994 9.994 0 0 0 4.779 1.217h.004c5.505 0 9.988-4.478 9.989-9.984 0-2.669-1.037-5.176-2.922-7.062A9.935 9.935 0 0 0 12.031 2Zm5.829 14.12c-.246.693-1.432 1.325-1.988 1.411-.51.078-1.156.111-1.869-.115-.433-.138-.988-.321-1.699-.628-2.989-1.29-4.941-4.301-5.091-4.5-.149-.199-1.215-1.616-1.215-3.083 0-1.466.768-2.187 1.041-2.486.273-.299.596-.374.795-.374.198 0 .397.002.571.01.183.009.428-.07.67.511.248.597.844 2.063.918 2.212.075.149.124.323.025.522-.099.199-.149.323-.298.497-.149.174-.313.389-.447.523-.149.149-.304.311-.131.609.174.298.771 1.272 1.656 2.061 1.139 1.015 2.099 1.329 2.397 1.479.298.149.472.124.646-.075.174-.199.745-.87.944-1.168.198-.299.397-.249.67-.149.273.099 1.738.82 2.036.969.298.149.497.224.571.348.075.124.075.721-.171 1.414Z" />
					</svg>
					<span>Participe da comunidade</span>
				</a>
			</div>
		</div>

		<div class="hero-stage" aria-hidden="true">
			<div class="burst burst-one">
				<Image
					src="/Vetor/brilho-rosa.svg"
					alt=""
					width={47}
					height={47}
					loading="lazy"
					fetchpriority="low"
					aria-hidden="true"
				/>
			</div>
			<div class="burst burst-two">
				<Image
					src="/Vetor/brilho-preto.svg"
					alt=""
					width={32}
					height={32}
					loading="lazy"
					fetchpriority="low"
					aria-hidden="true"
				/>
			</div>
			<div class="card-back card-back-main">
				<div class="card-inner">
					<div class="card-symbol">✦</div>
					<strong>JOKENPO</strong>
					<small>JOGUE MAIS</small>
				</div>
			</div>
			<div class="mini-card">
				<div class="mini-card-suit">♠</div>
				<span>PLAY<br />YOUR<br />WAY</span>
			</div>
			<Image
				class="hero-mascot"
				src="/Vetor/coelho-creme.svg"
				alt=""
				width={112}
				height={126}
				loading="lazy"
				fetchpriority="low"
				aria-hidden="true"
			/>
			<div class="die">
				<svg class="die-svg" viewBox="0 0 100 100" fill="none" aria-hidden="true">
					<polygon
						points="50,6 88.1,28 88.1,72 50,94 11.9,72 11.9,28"
						fill="var(--yellow)"
						stroke="var(--ink)"
						stroke-width="5"
						stroke-linejoin="round"
					/>
					<polygon points="11.9,72 26.6,63.5 50,94" fill="#e6bc00" />
					<polygon points="88.1,72 73.4,63.5 50,94" fill="#e6bc00" />
					<polygon points="26.6,63.5 73.4,63.5 50,94" fill="#d9b000" />
					<polygon points="50,6 88.1,28 50,23" fill="#ffe14d" />
					<polygon points="50,6 11.9,28 50,23" fill="#ffe14d" />
					<g stroke="var(--ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
						<line x1="50" y1="23" x2="50" y2="6" />
						<line x1="50" y1="23" x2="11.9" y2="28" />
						<line x1="50" y1="23" x2="88.1" y2="28" />
						<line x1="73.4" y1="63.5" x2="88.1" y2="28" />
						<line x1="73.4" y1="63.5" x2="88.1" y2="72" />
						<line x1="73.4" y1="63.5" x2="50" y2="94" />
						<line x1="26.6" y1="63.5" x2="11.9" y2="28" />
						<line x1="26.6" y1="63.5" x2="11.9" y2="72" />
						<line x1="26.6" y1="63.5" x2="50" y2="94" />
					</g>
					<polygon
						points="50,23 73.4,63.5 26.6,63.5"
						fill="var(--yellow)"
						stroke="var(--ink)"
						stroke-width="3.5"
						stroke-linejoin="round"
					/>
					<polygon
						points="50,6 88.1,28 88.1,72 50,94 11.9,72 11.9,28"
						fill="none"
						stroke="var(--ink)"
						stroke-width="5"
						stroke-linejoin="round"
					/>
				</svg>
				<span class="die-number">20</span>
			</div>
			<div class="sticker">BORA<br /><em>JOGAR?</em></div>
		</div>
	</div>

	<div class="hero-bottom-bar">
		<a class="scroll-cue" href="#como-funciona">
			<div class="scroll-cue-row">
				<span class="scroll-line" aria-hidden="true"></span>
				<span class="scroll-label">DESÇA PRA JOGAR</span>
				<span class="scroll-line" aria-hidden="true"></span>
			</div>
			<ArrowIcon direction="down" class="scroll-arrow" size={16} />
		</a>

		<div class="hero-note">
			<strong>SEG — SÁB · 14H ÀS 22H</strong>
			<span>LOJA 24 · NEW WAY CENTER</span>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 760px;
		padding: 9.5rem max(2.625rem, calc((100% - 1176px) / 2)) 3.75rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 3rem;
		background-color: var(--ink);
		background-image: radial-gradient(oklch(1 0 0 / 0.08) 2px, transparent 2.5px);
		background-size: 26px 26px;
	}

	.hero::after {
		position: absolute;
		right: -8%;
		bottom: -36%;
		width: 58%;
		height: 78%;
		border: 2px solid var(--ink-3);
		border-radius: 50%;
		content: '';
		pointer-events: none;
		transform: rotate(-24deg);
	}

	.hero-bg-word {
		position: absolute;
		top: 7.5rem;
		right: -2.875rem;
		color: transparent;
		font-family: var(--font-display);
		font-size: clamp(9.5rem, 22vw, 18.125rem);
		line-height: 0.8;
		opacity: 0.14;
		-webkit-text-stroke: 2px var(--white);
		transform: rotate(-8deg);
		pointer-events: none;
		user-select: none;
	}

	.hero-grid {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
		align-items: center;
		gap: 2.5rem;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		max-width: 35rem;
	}

	.eyebrow-dot {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: var(--pink);
	}

	.hero-text {
		max-inline-size: 56ch;
		margin-bottom: 2rem;
		color: var(--mist);
		font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
		font-weight: 600;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.hero-text :global(.hero-location-link) {
		color: var(--yellow);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		font-weight: 700;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.hero-text :global(.hero-location-link:hover) {
		color: var(--cyan);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
	}

	.button-community {
		border-color: oklch(0.85 0.08 150 / 0.35);
		background: var(--community-btn-bg, #14532d);
		color: var(--white);
	}

	.whatsapp-icon {
		width: 1.125rem;
		height: 1.125rem;
		flex-shrink: 0;
	}

	/* Tabletop Collage Stage */
	.hero-stage {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 520px;
		height: 490px;
		justify-self: end;
	}

	.card-back {
		position: absolute;
		border: 10px solid var(--white);
		border-radius: 22px;
		background: var(--ink);
		box-shadow: 14px 16px 0 var(--ink-2);
	}

	.card-back-main {
		top: 28px;
		right: 52px;
		width: 264px;
		height: 380px;
		padding: 12px;
		transform: rotate(8deg);
	}

	.card-inner {
		display: flex;
		height: 100%;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 3px solid var(--pink);
		border-radius: 11px;
		background:
			radial-gradient(circle at 50% 35%, oklch(0.66 0.24 350 / 0.22), transparent 65%),
			var(--ink-2);
	}

	.card-symbol {
		display: grid;
		width: 92px;
		height: 92px;
		place-items: center;
		margin-bottom: 20px;
		border: 3px solid var(--yellow);
		border-radius: 50%;
		background: var(--ink);
		color: var(--yellow);
		font-size: 3.25rem;
		box-shadow: 4px 4px 0 var(--pink);
	}

	.card-inner strong {
		font-family: var(--font-display);
		font-size: 1.5625rem;
		letter-spacing: -0.02em;
	}

	.card-inner small {
		margin-top: 6px;
		color: var(--cyan);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
	}

	.mini-card {
		position: absolute;
		top: 136px;
		left: 24px;
		width: 148px;
		height: 214px;
		padding: 14px;
		border: 7px solid var(--white);
		border-radius: 16px;
		background: var(--cyan);
		color: var(--ink);
		box-shadow: 10px 12px 0 var(--ink);
		transform: rotate(-12deg);
	}

	.mini-card-suit {
		margin-bottom: 18px;
		color: var(--pink);
		font-size: 2.375rem;
		line-height: 1;
	}

	.mini-card span {
		display: block;
		font-family: var(--font-display);
		font-size: 1.0625rem;
		line-height: 0.94;
	}

	.die {
		position: absolute;
		right: 4px;
		bottom: 24px;
		display: grid;
		width: 96px;
		height: 96px;
		place-items: center;
		filter: drop-shadow(6px 7px 0 var(--ink));
		transform: rotate(15deg);
	}

	.die-svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	.die-number {
		position: absolute;
		top: 52%;
		left: 50%;
		transform: translate(-50%, -50%);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1.1875rem;
		letter-spacing: -0.03em;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.hero-mascot {
		position: absolute;
		right: 68px;
		bottom: 16px;
		width: 112px;
		height: auto;
		filter: drop-shadow(5px 6px 0 var(--ink));
		transform: rotate(7deg);
	}

	.sticker {
		position: absolute;
		bottom: 16px;
		left: 48px;
		padding: 1rem 1.375rem;
		border: 3px solid var(--ink);
		border-radius: 14px;
		background: var(--pink);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 1.0625rem;
		line-height: 0.94;
		text-align: center;
		box-shadow: 6px 6px 0 var(--ink);
		transform: rotate(-8deg);
	}

	.sticker em {
		color: var(--white);
		font-style: normal;
	}

	.burst {
		position: absolute;
		line-height: 0;
	}

	.burst img {
		display: block;
		width: 100%;
		height: auto;
	}

	.burst-one {
		top: 12px;
		right: 8px;
		width: 47px;
	}

	.burst-two {
		bottom: 104px;
		left: 0;
		width: 32px;
	}

	/* Bottom Bar: Scroll cue + Hours note */
	.hero-bottom-bar {
		position: relative;
		z-index: 3;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 1rem;
	}

	.scroll-cue {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4375rem;
		padding: 0.375rem 0;
		border-radius: 8px;
		color: var(--mist);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.scroll-cue:hover {
		color: var(--yellow);
	}

	.scroll-cue-row {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.scroll-line {
		display: block;
		width: 1.75rem;
		height: 2px;
		flex: none;
		background: currentColor;
	}

	.scroll-label {
		display: block;
		line-height: 1.25;
	}

	:global(.scroll-cue .scroll-arrow) {
		width: 1rem;
		height: 1rem;
		margin-left: 2.375rem;
		@media (prefers-reduced-motion: no-preference) {
			animation: scroll-arrow 1.6s var(--ease-in-out) infinite;
		}
	}

	@keyframes scroll-arrow {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(3px);
		}
	}

	.hero-note {
		padding: 0.75rem 1.125rem;
		border: 2px solid var(--ink-3);
		border-radius: 14px;
		background: var(--ink-2);
		box-shadow: 5px 5px 0 var(--ink-3);
		text-align: right;
		transform: rotate(-3deg);
	}

	.hero-note strong {
		display: block;
		color: var(--yellow);
		font-family: var(--font-display);
		font-size: 1rem;
		line-height: 1.05;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.hero-note span {
		display: block;
		margin-top: 0.25rem;
		color: var(--mist);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	@media (max-width: 960px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.hero-stage {
			justify-self: center;
			max-width: 460px;
			height: 360px;
		}

		.card-back-main {
			top: 10px;
			right: 42px;
			width: 210px;
			height: 300px;
		}

		.card-symbol {
			width: 68px;
			height: 68px;
			font-size: 2.25rem;
		}

		.card-inner strong {
			font-size: 1.25rem;
		}

		.mini-card {
			top: 72px;
			left: 24px;
			width: 126px;
			height: 180px;
		}

		.hero-mascot {
			width: 92px;
			right: 54px;
			bottom: 12px;
		}

		.die {
			width: 82px;
			height: 82px;
		}
	}

	@media (max-width: 800px) {
		.hero {
			min-height: auto;
			padding: 6.75rem 1.5rem 2.5rem;
			gap: 1.75rem;
		}

		.hero-bg-word {
			top: 5.5rem;
			right: -3.5rem;
			font-size: 8.5rem;
		}

		/* Esconde as cartas e elementos decorativos no mobile para evitar scroll vertical excessivo */
		.hero-stage,
		.scroll-cue {
			display: none;
		}

		.hero-bottom-bar {
			justify-content: flex-start;
			padding-top: 0.25rem;
		}

		.hero-note {
			text-align: left;
			transform: none;
		}
	}
</style>
