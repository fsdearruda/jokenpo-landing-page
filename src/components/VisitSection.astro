---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';

const { location, contact } = siteData;
const openHours = siteData.hours.filter((hours) => !hours.closed);
---

<section class="visit-section section" id="visite" tabindex="-1" aria-labelledby="visit-title">
	<div class="visit-content">
		<p class="eyebrow yellow-text">ONDE ESTAMOS</p>
		<h2 id="visit-title">COLA NA<br /><span>JOKENPO</span></h2>
		<div class="visit-details">
			<div><small>ONDE</small><strong>{location.venue}<br />{location.street}<br />{location.neighborhood}</strong></div>
			<div><small>QUANDO</small><strong>{openHours.map((hours) => <span>{hours.day} · {hours.open}<br /></span>)}</strong></div>
		</div>
		<div class="visit-contact">
			<p><small>FALE COM A GALERA</small>Entre na comunidade para conversar sobre cada jogo e receber avisos gerais importantes.</p>
			<div class="visit-contact-links">
				<a href={contact.communityWhatsapp} target="_blank" rel="noreferrer">Comunidade no WhatsApp <ArrowIcon size={13} /></a>
			</div>
		</div>
		<a class="button button-yellow" href={location.mapsUrl} target="_blank" rel="noreferrer">Abrir no mapa <ArrowIcon size={16} /></a>
	</div>
	<div class="map-preview">
		<iframe
			title="Localização da Jokenpo no Shopping New Way Center"
			src={location.embedUrl}
			width="600"
			height="450"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
		<div class="map-label">LOJA 24<br /><strong>NEW WAY</strong></div>
	</div>
</section>

<style>
	.visit-section { display: flex; align-items: center; justify-content: space-between; min-height: 620px; }
	.visit-content { max-width: 570px; }
	.visit-content h2 { margin-bottom: 42px; }
	.visit-content h2 span { color: var(--cyan); }
	.visit-details { display: flex; gap: 65px; margin-bottom: 35px; }
	.visit-details small { display: block; margin-bottom: 10px; color: var(--pink); font-size: 10px; font-weight: 700; letter-spacing: 2px; }
	.visit-details strong { display: block; color: var(--mist); font-size: 13px; line-height: 1.6; }
	.visit-contact { max-width: 520px; margin-bottom: 28px; color: var(--mist); font-size: 12px; line-height: 1.55; }
	.visit-contact p { margin: 0 0 12px; }
	.visit-contact small { display: block; margin-bottom: 6px; color: var(--pink); font-size: 10px; font-weight: 700; letter-spacing: 2px; }
	.visit-contact-links { display: flex; flex-wrap: wrap; gap: 10px 24px; }
	.visit-contact-links a { color: var(--yellow); font-weight: 700; }
	.visit-contact-links a:hover { color: var(--white); }
	:global(.visit-contact-links .arrow-icon) { width: 10px; height: 10px; margin-left: 4px; vertical-align: -2px; }
	.map-preview { position: relative; width: min(38vw, 410px); height: 360px; overflow: hidden; border: 3px solid var(--cyan); border-radius: 29px; box-shadow: 12px 12px 0 var(--pink); transform: rotate(3deg); }
	.map-preview iframe { width: 100%; height: 100%; border: 0; filter: saturate(.8) contrast(1.05); }
	.map-label { position: absolute; top: 22px; right: 24px; padding: 10px; background: var(--pink); color: var(--ink); font-family: 'Archivo Black', sans-serif; font-size: 13px; line-height: .9; box-shadow: 5px 5px 0 var(--ink); transform: rotate(-8deg); }
	.map-label strong { color: var(--ink); }

	@media (max-width: 800px) {
		.visit-section { display: block; min-height: auto; }
		.visit-details { gap: 28px; }
		.map-preview { width: 85vw; height: 300px; margin: 70px auto 0; }
	}
</style>
