---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';

const { location, contact } = siteData;
const openHours = siteData.hours.filter((hours) => !hours.closed);
---

<section class="visit-section section" id="visite" tabindex="-1" aria-labelledby="visit-title">
	<div class="visit-content">
		<p class="eyebrow yellow-text">ONDE ESTAMOS</p>
		<h2 id="visit-title">COLA NA<br /><span>JOKENPO</span></h2>

		<dl class="visit-details">
			<div class="visit-detail-block">
				<dt>ONDE</dt>
				<dd>
					<strong>{location.venue}</strong><br />
					{location.street}<br />
					{location.neighborhood}
				</dd>
			</div>
			<div class="visit-detail-block">
				<dt>QUANDO</dt>
				<dd class="visit-hours">
					{openHours.map((hours) => (
						<span>
							<strong>{hours.day}</strong> · {hours.open}<br />
						</span>
					))}
					<span class="closed-note">DOM · Fechado</span>
				</dd>
			</div>
		</dl>

		<div class="visit-contact">
			<p class="visit-contact-kicker">FALE COM A GALERA</p>
			<p class="visit-contact-text">
				Entre na comunidade para conversar sobre cada jogo e receber avisos gerais importantes.
			</p>
			<div class="visit-contact-links">
				<a href={contact.communityWhatsapp} target="_blank" rel="noreferrer">
					<span>Comunidade no WhatsApp</span>
					<ArrowIcon size={13} />
				</a>
				<a href={contact.instagram} target="_blank" rel="noreferrer">
					<span>Instagram @jokenpoficial</span>
					<ArrowIcon size={13} />
				</a>
			</div>
		</div>

		<a class="button button-yellow" href={location.mapsUrl} target="_blank" rel="noreferrer">
			<span>Abrir no Google Maps</span>
			<ArrowIcon size={16} />
		</a>
	</div>

	<div class="map-preview">
		<iframe
			title="Localização da Jokenpo no Shopping New Way Center"
			src={location.embedUrl}
			width="600"
			height="450"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
		<div class="map-label" aria-hidden="true">LOJA 24<br /><strong>NEW WAY</strong></div>
	</div>
</section>

<style>
	.visit-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		min-height: 600px;
	}

	.visit-content {
		max-width: 36rem;
		flex: 1;
	}

	.visit-content h2 {
		margin-bottom: 2.25rem;
	}

	.visit-content h2 span {
		color: var(--cyan);
	}

	.visit-details {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2rem;
		margin: 0 0 2rem;
		padding: 1.375rem 1.5rem;
		border: 2px solid var(--ink-3);
		border-radius: var(--radius-card);
		background: var(--ink-2);
		box-shadow: 5px 5px 0 var(--ink-3);
	}

	.visit-detail-block dt {
		margin-bottom: 0.5rem;
		color: var(--pink);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.visit-detail-block dd {
		margin: 0;
		color: var(--mist);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.6;
	}

	.visit-detail-block dd strong {
		color: var(--white);
		font-weight: 700;
	}

	.visit-hours {
		font-variant-numeric: tabular-nums;
	}

	.closed-note {
		display: inline-block;
		margin-top: 0.25rem;
		color: var(--mist);
		opacity: 0.8;
		font-size: 0.8125rem;
	}

	.visit-contact {
		max-width: 34rem;
		margin-bottom: 2rem;
		color: var(--mist);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.visit-contact-kicker {
		margin: 0 0 0.375rem;
		color: var(--pink);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.visit-contact-text {
		margin: 0 0 0.875rem;
		font-weight: 600;
	}

	.visit-contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
	}

	.visit-contact-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-block-size: 2.25rem;
		color: var(--yellow);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.visit-contact-links a:hover {
		color: var(--cyan);
	}

	:global(.visit-contact-links .arrow-icon) {
		width: 0.75rem;
		height: 0.75rem;
	}

	.map-preview {
		position: relative;
		flex-shrink: 0;
		width: min(40vw, 420px);
		height: 380px;
		overflow: hidden;
		border: 3px solid var(--cyan);
		border-radius: var(--radius-feature);
		background: var(--ink-2);
		box-shadow: 12px 12px 0 var(--pink);
		transform: rotate(2.5deg);
	}

	.map-preview iframe {
		width: 100%;
		height: 100%;
		border: 0;
		filter: saturate(0.85) contrast(1.05);
	}

	.map-label {
		position: absolute;
		top: 1.25rem;
		right: 1.375rem;
		padding: 0.625rem 0.875rem;
		border: 2px solid var(--ink);
		border-radius: 10px;
		background: var(--pink);
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 0.875rem;
		line-height: 0.95;
		box-shadow: 5px 5px 0 var(--ink);
		transform: rotate(-7deg);
	}

	.map-label strong {
		color: var(--white);
	}

	@media (max-width: 800px) {
		.visit-section {
			flex-direction: column;
			align-items: stretch;
			min-height: auto;
			gap: 2.75rem;
		}

		.visit-details {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.map-preview {
			width: min(100%, 400px);
			height: 300px;
			margin-inline: auto;
		}
	}
</style>
