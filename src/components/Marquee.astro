---
import { Image } from 'astro:assets';

const items = Array.from({ length: 6 });
---

<section class="marquee" aria-label="RPG, TCG, board games e torneios">
	<div class="marquee-track">
		<div class="marquee-group">
			{items.map((_, i) => (
				<Image
					src="/Vetor/faixa-categorias.svg"
					alt={i === 0 ? "RPG, TCG, board games e torneios" : ""}
					width={654}
					height={44}
					loading="eager"
					aria-hidden={i > 0 ? "true" : undefined}
				/>
			))}
		</div>
		<div class="marquee-group" aria-hidden="true">
			{items.map(() => (
				<Image
					src="/Vetor/faixa-categorias.svg"
					alt=""
					width={654}
					height={44}
					loading="eager"
				/>
			))}
		</div>
	</div>
	<button class="marquee-toggle" type="button" aria-pressed="false">Pausar movimento</button>
</section>

<script>
	const marquee = document.querySelector('.marquee');
	const marqueeToggle = document.querySelector('.marquee-toggle');

	if (marquee instanceof HTMLElement && marqueeToggle instanceof HTMLButtonElement) {
		marqueeToggle.addEventListener('click', () => {
			const isPaused = marquee.classList.toggle('is-paused');
			marqueeToggle.setAttribute('aria-pressed', String(isPaused));
			marqueeToggle.textContent = isPaused ? 'Retomar movimento' : 'Pausar movimento';
		});
	}
</script>

<style>
	.marquee {
		position: relative;
		overflow: hidden;
		background: var(--ink);
		white-space: nowrap;
		transform: rotate(-1.5deg) scale(1.03);
		user-select: none;
	}
	.marquee-track {
		display: flex;
		width: max-content;
		will-change: transform;
		@media (prefers-reduced-motion: no-preference) {
			animation: slide 120s linear infinite;
		}
	}
	.marquee.is-paused .marquee-track { animation-play-state: paused; }
	.marquee-group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.marquee-group img {
		display: block;
		width: 654px;
		height: 44px;
		flex: none;
	}
	@keyframes slide { to { transform: translateX(-50%); } }
	.marquee-toggle {
		position: absolute;
		top: 8px;
		right: 24px;
		padding: 6px 10px;
		border: 1px solid var(--mist);
		border-radius: 999px;
		background: var(--ink);
		color: var(--white);
		font: inherit;
		font-size: 10px;
		font-weight: 700;
		cursor: pointer;
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee-toggle { display: none; }
	}
</style>
