---
import { Image } from 'astro:assets';
import siteData from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

import unoImg from '../assets/games/uno.jpg';
import tacoImg from '../assets/games/taco.jpg';
import knockKnockImg from '../assets/games/knock-knock-dungeon.png';
import nemAPatoImg from '../assets/games/nem-a-pato.png';
import naoTestamosImg from '../assets/games/nao-testamos-esse-troco.jpg';
import naoPode2Img from '../assets/games/nao-pode-2.png';
import bangImg from '../assets/games/bang.jpg';
import coupImg from '../assets/games/coup.png';
import skyTeamImg from '../assets/games/sky-team.jpg';
import explodingKittensImg from '../assets/games/exploding-kittens.jpg';
import catanImg from '../assets/games/catan.png';
import ticketToRideImg from '../assets/games/ticket-to-ride.jpg';
import zombicideImg from '../assets/games/zombicide.jpg';

const imageMap: Record<string, ImageMetadata> = {
	'uno.jpg': unoImg,
	'taco.jpg': tacoImg,
	'taco.png': tacoImg,
	'knock-knock-dungeon.png': knockKnockImg,
	'nem-a-pato.png': nemAPatoImg,
	'nao-testamos-esse-troco.jpg': naoTestamosImg,
	'nao-pode-2.png': naoPode2Img,
	'bang.jpg': bangImg,
	'bang.png': bangImg,
	'coup.png': coupImg,
	'sky-team.jpg': skyTeamImg,
	'exploding-kittens.jpg': explodingKittensImg,
	'exploding-kittens.png': explodingKittensImg,
	'catan.png': catanImg,
	'ticket-to-ride.jpg': ticketToRideImg,
	'zombicide.jpg': zombicideImg,
};

const assetGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/games/*.{jpg,jpeg,png,webp,avif,svg}', {
	eager: true,
});

const dynamicImageMap: Record<string, ImageMetadata> = {
	...imageMap,
};

for (const [filePath, mod] of Object.entries(assetGlob)) {
	const filename = filePath.split('/').pop();
	if (filename && mod.default) {
		dynamicImageMap[filename] = mod.default;
		dynamicImageMap[`/uploads/${filename}`] = mod.default;
	}
}

const passes = siteData.boardgamePasses;
const categoryLookup = Object.fromEntries(
	(siteData.boardgameCategories ?? passes.afternoon.tiers).map((cat) => [
		cat.id,
		{ name: cat.name, price: cat.price, color: cat.color },
	]),
);

const games = siteData.boardgames.map((game) => {
	const catInfo = categoryLookup[game.category];
	return {
		...game,
		categoryName: catInfo?.name || game.categoryName || game.category,
		price: catInfo?.price || game.price || '',
	};
});

const counts = {
	all: games.length,
	leves: games.filter((g) => g.category === 'leves').length,
	medios: games.filter((g) => g.category === 'medios').length,
	grandes: games.filter((g) => g.category === 'grandes').length,
};
---

<section class="section games-section" id="jogar" tabindex="-1" aria-labelledby="games-title">
	<SectionHeading
		eyebrow="JOGOS DE TABULEIRO"
		eyebrowColor="cyan"
		titleId="games-title"
		title="TABELA DOS"
		highlight="BOARDGAMES"
	>
		Jogue na loja por período ou por hora.<br />Confira nossos passes, horários e acervo completo:
	</SectionHeading>

	<!-- Visual Pricing Board matching the official store reference -->
	<div class="pricing-board" aria-label="Tabela de preços e passes dos jogos de tabuleiro">
		<!-- Card Passe da Tarde -->
		<article class="pricing-card afternoon-card">
			<div class="card-schedule-header">
				<span class="schedule-days">{passes.afternoon.days}</span>
				<span class="schedule-hours">{passes.afternoon.hours}</span>
			</div>
			<h3 class="afternoon-title">{passes.afternoon.title}</h3>

			<div class="tiers-list">
				{passes.afternoon.tiers.map((tier) => (
					<div class={`tier-row ${tier.color}`}>
						<div class="tier-info">
							<span class="tier-name">{tier.name}</span>
							<span class="tier-desc">{tier.description}</span>
						</div>
						<span class="tier-price">{tier.price}</span>
					</div>
				))}
			</div>
			<p class="afternoon-note">{passes.afternoon.note}</p>
		</article>

		<!-- Duo cards: Quinta (Dia do Boardgame) & Sábado (Passe de Sábado) -->
		<div class="pricing-duo">
			<article class="pricing-card pass-card yellow">
				<span class="card-tag">{passes.thursday.schedule}</span>
				<h3 class="pass-title">{passes.thursday.title}</h3>
				<div class="pass-price-wrap">
					<span class="pass-price">{passes.thursday.price}</span>
					<span class="pass-note">{passes.thursday.note}</span>
				</div>
			</article>

			<article class="pricing-card pass-card pink">
				<span class="card-tag">{passes.saturday.schedule}</span>
				<h3 class="pass-title">{passes.saturday.title}</h3>
				<div class="pass-price-wrap">
					<span class="pass-price">{passes.saturday.price}</span>
					<span class="pass-note">{passes.saturday.note}</span>
				</div>
			</article>
		</div>

		<!-- Card Pegue e Jogue -->
		<article class="pricing-card hourly-card cyan">
			<div class="hourly-header">
				<span class="card-tag">{passes.hourly.schedule}</span>
			</div>
			<div class="hourly-body">
				<div class="hourly-title-group">
					<h3 class="hourly-title">{passes.hourly.title}</h3>
					<span class="hourly-note">{passes.hourly.note}</span>
				</div>
				<div class="hourly-price-group">
					<span class="hourly-price">{passes.hourly.price}</span>
					<span class="hourly-breakdown">R$ / hora (leves · médios · grandes)</span>
				</div>
			</div>
		</article>
	</div>

	<!-- Games Catalog Showcase -->
	<div class="catalog-section" id="acervo" aria-labelledby="catalog-title">
		<div class="catalog-header">
			<div class="catalog-title-block">
				<p class="eyebrow yellow-text">ACERVO DA LOJA</p>
				<h3 id="catalog-title" class="catalog-title">ESTANTE DE <span>JOGOS</span></h3>
			</div>

			<!-- Filter toolbar -->
			<div class="filter-toolbar" role="toolbar" aria-label="Filtrar jogos por categoria">
				<button type="button" class="filter-btn all active" data-filter="all" aria-pressed="true">
					Todos <span class="badge-count">({counts.all})</span>
				</button>
				<button type="button" class="filter-btn leves" data-filter="leves" aria-pressed="false">
					Leves <span class="badge-count">({counts.leves})</span>
				</button>
				<button type="button" class="filter-btn medios" data-filter="medios" aria-pressed="false">
					Médios <span class="badge-count">({counts.medios})</span>
				</button>
				<button type="button" class="filter-btn grandes" data-filter="grandes" aria-pressed="false">
					Grandes <span class="badge-count">({counts.grandes})</span>
				</button>
			</div>
		</div>

		<!-- Screen reader feedback on filter change -->
		<p id="filter-status" class="sr-only" aria-live="polite">Mostrando jogos disponíveis.</p>

		<!-- Games Grid -->
		<div class="games-grid" id="games-grid">
			{games.map((game) => (
				<article
					class={`game-card category-${game.category}`}
					data-category={game.category}
					tabindex="0"
					aria-label={`${game.name}, categoria ${game.categoryName}`}
				>
					<div class="game-cover-wrap">
						{dynamicImageMap[game.image] ? (
							<Image
								src={dynamicImageMap[game.image]}
								alt={`Capa da caixa do jogo ${game.name}`}
								width={280}
								height={280}
								class="game-cover"
								loading="lazy"
								decoding="async"
							/>
						) : (
							<img
								src={game.image.startsWith('/') || game.image.startsWith('http') ? game.image : `/uploads/${game.image}`}
								alt={`Capa da caixa do jogo ${game.name}`}
								width="280"
								height="280"
								class="game-cover"
								loading="lazy"
								decoding="async"
							/>
						)}
						<span class={`game-badge ${game.category}`}>
							{game.categoryName}
						</span>
					</div>

					<div class="game-details">
						<span class="game-publisher">{game.publisher}</span>
						<h4 class="game-name">{game.name}</h4>
						<p class="game-meta">
							<span>{game.players}</span>
							<span class="meta-dot" aria-hidden="true">·</span>
							<span class={`game-tag-text ${game.category}`}>{game.tag}</span>
						</p>
					</div>
				</article>
			))}
		</div>

		<!-- Expand / Collapse button for long lists -->
		<div class="expand-actions" id="expand-actions">
			<button
				type="button"
				class="button button-yellow expand-btn"
				id="expand-games-btn"
				aria-expanded="false"
				aria-controls="games-grid"
			>
				<span id="expand-btn-text">Ver todos os {counts.all} jogos</span>
				<svg
					id="expand-arrow-icon"
					class="arrow-icon expand-arrow"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="3.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M12 5v14"></path>
					<path d="m19 12-7 7-7-7"></path>
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	const INITIAL_ROWS = 2;
	let isExpanded = false;
	let currentFilter = 'all';

	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const gameCards = Array.from(document.querySelectorAll<HTMLElement>('.game-card'));
	const filterStatus = document.getElementById('filter-status');
	const expandActions = document.getElementById('expand-actions');
	const expandBtn = document.getElementById('expand-games-btn');
	const expandBtnText = document.getElementById('expand-btn-text');
	const expandArrowIcon = document.getElementById('expand-arrow-icon');
	const catalogSection = document.getElementById('acervo');

	function getInitialLimit(): number {
		if (window.matchMedia('(max-width: 800px)').matches) {
			return INITIAL_ROWS * 1; // 1 coluna no mobile -> 2 linhas = 2 jogos
		}
		if (window.matchMedia('(max-width: 960px)').matches) {
			return INITIAL_ROWS * 2; // 2 colunas no tablet -> 2 linhas = 4 jogos
		}
		return INITIAL_ROWS * 3; // 3 colunas no desktop -> 2 linhas = 6 jogos
	}

	function updateDisplay(announceText?: string, triggerAnimation = true) {
		const initialLimit = getInitialLimit();
		const matching = gameCards.filter((card) => {
			const cat = card.dataset.category;
			return currentFilter === 'all' || cat === currentFilter;
		});

		const needsExpand = matching.length > initialLimit;

		if (expandActions && expandBtn && expandBtnText && expandArrowIcon) {
			if (needsExpand) {
				expandActions.hidden = false;
				expandBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');

				if (isExpanded) {
					expandBtnText.textContent = 'Ver menos jogos';
					expandArrowIcon.innerHTML = '<path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path>';
				} else {
					expandBtnText.textContent = `Ver todos os ${matching.length} jogos`;
					expandArrowIcon.innerHTML = '<path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path>';
				}
			} else {
				expandActions.hidden = true;
			}
		}

		let visibleCount = 0;
		gameCards.forEach((card) => {
			const cat = card.dataset.category;
			const isMatch = currentFilter === 'all' || cat === currentFilter;

			if (!isMatch) {
				card.classList.add('hidden');
				card.classList.remove('animate-reveal');
			} else {
				const matchIndex = matching.indexOf(card);
				const isVisible = isExpanded || !needsExpand || matchIndex < initialLimit;
				const wasHidden = card.classList.contains('hidden');

				card.classList.toggle('hidden', !isVisible);

				if (isVisible) {
					card.style.setProperty('--stagger-index', visibleCount.toString());
					if (triggerAnimation && (wasHidden || matchIndex >= initialLimit || triggerAnimation)) {
						card.classList.remove('animate-reveal');
						void card.offsetWidth;
						card.classList.add('animate-reveal');
					}
					visibleCount++;
				} else {
					card.classList.remove('animate-reveal');
				}
			}
		});

		if (filterStatus) {
			if (announceText) {
				filterStatus.textContent = announceText;
			} else {
				const activeBtn = document.querySelector<HTMLButtonElement>('.filter-btn.active');
				const filterLabel = activeBtn?.textContent?.trim().replace(/\s+/g, ' ') || 'Todos';
				filterStatus.textContent = `Mostrando ${visibleCount} de ${matching.length} jogos para o filtro ${filterLabel}.`;
			}
		}
	}

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			currentFilter = btn.dataset.filter || 'all';

			filterButtons.forEach((b) => {
				const isCurrent = b === btn;
				b.classList.toggle('active', isCurrent);
				b.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
			});

			updateDisplay();
		});
	});

	if (expandBtn) {
		expandBtn.addEventListener('click', () => {
			isExpanded = !isExpanded;
			const initialLimit = getInitialLimit();
			const msg = isExpanded
				? 'Lista expandida: todos os jogos estão visíveis.'
				: `Lista recolhida: mostrando os primeiros ${initialLimit} jogos.`;

			updateDisplay(msg);

			if (!isExpanded && catalogSection) {
				catalogSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
	}

	let lastLimit = getInitialLimit();
	window.addEventListener('resize', () => {
		const nextLimit = getInitialLimit();
		if (nextLimit !== lastLimit) {
			lastLimit = nextLimit;
			updateDisplay(undefined, false);
		}
	});

	// Initialize on page load
	updateDisplay(undefined, false);
</script>

<style>
	/* No mobile vale o espaçamento padrão de `.section`. */
	@media (width > 800px) {
		.games-section {
			padding-top: 75px;
		}
	}

	.games-section {
		display: flex;
		flex-direction: column;
	}

	/* Pricing Board layout */
	.pricing-board {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-bottom: 85px;
	}

	.pricing-card {
		position: relative;
		border-radius: 24px;
		padding: 30px 34px;
		box-shadow: 7px 7px 0 var(--ink-2);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.pricing-card:hover {
		transform: translateY(-4px);
	}

	/* Afternoon Pass (Dark styled card matching the official reference image) */
	.afternoon-card {
		background: var(--ink-2);
		border: 2px solid var(--ink-3);
		color: var(--white);
	}

	.card-schedule-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px 14px;
		margin-bottom: 10px;
	}

	.schedule-days {
		color: var(--cyan);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.schedule-hours {
		color: var(--yellow);
		font-family: 'Archivo Black', sans-serif;
		font-size: 20px;
		letter-spacing: -0.5px;
		text-transform: uppercase;
	}

	.afternoon-title {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(1.35rem, 1rem + 1.5vw, 2.125rem);
		letter-spacing: -1px;
		line-height: 1.05;
		margin: 0 0 18px 0;
		padding-bottom: 20px;
		border-bottom: 2px solid var(--ink-3);
		color: var(--white);
		text-transform: uppercase;
	}

	.tiers-list {
		display: flex;
		flex-direction: column;
	}

	.tier-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 18px 4px;
		border-bottom: 2px solid var(--ink-3);
	}

	.tier-info {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.tier-name {
		font-family: 'Archivo Black', sans-serif;
		font-size: 22px;
		letter-spacing: -0.5px;
		line-height: 1;
		text-transform: uppercase;
	}

	.tier-row.cyan .tier-name {
		color: var(--cyan);
	}
	.tier-row.yellow .tier-name {
		color: var(--yellow);
	}
	.tier-row.pink .tier-name {
		color: var(--pink);
	}

	.tier-desc {
		font-size: 13px;
		color: var(--mist);
		font-weight: 600;
	}

	.tier-price {
		font-family: 'Archivo Black', sans-serif;
		font-size: 36px;
		letter-spacing: -1.5px;
		line-height: 1;
		color: var(--white);
	}

	.afternoon-note {
		margin: 14px 4px 0 0;
		text-align: right;
		font-size: 13px;
		font-weight: 700;
		color: var(--mist);
	}

	/* Pricing Duo (Yellow & Pink Cards) */
	.pricing-duo {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.pass-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 220px;
		color: var(--ink);
		box-shadow: 7px 7px 0 var(--ink-2);
	}

	.pass-card.yellow {
		background: var(--yellow);
	}

	.pass-card.pink {
		background: var(--pink);
	}

	.card-tag {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.pass-title {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(1.65rem, 1.2rem + 1.2vw, 2.15rem);
		letter-spacing: -1.5px;
		line-height: 0.96;
		margin: 14px 0 18px;
		max-width: 14ch;
		text-transform: uppercase;
	}

	.pass-price-wrap {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.pass-price {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(2.5rem, 2rem + 1.8vw, 3.35rem);
		line-height: 0.92;
		letter-spacing: -2px;
	}

	.pass-note {
		font-size: 13px;
		font-weight: 700;
	}

	/* Hourly Pegue e Jogue Card */
	.hourly-card.cyan {
		background: var(--cyan);
		color: var(--ink);
		box-shadow: 7px 7px 0 var(--ink-2);
	}

	.hourly-body {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-top: 10px;
		gap: 20px;
	}

	.hourly-title-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.hourly-title {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(1.65rem, 1.2rem + 1.2vw, 2.15rem);
		margin: 0;
		letter-spacing: -1.5px;
		line-height: 1;
		text-transform: uppercase;
	}

	.hourly-note {
		font-size: 14px;
		font-weight: 700;
	}

	.hourly-price-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
	}

	.hourly-price {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
		line-height: 1;
		letter-spacing: -1.5px;
	}

	.hourly-breakdown {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	/* Games Catalog Section */
	.catalog-section {
		display: flex;
		flex-direction: column;
		gap: 34px;
	}

	.catalog-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 24px;
	}

	.catalog-title-block .eyebrow {
		margin-bottom: 10px;
	}

	.catalog-title {
		font-family: 'Archivo Black', sans-serif;
		font-size: clamp(2rem, 1.2rem + 2.5vw, 3rem);
		letter-spacing: -2px;
		line-height: 0.94;
		margin: 0;
		color: var(--white);
		text-transform: uppercase;
	}

	.catalog-title span {
		color: var(--pink);
	}

	/* Filter Buttons */
	.filter-toolbar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.filter-btn {
		background: var(--ink-2);
		border: 2px solid var(--ink-3);
		color: var(--mist);
		padding: 10px 18px;
		border-radius: 999px;
		font-family: 'Poppins', sans-serif;
		font-size: 12px;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
	}

	.filter-btn:hover {
		color: var(--white);
		border-color: var(--mist);
	}

	.filter-btn.all.active {
		background: var(--white);
		border-color: var(--white);
		color: var(--ink);
	}

	.filter-btn.leves.active {
		background: var(--cyan);
		border-color: var(--cyan);
		color: var(--ink);
	}

	.filter-btn.medios.active {
		background: var(--yellow);
		border-color: var(--yellow);
		color: var(--ink);
	}

	.filter-btn.grandes.active {
		background: var(--pink);
		border-color: var(--pink);
		color: var(--ink);
	}

	.badge-count {
		font-size: 11px;
		font-weight: 600;
		opacity: 0.75;
	}

	/* Games Grid */
	.games-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	@keyframes cardReveal {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
