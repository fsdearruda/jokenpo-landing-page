---
import siteData from '../data/site.json';
import ArrowIcon from './ArrowIcon.astro';

const about = (siteData as Record<string, any>).about ?? {
	eyebrow: 'CARD GAMES',
	titleLine1: 'TCG, MESA',
	highlight: 'E COMUNIDADE',
	description:
		'Temos produtos e cartas de Magic, Pokémon, Yu-Gi-Oh! e One Piece, além de espaço para sentar, jogar com calma e encontrar a sua turma.',
	tcgs: ['MAGIC', 'POKÉMON', 'YU-GI-OH!', 'ONE PIECE'],
	noteLine1: 'UM LUGAR PRA',
	noteHighlight: 'JOGAR COM CALMA.',
	noteAuthor: '@jokenpoficial',
};
---

<section class="about-section" id="sobre" aria-labelledby="about-title">
	<div class="about-copy">
		<p class="eyebrow">{about.eyebrow}</p>
		<h2 id="about-title">{about.titleLine1}<br /><span>{about.highlight}</span></h2>
		<p>{about.description}</p>
		<div class="tcg-list">
			{about.tcgs.map((tcg: string) => <span>{tcg}</span>)}
		</div>
		<a class="button button-pink" href="#agenda">Ver torneios <ArrowIcon direction="right" size={16} /></a>
	</div>
	<div class="about-note">
		<span class="quote-mark">“</span>
		<p>{about.noteLine1}<br /><strong>{about.noteHighlight}</strong></p>
		<span class="quote-author">{about.noteAuthor}</span>
	</div>
</section>

<style>
	.about-section { position: relative; display: flex; min-height: 610px; align-items: center; justify-content: space-between; overflow: hidden; padding: 100px max(42px, calc((100% - 1176px) / 2)); background: var(--pink); color: var(--ink); }
	.about-copy { position: relative; z-index: 1; max-width: 640px; }
	.about-copy .eyebrow { color: var(--ink); }
	.about-copy h2 {
		margin-bottom: 27px;
		font-size: clamp(2rem, 0.5rem + 5vw, 4.25rem);
	}
	.about-copy h2 span {
		color: var(--white);
		white-space: nowrap;
	}
	.about-copy > p:not(.eyebrow) { max-width: 420px; margin-bottom: 30px; font-size: 15px; font-weight: 600; line-height: 1.7; }
	.tcg-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-bottom: 28px; }
	.tcg-list span { display: flex; min-height: 36px; align-items: center; justify-content: center; padding: 8px 6px; border: 2px solid var(--ink); border-radius: 20px; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-align: center; }
	.about-note { position: relative; z-index: 1; width: 290px; padding: 25px; border: 3px solid var(--ink); background: var(--white); box-shadow: 10px 10px 0 var(--ink); transform: rotate(-7deg); }
	.quote-mark { color: var(--cyan); font-family: Georgia, serif; font-size: 67px; line-height: .5; }
	.about-note p { margin: 22px 0 34px; font-family: 'Archivo Black', sans-serif; font-size: 21px; line-height: .95; }
	.about-note p strong { color: var(--pink); }
	.quote-author { font-size: 11px; font-weight: 700; }

	@media (max-width: 800px) {
		.about-copy h2 span { white-space: normal; }
		.tcg-list { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 360px; }
		.about-section { display: block; min-height: 690px; padding: 88px 24px; }
		.about-note { width: min(100%, 290px); margin: 56px auto 0; }
	}
</style>
