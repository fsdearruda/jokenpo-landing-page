---
interface Props {
	direction?: 'right' | 'up-right';
	class?: string;
}

const { direction = 'up-right', class: className = '' } = Astro.props;
---

<svg
	class={`arrow-icon ${className}`}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{direction === 'right' ? (
		<>
			<path d="M5 12h14" />
			<path d="m13 6 6 6-6 6" />
		</>
	) : (
		<>
			<path d="M5 19 19 5" />
			<path d="M9 5h10v10" />
		</>
	)}
</svg>
