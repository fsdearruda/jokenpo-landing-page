---
import Icon from './Icon.astro';

interface Props {
	direction?: 'right' | 'up-right' | 'down' | 'up';
	class?: string;
	size?: number;
}

const { direction = 'up-right', class: className = '', size = 12 } = Astro.props;

const names = {
	right: 'lucide:arrow-right',
	'up-right': 'lucide:arrow-up-right',
	down: 'lucide:arrow-down',
	up: 'lucide:arrow-up',
} as const;
---

<Icon
	name={names[direction]}
	class:list={['arrow-icon', className]}
	size={size}
	style={`width: ${size}px; height: ${size}px;`}
/>
