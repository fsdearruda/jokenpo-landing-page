---
interface Props {
	direction?: 'right' | 'up-right' | 'down';
	class?: string;
	size?: number;
}

const { direction = 'up-right', class: className = '', size = 12 } = Astro.props;
---

<svg
	class={`arrow-icon ${className}`}
	width={size}
	height={size}
	style={`width: ${size}px; height: ${size}px;`}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="3.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{direction === 'right' ? (
		<>
			<path d="M5 12h14" />
			<path d="m13 6 6 6-6 6" />
		</>
	) : direction === 'down' ? (
		<>
			<path d="M12 5v14" />
			<path d="m6 13 6 6 6-6" />
		</>
	) : (
		<>
			<path d="M5 19 19 5" />
			<path d="M9 5h10v10" />
		</>
	)}
</svg>

<style>
	.arrow-icon { display: inline-block; width: .6em; height: .6em; flex: none; vertical-align: middle; }
</style>
