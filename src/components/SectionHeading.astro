---
interface Props {
	/** Texto curto acima do título. */
	eyebrow: string;
	/** Cor do eyebrow. */
	eyebrowColor?: 'pink' | 'cyan' | 'yellow';
	/** ID do `<h2>`, usado em `aria-labelledby` da seção. */
	titleId: string;
	/** Primeira linha do título. */
	title: string;
	/** Segunda linha do título, exibida em destaque. */
	highlight: string;
}

const { eyebrow, eyebrowColor, titleId, title, highlight } = Astro.props;
---

<div class="section-heading">
	<div class="heading-main">
		<p class:list={['eyebrow', eyebrowColor && `${eyebrowColor}-text`]}>{eyebrow}</p>
		<h2 id={titleId}>{title}<br /><span>{highlight}</span></h2>
	</div>
	{Astro.slots.has('default') && <p class="heading-aside"><slot /></p>}
</div>

<style>
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 2.5rem;
		margin-bottom: clamp(2.25rem, 4.5vw, 3.25rem);
	}

	.heading-main .eyebrow {
		margin-bottom: 0.875rem;
	}

	.heading-aside {
		max-inline-size: 40ch;
		margin: 0 0 0.25rem;
		color: var(--mist);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.6;
		text-align: right;
		text-wrap: pretty;
	}

	@media (max-width: 800px) {
		.section-heading {
			flex-direction: column;
			align-items: flex-start;
		}

		.heading-aside {
			margin-top: 0.25rem;
			text-align: left;
		}
	}
</style>
