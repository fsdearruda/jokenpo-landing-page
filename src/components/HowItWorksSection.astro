---
import siteData from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const { howItWorks } = siteData;
---

<section class="section how-it-works-section" id="como-funciona" tabindex="-1" aria-labelledby="how-it-works-title">
	<SectionHeading
		eyebrow={howItWorks.eyebrow}
		eyebrowColor="cyan"
		titleId="how-it-works-title"
		title={howItWorks.title}
		highlight={howItWorks.highlight}
	>
		{howItWorks.lead}
	</SectionHeading>

	<div class="steps-grid">
		{howItWorks.steps.map((step) => (
			<article class={`step-card step-${step.color}`}>
				<span class="step-num">{step.number}</span>
				<h3 class="step-title">{step.title}</h3>
				<p class="step-desc">{step.description}</p>
			</article>
		))}
	</div>
</section>

<style>
	/* No mobile vale o espaçamento padrão de `.section`. */
	@media (width > 800px) {
		.how-it-works-section {
			padding-top: 90px;
			padding-bottom: 50px;
		}
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.step-card {
		display: flex;
		flex-direction: column;
		min-height: 220px;
		padding: 26px;
		border-radius: 22px;
		color: var(--ink);
		box-shadow: 7px 7px 0 var(--ink-2);
		transition: transform 0.2s ease;
	}

	.step-card:hover {
		transform: translateY(-4px);
	}

	.step-card.step-cyan {
		background: var(--cyan);
	}

	.step-card.step-yellow {
		background: var(--yellow);
	}

	.step-card.step-pink {
		background: var(--pink);
	}

	.step-num {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.step-title {
		margin: 34px 0 10px;
		font-family: 'Archivo Black', sans-serif;
		font-size: 24px;
		line-height: 1;
		letter-spacing: -1px;
	}

	.step-desc {
		margin: 0;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.55;
	}

	@media (max-width: 800px) {
		.steps-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
