---
import siteData from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const { howItWorks } = siteData;
---

<section class="section how-it-works-section" id="como-funciona" tabindex="-1" aria-labelledby="how-it-works-title">
	<SectionHeading
		eyebrow={howItWorks.eyebrow}
		eyebrowColor="cyan"
		titleId="how-it-works-title"
		title={howItWorks.title}
		highlight={howItWorks.highlight}
	>
		{howItWorks.lead}
	</SectionHeading>

	<ol class="steps-grid">
		{howItWorks.steps.map((step) => (
			<li class={`step-card step-${step.color}`}>
				<div class="step-header">
					<span class="step-badge">PASSO {step.number}</span>
					<span class="step-watermark" aria-hidden="true">{step.number}</span>
				</div>
				<h3 class="step-title">{step.title}</h3>
				<p class="step-desc">{step.description}</p>
			</li>
		))}
	</ol>
</section>

<style>
	@media (width > 800px) {
		.how-it-works-section {
			padding-top: 5.5rem;
			padding-bottom: 3.5rem;
		}
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.step-card {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		min-height: 230px;
		padding: 1.75rem;
		border: 2px solid var(--ink);
		border-radius: var(--radius-card);
		color: var(--ink);
		box-shadow: var(--shadow-hard-surface);
		transition:
			transform var(--duration-normal) var(--ease-out),
			box-shadow var(--duration-normal) var(--ease-out);
	}

	@media (width > 800px) {
		.step-card:nth-child(1) {
			transform: rotate(-1.2deg);
		}
		.step-card:nth-child(2) {
			transform: translateY(8px) rotate(0.8deg);
		}
		.step-card:nth-child(3) {
			transform: rotate(-0.8deg);
		}
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.step-card:hover {
			transform: translateY(-4px) rotate(0deg);
			box-shadow: 9px 9px 0 var(--ink-3);
		}
	}

	.step-card.step-cyan {
		background: var(--cyan);
	}

	.step-card.step-yellow {
		background: var(--yellow);
	}

	.step-card.step-pink {
		background: var(--pink);
	}

	.step-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.75rem;
	}

	.step-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.3125rem 0.75rem;
		border-radius: var(--radius-pill);
		background: var(--ink);
		color: var(--white);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		font-variant-numeric: tabular-nums;
	}

	.step-watermark {
		position: absolute;
		top: -0.5rem;
		right: 0.75rem;
		font-family: var(--font-display);
		font-size: 4.5rem;
		line-height: 1;
		letter-spacing: -0.04em;
		color: var(--ink);
		opacity: 0.12;
		pointer-events: none;
		user-select: none;
		font-variant-numeric: tabular-nums;
	}

	.step-title {
		margin: auto 0 0.625rem;
		font-family: var(--font-display);
		font-size: clamp(1.375rem, 1.15rem + 0.5vw, 1.5625rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.step-desc {
		margin: 0;
		color: var(--ink-on-color);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.55;
	}

	@media (max-width: 800px) {
		.steps-grid {
			grid-template-columns: 1fr;
			gap: 1.125rem;
		}

		.step-card {
			min-height: auto;
		}
	}
</style>
