{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"regions": ["gru1"],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "SAMEORIGIN"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=()"
				}
			]
		},
		{
			"source": "/",
			"headers": [
				{
					"key": "Link",
					"value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
				}
			]
		},
		{
			"source": "/(admin|oauth|api)(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		},
		{
			"source": "/Vetor/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	],
	"schedules": {
		"saude-pdv": {
			"schedule": "30 14-21 * * 1-6",
			"timezone": "America/Fortaleza",
			"path": "/api/pdv-sync/saude",
			"requestMethod": "GET"
		},
		"manutencao-pdv": {
			"schedule": "0 4 * * *",
			"timezone": "America/Fortaleza",
			"path": "/api/pdv-sync/manutencao",
			"requestMethod": "GET"
		}
	}
}
